#!/usr/bin/perl -T
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Package-owned equivalent of /usr/bin/pveproxy with one early, literal-path
# API extension import. It is selected with a systemd drop-in, never by
# replacing a file owned by pve-manager. Before importing any extension, it
# compares the installed PVE ABI with the reviewed allow-list and execs the
# untouched vendor launcher on every mismatch.

$ENV{'PATH'} = '/sbin:/bin:/usr/sbin:/usr/bin';
delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};

use strict;
use warnings;

use lib '/usr/lib/qsm-pve-direct/pve9-api';

sub _exec_stock_pveproxy {
    my ($reason) = @_;
    $reason = 'unsupported PVE environment' if !defined($reason) ||
        $reason !~ /\A[A-Za-z0-9 ._-]{1,128}\z/;
    my @arguments;
    for my $argument (@ARGV) {
        my ($operation) = $argument =~ /\A(start|stop|restart|status)\z/;
        die "qsm-pve-direct PVE API launcher refused unsafe stock arguments\n"
            if !defined($operation);
        push @arguments, $operation;
    }
    die "qsm-pve-direct PVE API launcher refused unsafe stock arguments\n"
        if @arguments != 1;
    print STDERR "qsm-pve-direct PVE API disabled: $reason; executing stock pveproxy\n";
    exec { '/usr/bin/pveproxy' } '/usr/bin/pveproxy', @arguments;
    die "qsm-pve-direct PVE API stock fallback failed: $!\n";
}

my $compatibility_loaded = eval { require PVE::QsmDirect::Compatibility; 1; };
_exec_stock_pveproxy('compatibility module unavailable') if !$compatibility_loaded;
my ($supported, $reason) = (0, 'compatibility check failed');
my $compatibility_checked = eval {
    ($supported, $reason) = PVE::QsmDirect::Compatibility->supported('pveproxy');
    1;
};
if (!$compatibility_checked || !$supported) {
    # exec_stock normally never returns. If a future compatibility helper has
    # an unexpected failure, this local literal-path fallback still preserves
    # PVE availability instead of making its daemon depend on qsm-pve-direct.
    eval { PVE::QsmDirect::Compatibility->exec_stock('pveproxy', $reason, @ARGV); 1; };
    _exec_stock_pveproxy('compatibility stock fallback failed');
}

my $pve_loaded = eval {
    require PVE::API2::QsmDirect;
    require PVE::SafeSyslog;
    PVE::SafeSyslog->import();
    require PVE::Service::pveproxy;
    1;
};
_exec_stock_pveproxy('PVE extension could not be loaded') if !$pve_loaded;

$SIG{'__WARN__'} = sub {
    my $err = $@;
    my $text = $_[0];
    chomp $text;
    print STDERR "$text\n";
    syslog('warning', '%s', $text);
    $@ = $err;
};

my $prepare = sub {
    my $rundir = '/var/run/pveproxy';
    if (mkdir($rundir, 0700)) {
        my $gid = getgrnam('www-data') || die "getgrnam failed - $!\n";
        my $uid = getpwnam('www-data') || die "getpwnam failed - $!\n";
        chown($uid, $gid, $rundir);
    }
};

PVE::Service::pveproxy->run_cli_handler(prepare => $prepare);
