#!/usr/bin/perl -T
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Package-owned equivalent of /usr/bin/pvedaemon. Protected API2 methods are
# forwarded by pveproxy to pvedaemon, so both services must load the identical
# route registry. An unreviewed PVE environment executes the untouched vendor
# launcher before the custom route is imported.

$ENV{'PATH'} = '/sbin:/bin:/usr/sbin:/usr/bin';
delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};

use strict;
use warnings;

use lib '/usr/lib/qsm-pve-direct/pve9-api';

sub _exec_stock_pvedaemon {
    my ($reason) = @_;
    $reason = 'unsupported PVE environment' if !defined($reason) ||
        $reason !~ /\A[A-Za-z0-9 ._-]{1,128}\z/;
    my @arguments;
    for my $argument (@ARGV) {
        my ($operation) = $argument =~ /\A(start|stop|restart|status)\z/;
        die "qsm-pve-direct PVE API launcher refused unsafe stock arguments\n"
            if !defined($operation);
        push @arguments, $operation;
    }
    die "qsm-pve-direct PVE API launcher refused unsafe stock arguments\n"
        if @arguments != 1;
    print STDERR "qsm-pve-direct PVE API disabled: $reason; executing stock pvedaemon\n";
    exec { '/usr/bin/pvedaemon' } '/usr/bin/pvedaemon', @arguments;
    die "qsm-pve-direct PVE API stock fallback failed: $!\n";
}

my $compatibility_loaded = eval { require PVE::QsmDirect::Compatibility; 1; };
_exec_stock_pvedaemon('compatibility module unavailable') if !$compatibility_loaded;
my ($supported, $reason) = (0, 'compatibility check failed');
my $compatibility_checked = eval {
    ($supported, $reason) = PVE::QsmDirect::Compatibility->supported('pvedaemon');
    1;
};
if (!$compatibility_checked || !$supported) {
    # exec_stock normally never returns. If a future compatibility helper has
    # an unexpected failure, this local literal-path fallback still preserves
    # PVE availability instead of making its daemon depend on qsm-pve-direct.
    eval { PVE::QsmDirect::Compatibility->exec_stock('pvedaemon', $reason, @ARGV); 1; };
    _exec_stock_pvedaemon('compatibility stock fallback failed');
}

my $pve_loaded = eval {
    # PVE::API2 builds its child routing table while the service module is
    # compiled. Register the extension first: otherwise pveproxy recognizes
    # this protected route and forwards it, but pvedaemon's already-built
    # registry replies with HTTP 501 ("Method not implemented").
    require PVE::API2::QsmDirect;
    require PVE::SafeSyslog;
    PVE::SafeSyslog->import();
    require PVE::Service::pvedaemon;
    1;
};
_exec_stock_pvedaemon('PVE extension could not be loaded') if !$pve_loaded;

$SIG{'__WARN__'} = sub {
    my $err = $@;
    my $text = $_[0];
    chomp $text;
    print STDERR "$text\n";
    syslog('warning', '%s', $text);
    $@ = $err;
};

my $prepare = sub {
    mkdir '/var/run/dtach';
};

PVE::Service::pvedaemon->run_cli_handler(prepare => $prepare);
