@@ -133,6 +133,16 @@ AVFrame *kqs_dmabuf_to_vaapi(KqsHwCtx *h, const KqsDmabuf *d,
  * encoder's public src_frames FIFO. Built lazily on the first frame, because
  * geometry and pixel format are only known once QEMU has sent a Scanout.
  */
+/*
+ * DMA-BUF readback through EGL, for GPUs whose VAAPI cannot import or encode
+ * an RGB scanout (NVIDIA). Fills a CPU surface for the software path.
+ */
+typedef struct KqsEgl KqsEgl;
+KqsEgl *kqs_egl_new(const char *render_node, GError **error);
+void kqs_egl_free(KqsEgl *e);
+bool kqs_egl_read(KqsEgl *e, const KqsDmabuf *d, KqsSurface *out,
+                  GError **error);
+
 typedef struct KqsSink KqsSink;
 
 typedef struct KqsSinkConfig {
@@ -155,6 +165,7 @@ typedef struct KqsSinkConfig {
      */
     int out_w, out_h;
     KqsHwCtx *hw;            /* non-NULL selects the zero-copy path */
+    KqsEgl *egl;             /* non-NULL: read dmabufs back, software path */
 } KqsSinkConfig;
 
 KqsSink *kqs_sink_new(const KqsSinkConfig *cfg);
