From 39e6a8053271db7bb97d72a50fe76af76ac88911 Mon Sep 17 00:00:00 2001
From: Dmitry R <rdmitry0911@gmail.com>
Date: Sun, 18 Oct 2026 08:58:49 +0300
Subject: [PATCH] Expose WebRTC bitrate policy on pve-container 6.1.14

Signed-off-by: Dmitry R <rdmitry0911@gmail.com>
---
 debian/changelog                |  6 ++++++
 src/PVE/API2/LXC.pm             | 13 +++++++++++++
 src/test/Makefile               |  1 +
 src/test/webrtc-bitrate-test.pl | 22 ++++++++++++++++++++++
 4 files changed, 42 insertions(+)
 create mode 100644 src/test/webrtc-bitrate-test.pl

diff --git a/debian/changelog b/debian/changelog
index 7b59078..07017ef 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+pve-container (6.1.14+webrtc2) trixie; urgency=medium
+
+  * Expose the WebRTC bitrate ceiling without downgrading the 6.1.14 base.
+
+ -- Dmitry R <rdmitry0911@gmail.com>  Sun, 18 Oct 2026 09:00:00 +0300
+
 pve-container (6.1.14+webrtc1) trixie; urgency=medium
 
   * Add authorized WebRTC console endpoints using the common local service.
diff --git a/src/PVE/API2/LXC.pm b/src/PVE/API2/LXC.pm
index 097d7e6..b90509f 100644
--- a/src/PVE/API2/LXC.pm
+++ b/src/PVE/API2/LXC.pm
@@ -1062,6 +1062,10 @@ __PACKAGE__->register_method({
         properties => {
             codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
             encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+            bitrate => {
+                type => 'integer', minimum => 500, maximum => 100000, optional => 1,
+                description => 'Maximum video bitrate in kbit/s. Omit to preserve the current setting.',
+            },
         },
     },
     code => sub {
@@ -1089,6 +1093,10 @@ __PACKAGE__->register_method({
             vmid => get_standard_option('pve-vmid'),
             codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
             encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+            bitrate => {
+                type => 'integer', minimum => 500, maximum => 100000, optional => 1,
+                description => 'Maximum video bitrate in kbit/s. Omit to preserve the current setting.',
+            },
         },
     },
     returns => {
@@ -1096,6 +1104,10 @@ __PACKAGE__->register_method({
         properties => {
             codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
             encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+            bitrate => {
+                type => 'integer', minimum => 500, maximum => 100000, optional => 1,
+                description => 'Maximum video bitrate in kbit/s. Omit to preserve the current setting.',
+            },
         },
     },
     code => sub {
@@ -1104,6 +1116,7 @@ __PACKAGE__->register_method({
         my $conf = PVE::LXC::Config->load_config($vmid, $param->{node});
         my $user = PVE::RPCEnvironment::get()->get_user();
         my $settings = { codec => $param->{codec}, encoder => $param->{encoder} };
+        $settings->{bitrate} = int($param->{bitrate}) if defined($param->{bitrate});
         return PVE::WebRTC::settings('lxc', $vmid, $user, $settings);
     },
 });
diff --git a/src/test/Makefile b/src/test/Makefile
index 4e45a5d..b1b5c65 100644
--- a/src/test/Makefile
+++ b/src/test/Makefile
@@ -29,3 +29,4 @@ clean:
 
 test_webrtc:
 	perl ./webrtc_test.pl
+	perl ./webrtc-bitrate-test.pl
diff --git a/src/test/webrtc-bitrate-test.pl b/src/test/webrtc-bitrate-test.pl
new file mode 100644
index 0000000..5fcf17f
--- /dev/null
+++ b/src/test/webrtc-bitrate-test.pl
@@ -0,0 +1,22 @@
+use strict;
+use warnings;
+use lib '..';
+use Test::More;
+use PVE::JSONSchema;
+use PVE::API2::LXC;
+for my $class ('PVE::API2::LXC') {
+    my $method=$class->map_method_by_name('webrtcsettings-put');
+    is_deeply($method->{permissions}->{check}, ['perm', '/vms/{vmid}', ['VM.Config.Options']], "$class keeps write ACL");
+    my $params={node=>'lab',vmid=>108,codec=>'h264',encoder=>'auto'};
+    eval { PVE::JSONSchema::validate($params,$method->{parameters}); };
+    is($@, '', "$class accepts old clients without bitrate");
+    for my $value (500, 8000, 20000, 100000) {
+        eval { PVE::JSONSchema::validate({%$params,bitrate=>$value},$method->{parameters}); };
+        is($@, '', "$class accepts bitrate $value");
+    }
+    for my $value (0, 499, 100001, 1.5, 'unlimited') {
+        eval { PVE::JSONSchema::validate({%$params,bitrate=>$value},$method->{parameters}); };
+        ok($@, "$class rejects bitrate $value");
+    }
+}
+done_testing();
-- 
