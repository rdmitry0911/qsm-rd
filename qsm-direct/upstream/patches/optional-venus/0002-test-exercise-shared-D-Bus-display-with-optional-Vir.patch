From a94f0378755f5d2a18baf8828e03f286a1a0bc9b Mon Sep 17 00:00:00 2001
From: Dmitry R <rdmitry0911@gmail.com>
Date: Wed, 14 Oct 2026 19:24:45 +0300
Subject: [PATCH 2/2] test: exercise shared D-Bus display with optional VirGL
 blobs

Signed-off-by: Dmitry R <rdmitry0911@gmail.com>
---
 .../cfg2cmd/virgl-feature-without-gl.conf     |  2 ++
 src/test/cfg2cmd/virtio-gl-shared-blob.conf   |  6 ++++
 .../cfg2cmd/virtio-gl-shared-blob.conf.cmd    | 32 +++++++++++++++++++
 3 files changed, 40 insertions(+)
 create mode 100644 src/test/cfg2cmd/virgl-feature-without-gl.conf
 create mode 100644 src/test/cfg2cmd/virtio-gl-shared-blob.conf
 create mode 100644 src/test/cfg2cmd/virtio-gl-shared-blob.conf.cmd

diff --git a/src/test/cfg2cmd/virgl-feature-without-gl.conf b/src/test/cfg2cmd/virgl-feature-without-gl.conf
new file mode 100644
index 0000000..dccd37a
--- /dev/null
+++ b/src/test/cfg2cmd/virgl-feature-without-gl.conf
@@ -0,0 +1,2 @@
+# EXPECT_ERROR: You need to use virtio-gl to enable OpenGL 4.6 or Vulkan support!
+vga: std,virgl-features=opengl4.6
diff --git a/src/test/cfg2cmd/virtio-gl-shared-blob.conf b/src/test/cfg2cmd/virtio-gl-shared-blob.conf
new file mode 100644
index 0000000..821b0c5
--- /dev/null
+++ b/src/test/cfg2cmd/virtio-gl-shared-blob.conf
@@ -0,0 +1,6 @@
+# TEST: VirGL display exported over D-Bus with GL, no VNC next to it
+smbios1: uuid=7b10d7af-b932-4c66-b2c3-3996152ec465
+vga: virtio-gl,virgl-features=opengl4.6,rendernode=/dev/dri/renderD129
+vmgenid: c773c261-d800-4348-9f5d-167fadd53cf8
+
+dbus-display: 1
diff --git a/src/test/cfg2cmd/virtio-gl-shared-blob.conf.cmd b/src/test/cfg2cmd/virtio-gl-shared-blob.conf.cmd
new file mode 100644
index 0000000..0c1466c
--- /dev/null
+++ b/src/test/cfg2cmd/virtio-gl-shared-blob.conf.cmd
@@ -0,0 +1,32 @@
+/usr/bin/kvm \
+  -id 8006 \
+  -name vm8006 \
+  -no-shutdown \
+  -chardev 'socket,id=qmp,path=/var/run/qemu-server/8006.qmp,server=on,wait=off' \
+  -object 'monitor-qmp,chardev=qmp,id=monitor-qmp' \
+  -chardev 'socket,id=qmp-event,path=/var/run/qmeventd.sock,reconnect-ms=5000' \
+  -object 'monitor-qmp,chardev=qmp-event,id=monitor-qmp-event' \
+  -pidfile /var/run/qemu-server/8006.pid \
+  -daemonize \
+  -smbios 'type=1,uuid=7b10d7af-b932-4c66-b2c3-3996152ec465' \
+  -smp '1,sockets=1,cores=1,maxcpus=1' \
+  -nodefaults \
+  -boot 'menu=on,strict=on,reboot-timeout=1000,splash=/usr/share/qemu-server/bootsplash.jpg' \
+  -display 'dbus,addr=unix:path=/var/run/qemu-server/8006.dbusdisplay,gl=on,rendernode=/dev/dri/renderD129' \
+  -cpu kvm64,enforce,+kvm_pv_eoi,+kvm_pv_unhalt,+lahf_lm,+sep \
+  -m 512 \
+  -global 'PIIX4_PM.disable_s3=1' \
+  -global 'PIIX4_PM.disable_s4=1' \
+  -device 'pci-bridge,id=pci.1,chassis_nr=1,bus=pci.0,addr=0x1e' \
+  -device 'pci-bridge,id=pci.2,chassis_nr=2,bus=pci.0,addr=0x1f' \
+  -device 'pci-bridge,id=pci.4,chassis_nr=4,bus=pci.1,addr=0x1c' \
+  -device 'vmgenid,guid=c773c261-d800-4348-9f5d-167fadd53cf8' \
+  -device 'piix3-usb-uhci,id=uhci,bus=pci.0,addr=0x1.0x2' \
+  -device 'usb-tablet,id=tablet,bus=uhci.0,port=1' \
+  -device 'virtio-vga-gl,id=vga,bus=pci.0,addr=0x2,hostmem=2048M,blob=on' \
+  -device 'virtio-serial,id=spice,bus=pci.0,addr=0x9' \
+  -chardev 'qemu-vdagent,id=vdagent,name=vdagent,clipboard=on' \
+  -device 'virtserialport,chardev=vdagent,name=com.redhat.spice.0' \
+  -device 'virtio-balloon-pci,id=balloon0,bus=pci.0,addr=0x3,free-page-reporting=on' \
+  -iscsi 'initiator-name=iqn.1993-08.org.debian:01:aabbccddeeff' \
+  -machine 'type=pc+pve0'
-- 
