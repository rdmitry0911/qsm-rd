From 4fd047f6648000454cbc1c4c097f2b3acaf7fe86 Mon Sep 17 00:00:00 2001
From: Dmitry R <rdmitry0911@gmail.com>
Date: Sat, 17 Oct 2026 16:31:01 +0300
Subject: [PATCH] api: expose the WebRTC video bitrate policy

Signed-off-by: Dmitry R <rdmitry0911@gmail.com>
---
 debian/changelog                |  6 ++++++
 src/PVE/API2/Qemu.pm            | 13 +++++++++++++
 src/test/Makefile               |  1 +
 src/test/webrtc-bitrate-test.pl | 22 ++++++++++++++++++++++
 4 files changed, 42 insertions(+)
 create mode 100644 src/test/webrtc-bitrate-test.pl

diff --git a/debian/changelog b/debian/changelog
index 2fba38f9..b06060b7 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,9 @@
+qemu-server (9.2.11+shared3) trixie; urgency=medium
+
+  * Expose the per-guest WebRTC video bitrate policy through the authorized API.
+
+ -- Dmitry R <rdmitry0911@gmail.com>  Sat, 17 Oct 2026 17:00:00 +0300
+
 qemu-server (9.2.11+shared2) trixie; urgency=medium
 
   * Route VM and container WebRTC consoles through the common local service.
diff --git a/src/PVE/API2/Qemu.pm b/src/PVE/API2/Qemu.pm
index 04289463..11c81a03 100644
--- a/src/PVE/API2/Qemu.pm
+++ b/src/PVE/API2/Qemu.pm
@@ -3493,6 +3493,10 @@ __PACKAGE__->register_method({
         properties => {
             codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
             encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+            bitrate => {
+                type => 'integer', minimum => 500, maximum => 100000, optional => 1,
+                description => 'Maximum video bitrate in kbit/s. Omit to preserve the current setting.',
+            },
         },
     },
     code => sub {
@@ -3521,6 +3525,10 @@ __PACKAGE__->register_method({
             vmid => get_standard_option('pve-vmid'),
             codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
             encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+            bitrate => {
+                type => 'integer', minimum => 500, maximum => 100000, optional => 1,
+                description => 'Maximum video bitrate in kbit/s. Omit to preserve the current setting.',
+            },
         },
     },
     returns => {
@@ -3528,6 +3536,10 @@ __PACKAGE__->register_method({
         properties => {
             codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
             encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+            bitrate => {
+                type => 'integer', minimum => 500, maximum => 100000, optional => 1,
+                description => 'Maximum video bitrate in kbit/s. Omit to preserve the current setting.',
+            },
         },
     },
     code => sub {
@@ -3537,6 +3549,7 @@ __PACKAGE__->register_method({
         die "VM $vmid has no shared D-Bus display\n" if !$conf->{'dbus-display'};
         my $user = PVE::RPCEnvironment::get()->get_user();
         my $settings = { codec => $param->{codec}, encoder => $param->{encoder} };
+        $settings->{bitrate} = int($param->{bitrate}) if defined($param->{bitrate});
         return PVE::QemuServer::WebRTC::settings($vmid, $user, $settings);
     },
 });
diff --git a/src/test/Makefile b/src/test/Makefile
index 66e045d0..dd2fe947 100644
--- a/src/test/Makefile
+++ b/src/test/Makefile
@@ -4,6 +4,7 @@ test: test_dbus_display test_snapshot test_cfg_to_cmd test_cfg_to_cmd_aarch64 te
 
 test_dbus_display: dbus-display-test.pl
 	perl -I../ ./dbus-display-test.pl
+	perl -I../ ./webrtc-bitrate-test.pl
 
 test_snapshot: run_snapshot_tests.pl
 	./run_snapshot_tests.pl
diff --git a/src/test/webrtc-bitrate-test.pl b/src/test/webrtc-bitrate-test.pl
new file mode 100644
index 00000000..ca2d8edc
--- /dev/null
+++ b/src/test/webrtc-bitrate-test.pl
@@ -0,0 +1,22 @@
+use strict;
+use warnings;
+use lib '..';
+use Test::More;
+use PVE::JSONSchema;
+use PVE::API2::Qemu;
+for my $class ('PVE::API2::Qemu') {
+    my $method=$class->map_method_by_name('webrtcsettings-put');
+    is_deeply($method->{permissions}->{check}, ['perm', '/vms/{vmid}', ['VM.Config.Options']], "$class keeps write ACL");
+    my $params={node=>'lab',vmid=>108,codec=>'h264',encoder=>'auto'};
+    eval { PVE::JSONSchema::validate($params,$method->{parameters}); };
+    is($@, '', "$class accepts old clients without bitrate");
+    for my $value (500, 8000, 20000, 100000) {
+        eval { PVE::JSONSchema::validate({%$params,bitrate=>$value},$method->{parameters}); };
+        is($@, '', "$class accepts bitrate $value");
+    }
+    for my $value (0, 499, 100001, 1.5, 'unlimited') {
+        eval { PVE::JSONSchema::validate({%$params,bitrate=>$value},$method->{parameters}); };
+        ok($@, "$class rejects bitrate $value");
+    }
+}
+done_testing();
-- 
