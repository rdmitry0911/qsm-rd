+__PACKAGE__->register_method({
+    name => 'webrtcproxy',
+    path => '{vmid}/webrtcproxy',
+    method => 'POST',
+    protected => 1,
+    proxyto => 'node',
+    permissions => {
+        check => ['perm', '/vms/{vmid}', ['VM.Console']],
+    },
+    description => "Attach a WebRTC console to the display of a running VM that is exported"
+        . " over the shared D-Bus ('dbus-display'). The SDP offer is handed, together with a"
+        . " VM identifier, to the WebRTC console service of the node, which"
+        . " is provided by a separate package.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+            sdp => {
+                description => "The browser's WebRTC session description (SDP offer).",
+                type => 'string',
+                maxLength => 64 * 1024,
+            },
+            width => {
+                description => "Width of the console viewport in pixels.",
+                type => 'integer',
+                minimum => 64,
+                maximum => 16384,
+                optional => 1,
+            },
+            height => {
+                description => "Height of the console viewport in pixels.",
+                type => 'integer',
+                minimum => 64,
+                maximum => 16384,
+                optional => 1,
+            },
+            fps => {
+                description => "Requested frame rate.",
+                type => 'integer',
+                minimum => 10,
+                maximum => 240,
+                optional => 1,
+            },
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => {
+            type => {
+                type => 'string',
+                enum => ['answer'],
+            },
+            sdp => {
+                description => "The WebRTC session description of the console (SDP answer).",
+                type => 'string',
+            },
+        },
+    },
+    code => sub {
+        my ($param) = @_;
+
+        my $rpcenv = PVE::RPCEnvironment::get();
+        my $authuser = $rpcenv->get_user();
+
+        my $vmid = $param->{vmid};
+        my $conf = PVE::QemuConfig->load_config($vmid, $param->{node});
+
+        die "VM $vmid not running\n" if !PVE::QemuServer::check_running($vmid);
+
+        die "VM $vmid does not export its display over the shared D-Bus ('dbus-display')\n"
+            if !$conf->{'dbus-display'};
+
+        my $offer = { sdp => $param->{sdp} };
+        for my $opt (qw(width height fps)) {
+            $offer->{$opt} = int($param->{$opt}) if defined($param->{$opt});
+        }
+
+        return PVE::QemuServer::WebRTC::offer($vmid, $authuser, $offer);
+    },
+});
+
+__PACKAGE__->register_method({
+    name => 'webrtcstatus',
+    path => '{vmid}/webrtcstatus',
+    method => 'GET',
+    protected => 1,
+    proxyto => 'node',
+    permissions => { check => ['perm', '/vms/{vmid}', ['VM.Console']] },
+    description => "Get only the VM run state needed by a WebRTC console.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => { status => { type => 'string', enum => ['running', 'stopped'] } },
+    },
+    code => sub {
+        my ($param) = @_;
+        PVE::QemuConfig->load_config($param->{vmid}, $param->{node});
+        return {
+            status => PVE::QemuServer::check_running($param->{vmid}) ? 'running' : 'stopped' };
+    },
+});
+
+__PACKAGE__->register_method({
+    name => 'webrtcsettings-get',
+    path => '{vmid}/webrtcsettings',
+    method => 'GET',
+    protected => 1,
+    proxyto => 'node',
+    permissions => { check => ['perm', '/vms/{vmid}', ['VM.Console']] },
+    description => "Read or update the WebRTC console's node-local media policy.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => {
+            codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
+            encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+        },
+    },
+    code => sub {
+        my ($param) = @_;
+        my $vmid = $param->{vmid};
+        my $conf = PVE::QemuConfig->load_config($vmid, $param->{node});
+        die "VM $vmid has no shared D-Bus display\n" if !$conf->{'dbus-display'};
+        my $user = PVE::RPCEnvironment::get()->get_user();
+        my $settings;
+        return PVE::QemuServer::WebRTC::settings($vmid, $user, $settings);
+    },
+});
+
+__PACKAGE__->register_method({
+    name => 'webrtcsettings-put',
+    path => '{vmid}/webrtcsettings',
+    method => 'PUT',
+    protected => 1,
+    proxyto => 'node',
+    permissions => { check => ['perm', '/vms/{vmid}', ['VM.Config.Options']] },
+    description => "Read or update the WebRTC console's node-local media policy.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+            codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
+            encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => {
+            codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
+            encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+        },
+    },
+    code => sub {
+        my ($param) = @_;
+        my $vmid = $param->{vmid};
+        my $conf = PVE::QemuConfig->load_config($vmid, $param->{node});
+        die "VM $vmid has no shared D-Bus display\n" if !$conf->{'dbus-display'};
+        my $user = PVE::RPCEnvironment::get()->get_user();
+        my $settings = { codec => $param->{codec}, encoder => $param->{encoder} };
+        return PVE::QemuServer::WebRTC::settings($vmid, $user, $settings);
+    },
+});
