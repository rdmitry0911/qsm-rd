-            my $vga = PVE::QemuServer::parse_vga($conf->{vga});
+        if ($conf->{vga} || $conf->{'dbus-display'}) {
+            my $vga = PVE::QemuServer::parse_vga($conf->{vga} // 'std');
+            my $dbus_gl = PVE::QemuServer::dbus_gl_display($vga, $conf);
             my $spice = defined($vga->{type}) && $vga->{type} =~ /^virtio/;
             $spice ||= PVE::QemuServer::vga_conf_has_spice($conf->{vga});
-            $status->{spice} = 1 if $spice;
+            $status->{spice} = 1 if $spice && !$dbus_gl;
+            if ($conf->{'dbus-display'}) {
+                $status->{dbus} = 1;
+                $status->{webrtc} = -S $PVE::QemuServer::WebRTC::WEBRTC_SERVICE_SOCKET ? 1 : 0;
+                $status->{vnc} = $dbus_gl ? 0 : 1;
+            }
             $status->{clipboard} = $vga->{clipboard};
         }
         $status->{agent} = 1 if PVE::QemuServer::Agent::get_qga_key($conf, 'enabled');
