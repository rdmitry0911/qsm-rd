diff --git a/src/tests/webrtc-tests.pl b/src/tests/webrtc-tests.pl
new file mode 100644
index 0000000..cefc1a7
--- /dev/null
+++ b/src/tests/webrtc-tests.pl
@@ -0,0 +1,46 @@
+#!/usr/bin/perl
+use strict;
+use warnings;
+use lib '..';
+use File::Temp qw(tempdir);
+use IO::Socket::UNIX;
+use JSON;
+use Socket qw(SOCK_STREAM);
+use Test::More;
+use PVE::WebRTC;
+
+my $directory = tempdir(CLEANUP => 1);
+local $PVE::WebRTC::WEBRTC_SERVICE_SOCKET = "$directory/service.sock";
+eval { PVE::WebRTC::settings('lxc', 105, 'u@pve', undef) };
+like($@, qr/no WebRTC console service/, 'a missing service is explicit');
+open(my $ordinary, '>', $PVE::WebRTC::WEBRTC_SERVICE_SOCKET) or die $!;
+close($ordinary);
+eval { PVE::WebRTC::settings('lxc', 105, 'u@pve', undef) };
+like($@, qr/not owned by root/, 'ordinary files cannot receive authorized requests');
+unlink($PVE::WebRTC::WEBRTC_SERVICE_SOCKET);
+
+SKIP: {
+    skip 'root ownership checks require a root build fixture', 8 if $> != 0;
+    for my $kind (qw(qemu lxc)) {
+        my $server = IO::Socket::UNIX->new(Type => SOCK_STREAM, Local => $PVE::WebRTC::WEBRTC_SERVICE_SOCKET,
+            Listen => 1) or die $!;
+        my $pid = fork(); die $! if !defined($pid);
+        if (!$pid) {
+            my $client = $server->accept() or die $!;
+            my $request = decode_json(scalar <$client>);
+            my $valid = $request->{version} == 2 && $request->{kind} eq $kind
+                && $request->{vmid} == 105 && $request->{user} eq 'u@pve'
+                && $request->{offer}->{sdp} eq "v=0\r\n"
+                && !exists($request->{ticket});
+            print {$client} encode_json({ok => $valid ? 1 : 0, answer => {type => 'answer', sdp => "v=0\r\n"}}) . "\n";
+            close($client); exit($valid ? 0 : 1);
+        }
+        my $answer = PVE::WebRTC::offer($kind, 105, 'u@pve', {sdp => "v=0\r\n"});
+        is($answer->{type}, 'answer', "$kind receives an answer over the common socket");
+        is($answer->{sdp}, "v=0\r\n", "$kind preserves the SDP answer");
+        waitpid($pid, 0); is($?, 0, "$kind carries the guest identity without a PVE ticket");
+        close($server); unlink($PVE::WebRTC::WEBRTC_SERVICE_SOCKET);
+        ok(!-e $PVE::WebRTC::WEBRTC_SERVICE_SOCKET, "$kind fixture is released");
+    }
+}
+done_testing();
