diff --git a/src/test/webrtc_test.pl b/src/test/webrtc_test.pl
new file mode 100644
index 0000000..88b9cc4
--- /dev/null
+++ b/src/test/webrtc_test.pl
@@ -0,0 +1,22 @@
+#!/usr/bin/perl
+use strict;
+use warnings;
+use lib '..';
+use Test::More;
+use PVE::API2::LXC;
+
+for my $name (qw(webrtcproxy webrtcstatus webrtcsettings-get webrtcsettings-put)) {
+    my $method = PVE::API2::LXC->map_method_by_name($name);
+    ok($method->{protected}, "$name is handled by the privileged daemon");
+    is($method->{proxyto}, 'node', "$name is routed to the owning node");
+    is_deeply($method->{permissions}->{check},
+        ['perm', '/vms/{vmid}', [$name eq 'webrtcsettings-put' ? 'VM.Config.Options' : 'VM.Console']],
+        "$name retains its specific ACL boundary");
+    ok(!$method->{parameters}->{additionalProperties}, "$name rejects additional parameters");
+}
+my $offer = PVE::API2::LXC->map_method_by_name('webrtcproxy');
+is($offer->{method}, 'POST', 'offers are CSRF-protected writes');
+is($offer->{parameters}->{properties}->{sdp}->{maxLength}, 65536, 'offers are bounded');
+is(PVE::API2::LXC->map_method_by_name('webrtcsettings-put')->{method}, 'PUT', 'settings writes use PUT');
+
+done_testing();
-- 
