diff --git a/src/PVE/API2/LXC.pm b/src/PVE/API2/LXC.pm
index 22320ba..27dcded 100644
--- a/src/PVE/API2/LXC.pm
+++ b/src/PVE/API2/LXC.pm
@@ -26,6 +26,7 @@ use PVE::SafeSyslog;
 use PVE::Storage;
 use PVE::Ticket;
 use PVE::Tools qw(extract_param run_command);
+use PVE::WebRTC;
 use PVE::VZDump::Plugin;
 
 use PVE::LXC;
@@ -699,6 +700,9 @@ __PACKAGE__->register_method({
             { subdir => 'pending' },
             { subdir => 'status' },
             { subdir => 'vncproxy' },
+            { subdir => 'webrtcproxy' },
+            { subdir => 'webrtcsettings' },
+            { subdir => 'webrtcstatus' },
             { subdir => 'termproxy' },
             { subdir => 'vncwebsocket' },
             { subdir => 'spiceproxy' },
@@ -934,6 +938,176 @@ __PACKAGE__->register_method({
 
 my $sslcert;
 
+__PACKAGE__->register_method({
+    name => 'webrtcproxy',
+    path => '{vmid}/webrtcproxy',
+    method => 'POST',
+    protected => 1,
+    proxyto => 'node',
+    permissions => {
+        check => ['perm', '/vms/{vmid}', ['VM.Console']],
+    },
+    description => "Attach a WebRTC console to a running container. A separate node-local"
+        . " console service provides the graphical display and answers the SDP offer.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+            sdp => {
+                description => "The browser's WebRTC session description (SDP offer).",
+                type => 'string',
+                maxLength => 64 * 1024,
+            },
+            width => {
+                description => "Width of the console viewport in pixels.",
+                type => 'integer',
+                minimum => 64,
+                maximum => 16384,
+                optional => 1,
+            },
+            height => {
+                description => "Height of the console viewport in pixels.",
+                type => 'integer',
+                minimum => 64,
+                maximum => 16384,
+                optional => 1,
+            },
+            fps => {
+                description => "Requested frame rate.",
+                type => 'integer',
+                minimum => 10,
+                maximum => 240,
+                optional => 1,
+            },
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => {
+            type => {
+                type => 'string',
+                enum => ['answer'],
+            },
+            sdp => {
+                description => "The WebRTC session description of the console (SDP answer).",
+                type => 'string',
+            },
+        },
+    },
+    code => sub {
+        my ($param) = @_;
+
+        my $rpcenv = PVE::RPCEnvironment::get();
+        my $authuser = $rpcenv->get_user();
+
+        my $vmid = $param->{vmid};
+        my $conf = PVE::LXC::Config->load_config($vmid, $param->{node});
+
+        die "CT $vmid not running\n" if !PVE::LXC::check_running($vmid);
+
+        my $offer = { sdp => $param->{sdp} };
+        for my $opt (qw(width height fps)) {
+            $offer->{$opt} = int($param->{$opt}) if defined($param->{$opt});
+        }
+
+        return PVE::WebRTC::offer('lxc', $vmid, $authuser, $offer);
+    },
+});
+
+__PACKAGE__->register_method({
+    name => 'webrtcstatus',
+    path => '{vmid}/webrtcstatus',
+    method => 'GET',
+    protected => 1,
+    proxyto => 'node',
+    permissions => { check => ['perm', '/vms/{vmid}', ['VM.Console']] },
+    description => "Get only the container run state needed by a WebRTC console.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => { status => { type => 'string', enum => ['running', 'stopped'] } },
+    },
+    code => sub {
+        my ($param) = @_;
+        PVE::LXC::Config->load_config($param->{vmid}, $param->{node});
+        return {
+            status => PVE::LXC::check_running($param->{vmid}) ? 'running' : 'stopped' };
+    },
+});
+
+__PACKAGE__->register_method({
+    name => 'webrtcsettings-get',
+    path => '{vmid}/webrtcsettings',
+    method => 'GET',
+    protected => 1,
+    proxyto => 'node',
+    permissions => { check => ['perm', '/vms/{vmid}', ['VM.Console']] },
+    description => "Read or update the WebRTC console's node-local media policy.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => {
+            codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
+            encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+        },
+    },
+    code => sub {
+        my ($param) = @_;
+        my $vmid = $param->{vmid};
+        my $conf = PVE::LXC::Config->load_config($vmid, $param->{node});
+        my $user = PVE::RPCEnvironment::get()->get_user();
+        my $settings;
+        return PVE::WebRTC::settings('lxc', $vmid, $user, $settings);
+    },
+});
+
+__PACKAGE__->register_method({
+    name => 'webrtcsettings-put',
+    path => '{vmid}/webrtcsettings',
+    method => 'PUT',
+    protected => 1,
+    proxyto => 'node',
+    permissions => { check => ['perm', '/vms/{vmid}', ['VM.Config.Options']] },
+    description => "Read or update the WebRTC console's node-local media policy.",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            vmid => get_standard_option('pve-vmid'),
+            codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
+            encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+        },
+    },
+    returns => {
+        type => 'object',
+        properties => {
+            codec => { type => 'string', enum => ['auto', 'h264', 'hevc'] },
+            encoder => { type => 'string', enum => ['auto', 'hardware', 'software'] },
+        },
+    },
+    code => sub {
+        my ($param) = @_;
+        my $vmid = $param->{vmid};
+        my $conf = PVE::LXC::Config->load_config($vmid, $param->{node});
+        my $user = PVE::RPCEnvironment::get()->get_user();
+        my $settings = { codec => $param->{codec}, encoder => $param->{encoder} };
+        return PVE::WebRTC::settings('lxc', $vmid, $user, $settings);
+    },
+});
+
 __PACKAGE__->register_method({
     name => 'vncproxy',
     path => '{vmid}/vncproxy',
