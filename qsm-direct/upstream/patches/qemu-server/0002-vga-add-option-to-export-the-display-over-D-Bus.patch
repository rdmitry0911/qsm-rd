index 922c6599..7a74de93 100644
--- a/src/PVE/API2/Qemu.pm
+++ b/src/PVE/API2/Qemu.pm
@@ -3009,6 +3009,8 @@ __PACKAGE__->register_method({
         if ($conf->{vga}) {
             my $vga = PVE::QemuServer::parse_vga($conf->{vga});
             $serial = $vga->{type} if defined($vga->{type}) && $vga->{type} =~ m/^serial\d+$/;
+            die "VM $vmid has no VNC console: its GL display is exported over D-Bus\n"
+                if PVE::QemuServer::dbus_gl_display($vga);
         }
 
         my $authpath = "/vms/$vmid";
@@ -3374,6 +3376,10 @@ __PACKAGE__->register_method({
         my $title = "VM $vmid";
         $title .= " - " . $conf->{name} if $conf->{name};
 
+        die "VM $vmid has no SPICE console: its GL display is exported over D-Bus\n"
+            if $conf->{vga}
+            && PVE::QemuServer::dbus_gl_display(PVE::QemuServer::parse_vga($conf->{vga}));
+
         my $port = PVE::QemuServer::spice_port($vmid);
 
         my ($ticket, undef, $remote_viewer_config) =
diff --git a/src/PVE/QemuServer.pm b/src/PVE/QemuServer.pm
index 223c9a2f..61e2f293 100644
--- a/src/PVE/QemuServer.pm
+++ b/src/PVE/QemuServer.pm
@@ -187,6 +187,15 @@ my $vga_fmt = {
         enum => ['vnc'],
         optional => 1,
     },
+    dbus => {
+        description => "Also export the display over QEMU's D-Bus display interface, in"
+            . " peer-to-peer mode: a console attaches per connection through QMP, no D-Bus"
+            . " daemon is involved. With 'virtio-gl', QEMU does not allow VNC or SPICE next to"
+            . " the GL-enabled D-Bus display, so the VM then has neither of those consoles.",
+        type => 'boolean',
+        default => 0,
+        optional => 1,
+    },
     rendernode => {
         description => "The DRM render node the 'virtio-gl' display renders on, for example"
             . " '/dev/dri/renderD129' to use the second GPU. If not set, QEMU uses the first"
@@ -1524,6 +1533,14 @@ sub assert_virgl_available {
     }
 }
 
+# Whether the display is a GL-enabled D-Bus display. QEMU refuses VNC and SPICE
+# next to it ("Display vnc is incompatible with the GL context").
+sub dbus_gl_display {
+    my ($vga) = @_;
+
+    return $vga->{dbus} && $vga->{type} && $vga->{type} eq 'virtio-gl';
+}
+
 sub print_vga_device {
     my ($conf, $vga, $arch, $machine_version, $id, $qxlnum) = @_;
 
@@ -3435,15 +3452,24 @@ sub config_to_command {
         push @$devices, '-device',
             print_vga_device($conf, $vga, $arch, $machine_version, undef, $qxlnum);
 
-        if ($vga->{type} eq 'virtio-gl') { # VIRGL
+        my $virgl = $vga->{type} eq 'virtio-gl';
+        if ($vga->{dbus}) {
+            # consumers are attached with QMP 'add_client', so no bus is needed
+            my $display = 'dbus,p2p=yes,gl=' . ($virgl ? 'on' : 'off');
+            $display .= ",rendernode=$vga->{rendernode}" if $vga->{rendernode};
+            push @$cmd, '-display', $display;
+        } elsif ($virgl) { # VIRGL
             my $display = 'egl-headless,gl=core';
             $display .= ",rendernode=$vga->{rendernode}" if $vga->{rendernode};
             push @$cmd, '-display', $display;
         }
 
-        my $socket = PVE::QemuServer::Helpers::vnc_socket($vmid);
-        push @$cmd, '-vnc', "unix:$socket,password=on";
+        if (!dbus_gl_display($vga)) {
+            my $socket = PVE::QemuServer::Helpers::vnc_socket($vmid);
+            push @$cmd, '-vnc', "unix:$socket,password=on";
+        }
     } else {
+        die "'dbus' needs a graphical display, not '$vga->{type}'\n" if $vga->{dbus};
         push @$cmd, '-vga', 'none' if $vga->{type} eq 'none';
         push @$cmd, '-nographic';
     }
@@ -3516,7 +3542,7 @@ sub config_to_command {
     my $spice_port;
 
     assert_clipboard_config($vga);
-    my $is_spice = $qxlnum || $vga->{type} =~ /^virtio/;
+    my $is_spice = !dbus_gl_display($vga) && ($qxlnum || $vga->{type} =~ /^virtio/);
 
     if ($is_spice || ($vga->{'clipboard'} && $vga->{'clipboard'} eq 'vnc')) {
         if ($qxlnum > 1) {
