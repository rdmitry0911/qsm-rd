diff --git a/src/PVE/QemuServer.pm b/src/PVE/QemuServer.pm
index f199371d..223c9a2f 100644
--- a/src/PVE/QemuServer.pm
+++ b/src/PVE/QemuServer.pm
@@ -187,6 +187,15 @@ my $vga_fmt = {
         enum => ['vnc'],
         optional => 1,
     },
+    rendernode => {
+        description => "The DRM render node the 'virtio-gl' display renders on, for example"
+            . " '/dev/dri/renderD129' to use the second GPU. If not set, QEMU uses the first"
+            . " render node.",
+        type => 'string',
+        pattern => '/dev/dri/renderD\d+',
+        format_description => 'path',
+        optional => 1,
+    },
 };
 
 my $ivshmem_fmt = {
@@ -1495,6 +1504,26 @@ my sub map_vga_model {
     return $arch eq 'aarch64' ? $vga_map_aarch64->{$vga_type} : $vga_map->{$vga_type};
 }
 
+sub assert_virgl_available {
+    my ($rendernode) = @_;
+
+    # VirGL renders on the host, so the guest arch is irrelevant for the library lookup
+    my $host_arch = get_host_arch();
+    my $base = "/usr/lib/${host_arch}-linux-gnu/lib";
+
+    die "missing libraries for 'virtio-gl' detected! Please install 'libgl1' and 'libegl1'\n"
+        if !-e "${base}EGL.so.1" || !-e "${base}GL.so.1";
+
+    if ($rendernode) {
+        die "DRM render node '$rendernode' does not exist - needed for 'virtio-gl' display\n"
+            if !-c $rendernode;
+    } else {
+        die
+            "no DRM render node detected (/dev/dri/renderD*), no GPU? - needed for 'virtio-gl' display\n"
+            if !PVE::Tools::dir_glob_regex('/dev/dri/', "renderD.*");
+    }
+}
+
 sub print_vga_device {
     my ($conf, $vga, $arch, $machine_version, $id, $qxlnum) = @_;
 
@@ -1549,16 +1578,9 @@ sub print_vga_device {
     }
 
     if ($vga->{type} eq 'virtio-gl') {
-        # VirGL renders on the host, so the guest arch is irrelevant for the library lookup
-        my $host_arch = get_host_arch();
-        my $base = "/usr/lib/${host_arch}-linux-gnu/lib";
-
-        die "missing libraries for '$vga->{type}' detected! Please install 'libgl1' and 'libegl1'\n"
-            if !-e "${base}EGL.so.1" || !-e "${base}GL.so.1";
-
-        die
-            "no DRM render node detected (/dev/dri/renderD*), no GPU? - needed for '$vga->{type}' display\n"
-            if !PVE::Tools::dir_glob_regex('/dev/dri/', "renderD.*");
+        assert_virgl_available($vga->{rendernode});
+    } elsif ($vga->{rendernode}) {
+        die "'rendernode' is only supported with the 'virtio-gl' display\n";
     }
 
     return "$type,id=${vgaid}${memory}${max_outputs}${pciaddr}${edidoff}";
@@ -3413,7 +3435,11 @@ sub config_to_command {
         push @$devices, '-device',
             print_vga_device($conf, $vga, $arch, $machine_version, undef, $qxlnum);
 
-        push @$cmd, '-display', 'egl-headless,gl=core' if $vga->{type} eq 'virtio-gl'; # VIRGL
+        if ($vga->{type} eq 'virtio-gl') { # VIRGL
+            my $display = 'egl-headless,gl=core';
+            $display .= ",rendernode=$vga->{rendernode}" if $vga->{rendernode};
+            push @$cmd, '-display', $display;
+        }
 
         my $socket = PVE::QemuServer::Helpers::vnc_socket($vmid);
         push @$cmd, '-vnc', "unix:$socket,password=on";
