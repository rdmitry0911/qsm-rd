+
+// With the common PVE platform, the LXC availability probe must never
+// read a bearer ticket or contact the legacy HTTPS service.
+{
+    const nativeDefinitions = new Map();
+    const seen = [];
+    const nativeContext = {
+        gettext: text => text, AbortSignal, URLSearchParams,
+        window: {},
+        PVE: { Utils: { openWebRTCViewer: () => undefined } },
+        Proxmox: { CSRFPreventionToken: 'test-csrf' },
+        Ext: {
+            define: (name, body) => nativeDefinitions.set(name, body),
+            util: { Cookies: { get: () => assert.fail('native LXC must use the PVE session') } },
+        },
+        fetch: async (url, options) => {
+            seen.push({ url, options });
+            return { ok: true, json: async () => ({ data: { codec: 'auto', encoder: 'auto' } }) };
+        },
+    };
+    vm.runInNewContext(source, nativeContext);
+    let enabled = false;
+    const menu = { on: () => undefined };
+    const button = { down: () => null, getMenu: () => menu,
+        setEnableQsmDirect: value => { enabled = value; } };
+    nativeDefinitions.get('PVE.qsmDirect.LxcConfigOverlay').initComponent.call({
+        callParent: () => undefined,
+        pveSelNode: { data: { node: 'pve-a', vmid: 105 } },
+        down: () => button, on: () => undefined,
+    });
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(enabled, true);
+    assert.equal(seen.length, 1);
+    assert.equal(seen[0].url, '/api2/json/nodes/pve-a/lxc/105/webrtcsettings');
+    assert.equal(seen[0].options.credentials, 'same-origin');
+    assert.equal(seen[0].options.headers, undefined);
+}
diff --git a/qsm-direct/tests/proxmox_pve9/test_direct_ui_package_state.py b/qsm-direct/tests/proxmox_pve9/test_direct_ui_package_state.py
new file mode 100644
index 0000000..2119ccf
--- /dev/null
+++ b/qsm-direct/tests/proxmox_pve9/test_direct_ui_package_state.py
@@ -0,0 +1,29 @@
+"""PVE UI stays available during an ordinary multi-package upgrade."""
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "integration/proxmox/pve9/direct_ui"))
+from qsm_pve_direct_ui import _default_package_version, UnsupportedPve
+
+
+class PackageStateTests(unittest.TestCase):
+    def test_configured_package_with_pending_triggers_is_usable(self):
+        for state in ("installed", "triggers-pending", "triggers-awaited"):
+            with self.subTest(state=state), patch("qsm_pve_direct_ui.subprocess.run", return_value=
+                    subprocess.CompletedProcess([], 0, state + "\t9.2.21\n")):
+                self.assertEqual(_default_package_version(), "9.2.21")
+
+    def test_unconfigured_or_malformed_packages_remain_unsupported(self):
+        for value in ("half-configured\t9.2.21", "half-installed\t9.2.21",
+                      "config-files\t9.2.21", "not-installed\t9.2.21", "installed", "installed\t../bad"):
+            with self.subTest(value=value), patch("qsm_pve_direct_ui.subprocess.run", return_value=
+                    subprocess.CompletedProcess([], 0, value)):
+                with self.assertRaises(UnsupportedPve):
+                    _default_package_version()
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/qsm-direct/tests/proxmox_pve9/test_shared_display.py b/qsm-direct/tests/proxmox_pve9/test_shared_display.py
