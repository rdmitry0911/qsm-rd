  "changes_retained": {
    "exp183": "Fresh matched packet credit keeps flight admission bound when frame receipts coalesce (prepared by the previous agent; validated live here).",
    "exp184_severe_step": "Delivery below half the offered load with >50ms queue and 25ms slow confirmation no longer waits for the overuse trend. Offline: one 50ms report earlier on PVE; live peak packet queue was 255-272ms.",
    "exp184_standing_queue": "A flight-limited sender offers only what is delivered, hiding a target above capacity from the offered/delivered test. Queue >80ms held >=1s (ending only at <=50ms) with >=100ms of real flight waits per 600ms and delivery below 85% of target now reduces to 90% of the mean rate over that period.",
    "exp185_quality_floor": "Cropped H264 NVENC qmin0/qmax32 with init QP32. Previously rejected with init QP26; that record itself stated causality was unproven. Fixes the sporadic first-cut SSIM miss.",
    "exp186_step_capacity": "A severe step states its capacity from the newest 50ms interval without the 90% margin. The codec stays at 70% of target; the margin only slowed the following IDR."
  },
  "rejected": {
    "exp187_deferred_floor": "Open without the QP floor on a confirmed cut and restore it after 1s. FFmpeg can only change NVENC QP bounds by reopening, measured at 230-304ms of blocked encoding; uncapped IDR was still 34.5KB. Worker/core source restored.",
    "exp188_no_refresh_in_place_retune": "NVENC without confirmed refresh or retune IDR. Excess 413-595ms: confirmed refresh is genuinely valuable. Source restored.",
    "ssh_forward_artifact_hypothesis": "Native base delay is not an SSH artifact: TCP connect RTT to that node is ~85ms."
  },
