#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# QSM Direct container console: the desktop session of one logged-in user,
# started by qsm-login as qsm-user-session@USER.service (a real PAM/logind
# session on seat0) inside the console display (headless sway), as either
#   wayland  Plasma Wayland; KWin runs nested as a fullscreen display window
#   x11      Plasma X11; a rootful Xwayland runs fullscreen in the display and
#            kwin_x11 manages it
# qsm-login passes QSM_SESSION_TYPE, QSM_DISPLAY_SOCKET (the display's
# wayland socket; this user alone may connect while the session lasts) and
# QSM_DISPLAY_GEOMETRY (the display's current size).  Logging out of Plasma
# ends this script, the unit and the session; qsm-login then shows the
# login screen again.
set -u

type=${QSM_SESSION_TYPE:-wayland}
export QSM_OUTER_DISPLAY=${QSM_DISPLAY_SOCKET:?qsm-session-launch: started without QSM_DISPLAY_SOCKET}
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# pam_systemd exports the user bus only if it already exists; on a first login
# the user manager is still starting, and startplasma fails without a bus.
for _ in $(seq 1 50); do [ -S "$runtime/bus" ] && break; sleep 0.1; done
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime/bus}

# A previous session's Plasma targets can outlive startplasma (they are bound
# to the window manager, not to this process); if left active, startplasma
# sees them "already started" and brings up no shell.
systemctl --user stop plasma-workspace-wayland.target plasma-workspace-x11.target plasma-workspace.target \
    graphical-session.target 2>/dev/null || true
# Individual Plasma services of the previous session can outlive their target
# too (kded, the shell, ...), and the manager environment still points at the
# previous session's display: after an x11 -> wayland switch the new session
# came up without a shell.  Start from a clean slate.
# kded ignores SIGTERM while blocked in its first D-Bus calls (25 s for an
# absent ModemManager), so give the stop 5 s and then kill what is left.
plasma_units_left() {
    systemctl --user list-units --no-legend --state=active,activating,deactivating 'plasma-*.service' 2>/dev/null |
        grep -q .
}
systemctl --user --no-block stop 'plasma-*.service' 2>/dev/null || true
for _ in $(seq 1 25); do plasma_units_left || break; sleep 0.2; done
if plasma_units_left; then
    systemctl --user kill --signal=SIGKILL 'plasma-*.service' 2>/dev/null || true
    for _ in $(seq 1 25); do plasma_units_left || break; sleep 0.2; done
fi
systemctl --user unset-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_SESSION_TYPE \
    DESKTOP_SESSION 2>/dev/null || true
# The nested KWin unit reads the display path from the manager environment.
systemctl --user set-environment QSM_OUTER_DISPLAY="$QSM_OUTER_DISPLAY"

export XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE
case "$type" in
wayland)
    export XDG_SESSION_TYPE=wayland DESKTOP_SESSION=plasmawayland
    exec /usr/bin/startplasma-wayland
    ;;
x11)
    export XDG_SESSION_TYPE=x11 DESKTOP_SESSION=plasma
    ready=$(mktemp "$runtime/qsm-xwayland.XXXXXX")
    # Rootful and *windowed* at the display's current size: the display's
    # fullscreen rule then sizes the window, and a windowed rootful Xwayland
    # follows every later resize (Xwayland's own -fullscreen does not track a
    # headless output and picks its largest emulated mode instead).  SHM
    # rendering: the headless display offers no DRM device for glamor.
    WAYLAND_DISPLAY=$QSM_OUTER_DISPLAY /usr/bin/Xwayland :10 -geometry "${QSM_DISPLAY_GEOMETRY:-1920x1080}" \
        -noreset -nolisten tcp -shm -displayfd 3 3>"$ready" &
    xwayland=$!
    trap 'kill "$xwayland" 2>/dev/null; rm -f "$ready"' EXIT
    for _ in $(seq 1 100); do
        [ -s "$ready" ] && break
        kill -0 "$xwayland" 2>/dev/null || { echo "qsm-session-launch: Xwayland exited" >&2; exit 1; }
        sleep 0.1
    done
    export DISPLAY=:$(tr -d '[:space:]' < "$ready")
    unset WAYLAND_DISPLAY
    systemctl --user set-environment DISPLAY="$DISPLAY" XDG_SESSION_TYPE=x11
    /usr/bin/startplasma-x11
    ;;
*)
    echo "qsm-session-launch: unknown session type '$type' (use wayland or x11)" >&2
    exit 1
    ;;
esac
