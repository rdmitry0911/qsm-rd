 void WaylandKeyboardBackend::disconnect()
 {
+    delete m_timer;
+    m_timer = nullptr;
 }
 
 void WaylandKeyboardBackend::sendChanges()
 {
+    if (d->layout_id < 0 || d->layout_id >= d->layouts.size()) {
+        d->layout_id = m_confirmedLayout;
+        return;
+    }
+    auto *layout = qobject_cast<KeyboardLayout *>(d->layouts[d->layout_id]);
+    const auto reply = request({{QStringLiteral("op"), QStringLiteral("set")},
+                                {QStringLiteral("layout"), layout->shortName()}});
+    d->layout_id = m_confirmedLayout; // Keep the confirmed selection on failure.
+    update(reply);
 }
 
 void WaylandKeyboardBackend::dispatchEvents()
 {
+    update(request({{QStringLiteral("op"), QStringLiteral("get")}}));
 }
 
 void WaylandKeyboardBackend::connectEventsDispatcher(KeyboardModel *model)
 {
-    Q_UNUSED(model);
+    if (!d->enabled)
+        return;
+    m_timer = new QTimer(model);
+    m_timer->setInterval(500);
+    QObject::connect(m_timer, SIGNAL(timeout()), model, SLOT(dispatchEvents()));
+    m_timer->start();
 }
 
 } // namespace SDDM
