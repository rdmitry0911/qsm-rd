+    if (!reply.value(QStringLiteral("ok")).toBool())
+        return;
+    const QString selected = reply.value(QStringLiteral("layout")).toString();
+    for (int index = 0; index < d->layouts.size(); ++index) {
+        auto *layout = qobject_cast<KeyboardLayout *>(d->layouts[index]);
+        if (layout && layout->shortName() == selected) {
+            m_confirmedLayout = index;
+            d->layout_id = index;
+            return;
+        }
+    }
