#!/usr/bin/python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""QSM Direct login manager for one container console ("slot").

A container has no VT, so greetd/SDDM cannot run.  Like the ttys of PVE's
terminal console, a container has several QSM consoles (qsm-display@N: a
headless sway each); every PVE Console gets one of them, starting at its
login screen, and never sees another Console's desktop.  qsm-login@N is the
small display manager of console N:

  * shows the greeter (qsm-greeter, as the unprivileged user qsm-greeter) on
    the display and talks to it over an inherited socketpair;
  * verifies a login with PAM (service "qsm-login": common-auth +
    common-account) -- only this root process ever sees a password check;
  * starts the session as the transient system unit qsm-session-N.service
    (User=, PAMName=qsm-direct-session), so systemd opens a real PAM/logind
    session on seat0 (polkit, user manager, limits, environment);
  * shows the greeter again when the session ends (Log Out);
  * answers the host on /run/qsm-login/N/control (root only): "status" (who
    is logged in) and "reset" (log the session out, fresh login screen) --
    the host logs a desktop out when its Console was closed and its PVE user
    did not come back within the grace period.

Only the current client of the display may connect to it: the display socket
gets a POSIX ACL entry for the greeter user or the logged-in user alone (the
idea of logind's uaccess), revoked when that phase ends.
"""
from __future__ import annotations

import ctypes
import ctypes.util
import json
import os
import pwd
import re
import shutil
import socket
import stat
import subprocess
import sys
import threading
import time
from pathlib import Path

SLOT = int(sys.argv[1]) if len(sys.argv) > 1 and re.fullmatch(r"[1-8]", sys.argv[1]) else 1
DISPLAY_DIR = Path(f"/run/qsm-display-{SLOT}")
RUN_ROOT = Path("/run/qsm-login")
RUN_DIR = RUN_ROOT / str(SLOT)                  # root only: control socket, session env
GREETER_RUNTIME = RUN_ROOT / f"greeter-{SLOT}"  # the greeter's XDG_RUNTIME_DIR
CLIPBOARD_DIR = RUN_ROOT / f"clip-{SLOT}"       # the session's clipboard agent socket
SESSION_UNIT = f"qsm-session-{SLOT}.service"
STATE_DIR = Path("/var/lib/qsm-login")
DEFAULT_SESSION_FILE = Path("/etc/qsm-direct/session-type")
GREETER = "/usr/lib/qsm-console/qsm-greeter"
LAUNCHER = "/usr/lib/qsm-console/qsm-session-launch"
GREETER_USER = "qsm-greeter"
PAM_SERVICE = "qsm-login"
SESSIONS = ("wayland", "x11")
USER_NAME = re.compile(r"\A[a-z_][a-z0-9_-]{0,31}\Z")
MAX_MESSAGE = 4096


def log(message: str) -> None:
    print(f"qsm-login[{SLOT}]: {message}", file=sys.stderr, flush=True)


# ------------------------------------------------------------------ PAM
class _PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]


class _PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_void_p), ("resp_retcode", ctypes.c_int)]


_CONV = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(_PamMessage)),
                         ctypes.POINTER(ctypes.POINTER(_PamResponse)), ctypes.c_void_p)


class _PamConv(ctypes.Structure):
    _fields_ = [("conv", _CONV), ("appdata_ptr", ctypes.c_void_p)]


_libc = ctypes.CDLL(ctypes.util.find_library("c"))
_libc.calloc.restype = ctypes.c_void_p
_libc.calloc.argtypes = (ctypes.c_size_t, ctypes.c_size_t)
_libc.strdup.restype = ctypes.c_void_p
_libc.strdup.argtypes = (ctypes.c_char_p,)
_libpam = ctypes.CDLL(ctypes.util.find_library("pam") or "libpam.so.0")
_libpam.pam_start.argtypes = (ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(_PamConv),
                              ctypes.POINTER(ctypes.c_void_p))
_libpam.pam_authenticate.argtypes = (ctypes.c_void_p, ctypes.c_int)
_libpam.pam_acct_mgmt.argtypes = (ctypes.c_void_p, ctypes.c_int)
_libpam.pam_end.argtypes = (ctypes.c_void_p, ctypes.c_int)
_libpam.pam_strerror.argtypes = (ctypes.c_void_p, ctypes.c_int)
_libpam.pam_strerror.restype = ctypes.c_char_p
PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON, PAM_ERROR_MSG, PAM_TEXT_INFO = 1, 2, 3, 4
PAM_SUCCESS, PAM_AUTH_ERR, PAM_NEW_AUTHTOK_REQD, PAM_CONV_ERR = 0, 7, 12, 19


def pam_check(user: str, password: str) -> str | None:
    """Authenticate and check the account.  None on success, else a message."""
    secret = password.encode()
    notes: list[str] = []

    def converse(count, messages, responses, _data):
        array = _libc.calloc(count, ctypes.sizeof(_PamResponse))
        if not array:
            return PAM_CONV_ERR
        replies = ctypes.cast(array, ctypes.POINTER(_PamResponse))
        for index in range(count):
            style = messages[index].contents.msg_style
            text = (messages[index].contents.msg or b"").decode(errors="replace").strip()
            if style == PAM_PROMPT_ECHO_OFF:
                replies[index].resp = _libc.strdup(secret)
            elif style == PAM_PROMPT_ECHO_ON:
                replies[index].resp = _libc.strdup(user.encode())
            elif text:
                notes.append(text)
        responses[0] = replies
        return PAM_SUCCESS

    conversation = _PamConv(_CONV(converse), None)
    handle = ctypes.c_void_p()
    result = _libpam.pam_start(PAM_SERVICE.encode(), user.encode(), ctypes.byref(conversation),
                               ctypes.byref(handle))
    if result != PAM_SUCCESS:
        return "The login service is unavailable."
    try:
        result = _libpam.pam_authenticate(handle, 0)
        if result == PAM_SUCCESS:
            result = _libpam.pam_acct_mgmt(handle, 0)
            if result == PAM_NEW_AUTHTOK_REQD:
                return "The password has expired; change it in the container (passwd) first."
        if result != PAM_SUCCESS:
            log(f"login of {user} refused: {_libpam.pam_strerror(handle, result).decode()}")
            # Authentication failures stay generic; account problems (expired,
            # locked, nologin) are worth their module's explanation.
            if result == PAM_AUTH_ERR or not notes:
                return "Login failed: wrong user name or password."
            return notes[-1]
        return None
    finally:
        _libpam.pam_end(handle, result)




# ------------------------------------------------------------------ helpers
def login_users() -> list[dict[str, str]]:
    users = []
    for entry in pwd.getpwall():
        if 1000 <= entry.pw_uid < 60000 and USER_NAME.fullmatch(entry.pw_name) and \
                not entry.pw_shell.endswith(("nologin", "/false")) and entry.pw_name != GREETER_USER:
            users.append({"name": entry.pw_name, "full": entry.pw_gecos.split(",")[0] or entry.pw_name})
    return sorted(users, key=lambda user: user["name"])


def default_session() -> str:
    try:
        value = DEFAULT_SESSION_FILE.read_text().strip()
    except OSError:
        value = ""
    return value if value in SESSIONS else "wayland"


def read_state(name: str) -> str:
    try:
        return (STATE_DIR / name).read_text().strip()
    except OSError:
        return ""


def write_state(name: str, value: str) -> None:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = STATE_DIR / f".{name}.{SLOT}.tmp"
    temporary.write_text(value + "\n")
    os.replace(temporary, STATE_DIR / name)


def display_socket(timeout: float | None = None) -> Path | None:
    """The display's wayland socket (lowest wayland-N), waiting for it."""
    deadline = None if timeout is None else time.monotonic() + timeout
    while True:
        try:
            names = sorted((entry.name for entry in os.scandir(DISPLAY_DIR)
                            if re.fullmatch(r"wayland-[0-9]+", entry.name)
                            and stat.S_ISSOCK(entry.stat(follow_symlinks=False).st_mode)),
                           key=lambda name: int(name.split("-")[1]))
        except OSError:
            names = []
        if names:
            return DISPLAY_DIR / names[0]
        if deadline is not None and time.monotonic() > deadline:
            return None
        time.sleep(0.5)


def display_geometry() -> str:
    try:
        sway_socket = next(DISPLAY_DIR.glob("sway-ipc.*.sock"))
        output = subprocess.run(["swaymsg", "-s", str(sway_socket), "-t", "get_outputs", "-r"],
                                capture_output=True, text=True, timeout=5).stdout
        mode = json.loads(output)[0]["current_mode"]
        return f"{int(mode['width'])}x{int(mode['height'])}"
    except (StopIteration, OSError, ValueError, KeyError, IndexError, subprocess.SubprocessError):
        return "1920x1080"


def grant(path: Path, user: str, allow: bool) -> None:
    """Give (or take back) one user's right to connect to the display socket."""
    try:
        if not stat.S_ISSOCK(os.lstat(path).st_mode):
            return
    except OSError:
        return
    argv = ["setfacl", "-m", f"u:{user}:rw", str(path)] if allow else ["setfacl", "-x", f"u:{user}", str(path)]
    subprocess.run(argv, capture_output=True, timeout=10)


def unit_state(unit: str) -> str:
    return subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True).stdout.strip()


def session_running() -> bool:
    return unit_state(SESSION_UNIT) in ("active", "activating", "reloading", "deactivating")


def logged_in_elsewhere(user: str) -> int | None:
    """The other console on which ``user`` has a desktop, if any.

    Two Plasma sessions of one user share one user manager and its units and
    break each other, so a user has at most one console desktop at a time.
    """
    for entry in RUN_ROOT.glob("[1-8]/user"):
        other = int(entry.parent.name)
        try:
            if other != SLOT and entry.read_text().strip() == user and \
                    unit_state(f"qsm-session-{other}.service") in ("active", "activating"):
                return other
        except OSError:
            continue
    return None


class Console:
    """What this console shows now, shared with the control thread."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.greeter: subprocess.Popen | None = None
        self.user: str | None = None


CONSOLE = Console()


def stop_session() -> None:
    subprocess.run(["systemctl", "stop", SESSION_UNIT], capture_output=True, timeout=40)


def control_server() -> None:
    """Answer the host: {"op":"status"} and {"op":"reset"} (root-only socket)."""
    path = RUN_DIR / "control"
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    old = os.umask(0o077)
    try:
        server.bind(str(path))
    finally:
        os.umask(old)
    server.listen(4)
    while True:
        connection, _ = server.accept()
        with connection:
            try:
                connection.settimeout(45)
                request = json.loads(connection.recv(MAX_MESSAGE) or b"{}")
                if request.get("op") == "status":
                    with CONSOLE.lock:
                        user = CONSOLE.user if session_running() else None
                    reply = {"ok": True, "user": user}
                elif request.get("op") == "reset":
                    with CONSOLE.lock:
                        user = CONSOLE.user
                        greeter = CONSOLE.greeter
                    log(f"reset requested by the host (desktop of {user or 'nobody'})")
                    stop_session()
                    if greeter is not None and greeter.poll() is None:
                        greeter.terminate()  # a half-typed login is not handed to the next Console
                    reply = {"ok": True}
                else:
                    reply = {"ok": False}
                connection.send(json.dumps(reply).encode())
            except (OSError, ValueError, subprocess.SubprocessError):
                pass


# ------------------------------------------------------------------ phases
def run_greeter(display: Path) -> tuple[str, str] | None:
    """Show the greeter until one login succeeds; (user, session) or None."""
    greeter = pwd.getpwnam(GREETER_USER)
    shutil.rmtree(GREETER_RUNTIME, ignore_errors=True)
    GREETER_RUNTIME.mkdir(mode=0o700, parents=True)
    os.chown(GREETER_RUNTIME, greeter.pw_uid, greeter.pw_gid)
    users = login_users()
    # No "last user" preselection: consoles of several PVE users share the
    # container, and one must not show which account another just used.
    hello = {"type": "hello", "users": users, "last_user": "",
             "sessions": list(SESSIONS), "default_session": default_session(),
             "user_sessions": {u["name"]: read_state(f"session.{u['name']}") for u in users}}
    ours, theirs = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    grant(display, GREETER_USER, True)
    environment = {
        "PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": str(GREETER_RUNTIME),
        "XDG_RUNTIME_DIR": str(GREETER_RUNTIME), "WAYLAND_DISPLAY": str(display), "QT_QPA_PLATFORM": "wayland",
        "QT_WAYLAND_DISABLE_WINDOWDECORATION": "1", "QSM_LOGIN_FD": str(theirs.fileno()),
        "LANG": os.environ.get("LANG", "C.UTF-8"),
    }
    process = subprocess.Popen(["/usr/bin/python3", GREETER], user=greeter.pw_uid, group=greeter.pw_gid,
                               extra_groups=[], env=environment, pass_fds=(theirs.fileno(),),
                               cwd=str(GREETER_RUNTIME), stdin=subprocess.DEVNULL)
    theirs.close()
    with CONSOLE.lock:
        CONSOLE.greeter = process
    try:
        ours.send(json.dumps(hello).encode())
        ours.settimeout(5)
        while True:
            try:
                raw = ours.recv(MAX_MESSAGE)
            except socket.timeout:
                # Accounts created meanwhile (System Settings, adduser)
                # appear on the login screen without a restart.
                current = login_users()
                if current != users:
                    users = current
                    ours.send(json.dumps({"type": "users", "users": users, "user_sessions": {
                        u["name"]: read_state(f"session.{u['name']}") for u in users}}).encode())
                continue
            except OSError:
                raw = b""
            if not raw:
                return None
            try:
                request = json.loads(raw)
                user, password, session = request["user"], request["password"], request["session"]
                valid = (request.get("type") == "login" and isinstance(user, str) and isinstance(password, str)
                         and isinstance(session, str) and session in SESSIONS and len(password) <= 1024
                         and any(u["name"] == user for u in login_users()))
            except (ValueError, KeyError, TypeError):
                valid = False
            if not valid:
                ours.send(json.dumps({"type": "result", "ok": False,
                                      "message": "Login failed: wrong user name or password."}).encode())
                continue
            problem = pam_check(user, password)
            del password, request
            if problem is None:
                other = logged_in_elsewhere(user)
                if other is not None:
                    problem = (f"{user} is already logged in on another console of this container "
                               f"(console {other}); log out there first.")
            if problem is None:
                ours.send(json.dumps({"type": "result", "ok": True}).encode())
                return user, session
            ours.send(json.dumps({"type": "result", "ok": False, "message": problem}).encode())
    finally:
        with CONSOLE.lock:
            CONSOLE.greeter = None
        ours.close()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        grant(display, GREETER_USER, False)
        shutil.rmtree(GREETER_RUNTIME, ignore_errors=True)


def run_session(user: str, session: str, display: Path) -> None:
    entry = pwd.getpwnam(user)
    # The session's clipboard agent listens here; the host connects into the
    # container to it.  Only this user (and root) can reach it.
    shutil.rmtree(CLIPBOARD_DIR, ignore_errors=True)
    CLIPBOARD_DIR.mkdir(mode=0o700)
    os.chown(CLIPBOARD_DIR, entry.pw_uid, entry.pw_gid)
    environment_file = RUN_DIR / "session.env"
    environment_file.write_text(
        f"QSM_SESSION_TYPE={session}\nXDG_SESSION_TYPE={session}\n"
        f"QSM_DISPLAY_SOCKET={display}\nQSM_DISPLAY_GEOMETRY={display_geometry()}\n"
        f"QSM_CLIPBOARD_SOCKET={CLIPBOARD_DIR / 'agent.sock'}\n")
    (RUN_DIR / "user").write_text(user + "\n")
    write_state(f"session.{user}", session)
    grant(display, user, True)
    with CONSOLE.lock:
        CONSOLE.user = user
    log(f"starting the {session} session of {user}")
    try:
        subprocess.run(["systemctl", "reset-failed", SESSION_UNIT], capture_output=True)
        started = subprocess.run([
            "systemd-run", f"--unit={SESSION_UNIT}", "--collect", "--quiet",
            f"--description=QSM Direct console {SLOT}: desktop session of {user}",
            "-p", f"User={user}", "-p", "PAMName=qsm-direct-session",
            "-p", f"WorkingDirectory={entry.pw_dir}", "-p", f"EnvironmentFile={environment_file}",
            "-p", "Environment=XDG_SEAT=seat0 XDG_SESSION_CLASS=user XDG_SESSION_DESKTOP=KDE",
            "-p", f"BindsTo=qsm-display@{SLOT}.service", "-p", f"After=qsm-display@{SLOT}.service",
            "-p", "TimeoutStopSec=20", LAUNCHER], capture_output=True, text=True)
        if started.returncode != 0:
            log(f"{SESSION_UNIT} failed to start: {started.stderr.strip()}")
            return
        while session_running():
            time.sleep(1)
        log(f"the session of {user} ended")
    finally:
        with CONSOLE.lock:
            CONSOLE.user = None
        grant(display, user, False)
        shutil.rmtree(CLIPBOARD_DIR, ignore_errors=True)
        for name in ("user", "session.env"):
            try:
                (RUN_DIR / name).unlink()
            except OSError:
                pass
        try:
            # Plasma services can outlive the session in the user manager; they
            # must not keep a connection to the display for the next login.
            # Only queue the stop: kded can take 25 s to go, and the login
            # screen must not wait for it (a new session also cleans up).
            subprocess.run(["systemctl", "--user", "-M", f"{user}@", "--no-block", "stop",
                            "plasma-workspace.target", "graphical-session.target", "plasma-*.service"],
                           capture_output=True, timeout=10)
        except subprocess.SubprocessError:
            pass


def main() -> int:
    RUN_ROOT.mkdir(mode=0o755, parents=True, exist_ok=True)
    RUN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(RUN_DIR, 0o700)
    threading.Thread(target=control_server, name="control", daemon=True).start()
    if session_running():
        # This manager was restarted under a running session: keep it.
        try:
            user = (RUN_DIR / "user").read_text().strip()
        except OSError:
            user = None
        with CONSOLE.lock:
            CONSOLE.user = user
        log(f"{SESSION_UNIT} ({user or 'unknown user'}) is running; login screen after it ends")
        while session_running():
            time.sleep(1)
        with CONSOLE.lock:
            CONSOLE.user = None
    while True:
        display = display_socket()
        result = run_greeter(display)
        if result is None:
            time.sleep(1)
            continue
        run_session(*result, display)
        time.sleep(0.5)


if __name__ == "__main__":
    sys.exit(main())
