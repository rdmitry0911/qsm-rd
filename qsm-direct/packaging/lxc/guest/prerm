#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -e
if [ "${1:-}" = remove ] && [ -d /run/systemd/system ]; then
    systemctl disable --now qsm-consoles.service || true
    systemctl stop 'qsm-session-*.service' 'qsm-login@*.service' 'qsm-seat-keeper@*.service' \
        'qsm-display@*.service' || true
fi
exit 0
