[Unit]
Before=qsm-native-sddm.service
Description=Native QSM console %i ownership and reset API
After=systemd-logind.service qsm-display@%i.service
BindsTo=qsm-display@%i.service
PartOf=qsm-consoles.service
ConditionPathExists=/etc/qsm-direct/native-seats.json

[Service]
Type=simple
ExecStart=/usr/lib/qsm-console/qsm-native-seat control %i
Restart=on-failure
RestartSec=1
UMask=0077

[Install]
WantedBy=multi-user.target
