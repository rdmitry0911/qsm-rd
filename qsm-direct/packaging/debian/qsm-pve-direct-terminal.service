[Unit]
Description=QSM direct PVE browser console terminal
Documentation=file:/usr/share/doc/qsm-pve-direct/README.Debian
After=pve-cluster.service pveproxy.service pvedaemon.service
Before=pve-guests.service

[Service]
Type=simple
RuntimeDirectory=qsm-pve-direct-terminal
RuntimeDirectoryMode=0750
Environment=QSM_DIRECT_LOCAL_NODE=%H
UMask=0077
ExecStart=/usr/bin/qsm-pve-direct-terminal
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=45s
# QEMU opens its Display1 D-Bus once at VM startup and cannot reconnect if a
# terminal package upgrade restarts this service. SIGINT lets Python close
# media workers cleanly; only the primary terminal process is stopped while
# its root-only per-VM D-Bus daemons remain available to running VMs.
KillSignal=SIGINT
KillMode=process
TasksMax=192
MemoryMax=1024M
LimitNOFILE=1024
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
# The terminal service owns the local Unix control plane, while its WebRTC
# child needs UDP sockets for ICE, DTLS, and SRTP. aiortc also opens Netlink
# solely to enumerate local interfaces before it emits host ICE candidates.
# No TCP listener is opened.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
