#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Enable the QSM Direct graphical console for a Proxmox VE LXC container.

  qsm-pve-direct-lxc enable  VMID [--user NAME] [--uid N] [--session wayland|x11]
                                  [--nvidia-run FILE] [--no-gpu] [--no-admin]
                                  [--grace SECONDS] [--restart]
  qsm-pve-direct-lxc session VMID wayland|x11     (default session of the login screen)
  qsm-pve-direct-lxc status  VMID
  qsm-pve-direct-lxc disable VMID

A container has no QEMU display.  QSM runs the container's desktop session
(KDE Plasma, Wayland or X11) inside a headless sway ("the display") in the
container, and the host's media worker captures that display.  `enable`
prepares a running Debian/Ubuntu container for this, idempotently:

  1. GPU access: NVIDIA device nodes and DRM render nodes are passed through
     (container restart required to apply; --restart does it).
  2. NVIDIA userspace matching the host kernel module (from the host driver's
     .run installer, --no-kernel-module) so the desktop renders on the GPU.
  3. The container package qsm-console-guest (apt pulls in sway, xwayland,
     PyQt5, acl, the Plasma Wayland session bits).
  4. The consoles as system services -- one per tty the container runs
     with (read at every start, so a changed tty option needs no re-run),
     like PVE's terminal console: per console a headless sway, a seat keeper
     and a login manager (login screen -> PAM -> a real logind session; Log
     Out returns to the login screen).  Every PVE Console gets its own
     console; a closed one's desktop waits --grace seconds for the same PVE
     user, then is logged out.  A desktop user is created if missing (an
     administrator -- sudo group -- unless --no-admin); set its password.
  5. The host policy /etc/qsm-pve-direct/containers.d/VMID.conf that enables
     the "QSM Direct" entry of the container's Console button.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from pathlib import Path

POLICY_DIR = Path("/etc/qsm-pve-direct/containers.d")
SLOT_STATE = Path("/run/qsm-pve-direct-terminal/sessions/lxc-slots.json")
LXC_CONF_DIR = Path("/etc/pve/lxc")
GUEST_PACKAGE = Path("/usr/share/qsm-pve-direct-lxc/qsm-console-guest.deb")
GPU_MARKER = "# qsm-direct-gpu-passthrough"
NVIDIA_NODES = ("nvidia0", "nvidiactl", "nvidia-modeset", "nvidia-uvm", "nvidia-uvm-tools")


class SetupError(Exception):
    pass


def info(message: str) -> None:
    print(f"qsm-pve-direct-lxc: {message}", flush=True)


def run(argv: list[str], *, check: bool = True, capture: bool = True, input_text: str | None = None,
        timeout: int = 900) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(argv, text=True, capture_output=capture, input=input_text, timeout=timeout)
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip().splitlines()[-3:]
        raise SetupError(f"command failed ({result.returncode}): {' '.join(argv[:6])}...\n  " + "\n  ".join(detail))
    return result


def ct(vmid: int, command: str, *, check: bool = True, timeout: int = 900) -> subprocess.CompletedProcess[str]:
    return run(["pct", "exec", str(vmid), "--", "/bin/sh", "-c", command], check=check, timeout=timeout)


def push(vmid: int, content: str | bytes | Path, destination: str, *, mode: str = "0644",
         owner: str | None = None) -> None:
    if isinstance(content, Path):
        source = str(content)
        cleanup = None
    else:
        handle = tempfile.NamedTemporaryFile("wb", delete=False)
        handle.write(content.encode() if isinstance(content, str) else content)
        handle.close()
        source = cleanup = handle.name
    try:
        ct(vmid, f"mkdir -p {shlex.quote(os.path.dirname(destination))}")
        argv = ["pct", "push", str(vmid), source, destination, "--perms", mode]
        if owner:
            uid, gid = owner.split(":")
            argv += ["--user", uid, "--group", gid]
        run(argv)
    finally:
        if cleanup:
            os.unlink(cleanup)


def ct_status(vmid: int) -> str:
    result = run(["pct", "status", str(vmid)], check=False)
    return result.stdout.strip().split()[-1] if result.returncode == 0 and result.stdout.strip() else "unknown"


def require_container(vmid: int, *, running: bool = True) -> Path:
    conf = LXC_CONF_DIR / f"{vmid}.conf"
    if not conf.is_file():
        raise SetupError(f"CT {vmid} does not exist on this node ({conf} missing)")
    if running and ct_status(vmid) != "running":
        raise SetupError(f"CT {vmid} is not running; start it first (pct start {vmid})")
    return conf


# ------------------------------------------------------------------ GPU access
def configure_gpu(vmid: int, conf: Path) -> bool:
    """Add NVIDIA/DRM passthrough to the container config.  True if changed."""
    text = conf.read_text()
    lines: list[str] = []
    nvidia_present = GPU_MARKER in text or "lxc.mount.entry: /dev/nvidia0 " in text
    if os.path.exists("/dev/nvidia0") and not nvidia_present:
        majors = sorted({os.major(os.stat(f"/dev/{n}").st_rdev) for n in NVIDIA_NODES if os.path.exists(f"/dev/{n}")} |
                        ({os.major(os.stat(p).st_rdev) for p in glob.glob("/dev/nvidia-caps/*")}))
        lines.append(GPU_MARKER)
        lines += [f"lxc.cgroup2.devices.allow: c {m}:* rwm" for m in majors]
        lines += [f"lxc.mount.entry: /dev/{n} dev/{n} none bind,optional,create=file"
                  for n in NVIDIA_NODES if os.path.exists(f"/dev/{n}")]
        if os.path.isdir("/dev/nvidia-caps"):
            lines.append("lxc.mount.entry: /dev/nvidia-caps dev/nvidia-caps none bind,optional,create=dir")
    render = sorted(glob.glob("/dev/dri/renderD*"))
    card = sorted(glob.glob("/dev/dri/card*"))
    wanted = [p for p in (card[:1] + render[:1])]
    used = {int(m.group(1)) for m in re.finditer(r"^dev(\d+):", text, re.M)}
    present = set(re.findall(r"^dev\d+:\s*([^,\s]+)", text, re.M))
    if wanted and any(p not in present for p in wanted):
        groups = {}
        result = ct(vmid, "getent group video render", check=False)
        for row in result.stdout.splitlines():
            name, _x, gid, *_rest = row.split(":")
            groups[name] = gid
        index = 0
        for path in wanted:
            if path in present:
                continue
            while index in used:
                index += 1
            gid = groups.get("render" if "renderD" in path else "video")
            lines.append(f"dev{index}: {path}" + (f",gid={gid}" if gid else "") + ",mode=0660")
            used.add(index)
    if not lines:
        return False
    with conf.open("a") as handle:
        handle.write("\n".join(lines) + "\n")
    info(f"GPU passthrough added to {conf}")
    return True


def host_nvidia_version() -> str | None:
    try:
        text = Path("/proc/driver/nvidia/version").read_text()
    except OSError:
        return None
    match = re.search(r"Kernel Module\s+(?:for\s+\S+\s+)?([0-9]+\.[0-9]+(?:\.[0-9]+)?)", text)
    return match.group(1) if match else None


def install_nvidia_userspace(vmid: int, run_file: str | None) -> None:
    version = host_nvidia_version()
    if version is None:
        return
    current = ct(vmid, "nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null", check=False)
    if current.returncode == 0 and current.stdout.strip() == version:
        info(f"NVIDIA userspace {version} already present in CT {vmid}")
        return
    candidates = [run_file] if run_file else sorted(
        glob.glob(f"/root/NVIDIA-Linux-x86_64-{version}.run") + glob.glob(f"/root/*/NVIDIA-Linux-x86_64-{version}.run") +
        glob.glob(f"/opt/NVIDIA-Linux-x86_64-{version}.run") + glob.glob(f"/usr/local/src/NVIDIA-Linux-x86_64-{version}.run"))
    candidates = [c for c in candidates if c and os.path.isfile(c)]
    if not candidates:
        info(f"WARNING: no NVIDIA-Linux-x86_64-{version}.run found (use --nvidia-run); "
             "the desktop will render in software until the matching userspace is installed")
        return
    info(f"installing NVIDIA userspace {version} into CT {vmid} (no kernel module)")
    run(["pct", "push", str(vmid), candidates[0], "/root/qsm-nvidia.run", "--perms", "0755"])
    ct(vmid, "sh /root/qsm-nvidia.run --no-kernel-module --silent --no-questions --ui=none "
             "--no-x-check --no-nouveau-check; rc=$?; rm -f /root/qsm-nvidia.run; exit $rc", timeout=1800)


# ------------------------------------------------------------------ packages
def require_plasma(vmid: int) -> None:
    if ct(vmid, "command -v apt-get", check=False).returncode != 0:
        raise SetupError("the container is not Debian/Ubuntu (no apt-get); the console package needs apt")
    if ct(vmid, "command -v startplasma-wayland || command -v startplasma-x11", check=False).returncode != 0:
        raise SetupError("no KDE Plasma session found in the container; install a Plasma desktop first "
                         "(e.g. apt install kde-plasma-desktop)")


# ------------------------------------------------------------------ console files
# The container side is the package qsm-console-guest (shipped here, installed
# with apt, which also pulls in sway, PyQt5, ...): like the ttys of PVE's
# terminal console, one console per tty the container runs with --
#   qsm-consoles.service      at boot: one console per /dev/ttyN
#   qsm-display@N.service     headless sway (user qsm-display), /run/qsm-display-N
#   qsm-seat-keeper@N.service keeps the display seat's input devices stable
#   qsm-login@N.service       login manager: greeter, PAM check, the session
#   qsm-session-N.service     (transient) the desktop session: a real PAM/logind
#                             session on seat0 (polkit, user manager, limits)
MAX_SLOTS = 8
LEGACY_USER_UNITS = ("qsm-display.service", "qsm-seat-keeper.service", "qsm-session.service")
LEGACY_SYSTEM_UNITS = ("qsm-login.service", "qsm-seat-keeper.service", "qsm-display.service",
                       "qsm-desktop-session.service", "qsm-user-session@.service")
# Written by earlier versions of this tool; in /etc they would shadow the
# package's own units and configuration.
LEGACY_FILES = ("/etc/systemd/system/qsm-display@.service", "/etc/systemd/system/qsm-seat-keeper@.service",
                "/etc/systemd/system/qsm-login@.service", "/etc/systemd/system/qsm-consoles.service",
                "/etc/systemd/system/qsm-console.target",
                "/etc/systemd/user/plasma-kwin_wayland.service.d/qsm-nested.conf",
                "/etc/qsm-direct/sway.conf", "/etc/pam.d/qsm-login", "/etc/pam.d/qsm-direct-session")


def slot_units(slots: range) -> list[str]:
    return [f"{name}@{number}.service" for number in slots
            for name in ("qsm-display", "qsm-seat-keeper", "qsm-login")]


def running_consoles(vmid: int) -> int:
    """The consoles a running container has: its ttys as it runs now.

    PVE writes /var/lib/lxc/<vmid>/config at every start; the container side
    (qsm-consoles) and the terminal service use the same count.
    """
    try:
        match = re.search(r"^lxc\.tty\.max\s*=\s*(\d+)\s*$",
                          Path(f"/var/lib/lxc/{vmid}/config").read_text(), re.M)
    except OSError:
        match = None
    return max(1, min(MAX_SLOTS, int(match.group(1)))) if match else 1


def ensure_user(vmid: int, user: str, uid: int, admin: bool = True) -> None:
    exists = ct(vmid, f"id -u {shlex.quote(user)}", check=False)
    if exists.returncode == 0:
        if int(exists.stdout.strip()) != uid:
            raise SetupError(f"user {user} exists in CT {vmid} with uid {exists.stdout.strip()}, not {uid} (use --uid)")
    else:
        info(f"creating desktop user {user} (uid {uid}) in CT {vmid}")
        ct(vmid, f"useradd -m -u {uid} -s /bin/bash {shlex.quote(user)}")
    groups = "video render audio" + (" sudo" if admin else "")
    ct(vmid, f"for g in {groups}; do getent group $g >/dev/null && usermod -aG $g {shlex.quote(user)}; done")


def remove_legacy_session(vmid: int, uid: int) -> None:
    """Retire what earlier versions set up (per-user display, tool-written units)."""
    user = ct(vmid, f"getent passwd {uid} | cut -d: -f1", check=False).stdout.strip()
    if user:
        home = ct(vmid, f"getent passwd {uid} | cut -d: -f6", check=False).stdout.strip()
        if ct(vmid, f"test -e {shlex.quote(home)}/.config/systemd/user/qsm-display.service", check=False).returncode == 0:
            info(f"retiring the per-user display of {user}")
            user_systemctl(vmid, user, "disable", "--now", *LEGACY_USER_UNITS, check=False)
            units = f"{shlex.quote(home)}/.config/systemd/user"
            ct(vmid, f"rm -f {units}/qsm-display.service {units}/qsm-seat-keeper.service {units}/qsm-session.service "
                     f"{units}/plasma-kwin_wayland.service.d/qsm-nested.conf; "
                     f"rmdir {units}/plasma-kwin_wayland.service.d 2>/dev/null; "
                     f"loginctl disable-linger {shlex.quote(user)}", check=False)
    legacy = " ".join(LEGACY_SYSTEM_UNITS)
    ct(vmid, f"for u in {legacy}; do if [ -e /etc/systemd/system/$u ]; then systemctl disable --now $u 2>/dev/null; "
             "rm -f /etc/systemd/system/$u; fi; done; systemctl stop 'qsm-user-session@*.service' 2>/dev/null; "
             "systemctl disable qsm-console.target " + " ".join(slot_units(range(1, MAX_SLOTS + 1))) + " 2>/dev/null; "
             "if [ -e /etc/systemd/system/qsm-login@.service ]; then "
             "systemctl stop 'qsm-session-*.service' 'qsm-login@*.service' 'qsm-seat-keeper@*.service' "
             "'qsm-display@*.service' 2>/dev/null; fi; "
             "rm -f " + " ".join(LEGACY_FILES) + "; rm -rf /usr/local/lib/qsm-direct; "
             "rmdir /etc/systemd/user/plasma-kwin_wayland.service.d 2>/dev/null; systemctl daemon-reload", check=False)


def install_guest_package(vmid: int, session: str) -> None:
    if not GUEST_PACKAGE.is_file():
        raise SetupError(f"{GUEST_PACKAGE} is missing (is qsm-pve-direct-lxc installed?)")
    info(f"installing the container console package into CT {vmid}")
    run(["pct", "push", str(vmid), str(GUEST_PACKAGE), "/root/qsm-console-guest.deb", "--perms", "0644"])
    ct(vmid, "export DEBIAN_FRONTEND=noninteractive; apt-get update -qq && "
             "apt-get install -y -qq --no-install-recommends -o Dpkg::Use-Pty=0 "
             "/root/qsm-console-guest.deb kwin-wayland plasma-workspace-wayland; "
             "rc=$?; rm -f /root/qsm-console-guest.deb; exit $rc", timeout=1800)
    push(vmid, session + "\n", "/etc/qsm-direct/session-type")
    # start the consoles this container has (idempotent; running ones stay)
    ct(vmid, "systemctl start qsm-consoles.service; /usr/lib/qsm-console/qsm-consoles", check=False)


def user_systemctl(vmid: int, user: str, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return ct(vmid, "systemctl --user -M " + shlex.quote(f"{user}@") + " " + " ".join(shlex.quote(a) for a in args),
              check=check)


def write_policy(vmid: int, uid: int, grace: int) -> None:
    POLICY_DIR.mkdir(mode=0o750, parents=True, exist_ok=True)
    path = POLICY_DIR / f"{vmid}.conf"
    kept = [line for line in (path.read_text().splitlines() if path.exists() else [])
            if line.startswith(("QSM_DIRECT_CODEC=", "QSM_DIRECT_ENCODER_MODE=", "QSM_DIRECT_ENCODER="))]
    body = (f"# QSM Direct console for LXC {vmid} (managed by qsm-pve-direct-lxc)\n"
            f"QSM_DIRECT_LXC_UID={uid}\nQSM_DIRECT_LXC_DISPLAY=slots\nQSM_DIRECT_LXC_GRACE={grace}\n")
    body += "".join(f"{line}\n" for line in kept)
    fd = os.open(path.with_suffix(".tmp"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(body)
    os.replace(path.with_suffix(".tmp"), path)


def password_is_set(vmid: int, user: str) -> bool:
    fields = ct(vmid, f"passwd -S {shlex.quote(user)}", check=False).stdout.split()
    return len(fields) > 1 and fields[1] == "P"


# ------------------------------------------------------------------ commands
def cmd_enable(args: argparse.Namespace) -> int:
    conf = require_container(args.vmid)
    if not GUEST_PACKAGE.is_file():
        raise SetupError(f"{GUEST_PACKAGE} is missing (is qsm-pve-direct-lxc installed?)")
    changed = False if args.no_gpu else configure_gpu(args.vmid, conf)
    if changed:
        if args.restart:
            info(f"restarting CT {args.vmid} to apply GPU access")
            run(["pct", "reboot", str(args.vmid)], timeout=300)
            for _ in range(60):
                if ct_status(args.vmid) == "running" and ct(args.vmid, "true", check=False).returncode == 0:
                    break
                time.sleep(2)
        else:
            info(f"GPU access applies after a container restart (pct reboot {args.vmid}) -- continuing")
    if not args.no_gpu:
        install_nvidia_userspace(args.vmid, args.nvidia_run)
    require_plasma(args.vmid)
    ensure_user(args.vmid, args.user, args.uid, admin=not args.no_admin)
    remove_legacy_session(args.vmid, args.uid)
    slots = running_consoles(args.vmid)
    install_guest_package(args.vmid, args.session)
    write_policy(args.vmid, args.uid, args.grace)
    for _ in range(30):
        if ct(args.vmid, f"ls /run/qsm-display-{slots}/ 2>/dev/null | grep -Eq '^wayland-[0-9]+$'",
              check=False).returncode == 0:
            break
        time.sleep(1)
    info(f"enabled: CT {args.vmid} -> Console -> \"QSM Direct\": one console per tty (now {slots}; a changed "
         f"tty option applies at the container's next start), each with its own login screen (default session {args.session}; a closed console's desktop "
         f"waits {args.grace} s for its PVE user, then logs out)")
    if not password_is_set(args.vmid, args.user):
        info(f"{args.user} has no password and cannot log in yet -- set one with: pct exec {args.vmid} -- passwd {args.user}")
    return cmd_status(args)


def cmd_session(args: argparse.Namespace) -> int:
    require_container(args.vmid)
    push(args.vmid, args.type + "\n", "/etc/qsm-direct/session-type")
    info(f"CT {args.vmid}: the login screen now offers {args.type} by default "
         "(a user's last choice on the login screen still wins; it applies at the next login)")
    return 0


def policy_uid(vmid: int) -> int:
    path = POLICY_DIR / f"{vmid}.conf"
    if not path.exists():
        raise SetupError(f"CT {vmid} is not enabled for the QSM console")
    match = re.search(r"^QSM_DIRECT_LXC_UID=(\d+)", path.read_text(), re.M)
    return int(match.group(1)) if match else 1000


def cmd_status(args: argparse.Namespace) -> int:
    require_container(args.vmid, running=False)
    path = POLICY_DIR / f"{args.vmid}.conf"
    enabled = path.exists()
    print(f"CT {args.vmid}: console policy {'present' if enabled else 'absent'}; container {ct_status(args.vmid)}")
    if enabled and ct_status(args.vmid) == "running":
        slots = running_consoles(args.vmid)
        owners = {}
        init_pid = run(["lxc-info", "-n", str(args.vmid), "-p", "-H"], check=False).stdout.strip()
        try:
            for entry in json.loads(SLOT_STATE.read_text()):
                # Records of the container's previous run mean nothing now.
                if entry.get("vmid") == args.vmid and \
                        str(entry.get("generation", "")).split(":")[0] == init_pid:
                    owners[entry.get("slot")] = (entry.get("owner"), entry.get("detached_wall"))
        except (OSError, ValueError):
            pass
        for number in range(1, slots + 1):
            states = [ct(args.vmid, f"systemctl is-active {unit}", check=False).stdout.strip()
                      for unit in (f"qsm-display@{number}.service", f"qsm-login@{number}.service")]
            user = ct(args.vmid, f"systemctl is-active --quiet qsm-session-{number}.service && "
                                 f"cat /run/qsm-login/{number}/user", check=False).stdout.strip()
            owner, left = owners.get(number, (None, None))
            pve = "free" if owner is None else (f"PVE {owner}, connected" if left is None else
                                                f"PVE {owner}, closed {int(time.time() - left)} s ago")
            print(f"  console {number}: display {states[0]}, login {states[1]}; "
                  f"{('desktop of ' + user) if user else 'login screen'}; {pve}")
        default = ct(args.vmid, "cat /etc/qsm-direct/session-type 2>/dev/null", check=False).stdout.strip()
        gpu = ct(args.vmid, "nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || true", check=False).stdout.strip()
        print(f"  {'default session type':22s} {default or 'wayland'}")
        print(f"  {'GPU in container':22s} {gpu or 'none/software'}")
    return 0


def cmd_disable(args: argparse.Namespace) -> int:
    require_container(args.vmid, running=False)
    path = POLICY_DIR / f"{args.vmid}.conf"
    if path.exists():
        path.unlink()
        info(f"CT {args.vmid}: console policy removed (the Console button no longer offers QSM Direct)")
    if ct_status(args.vmid) == "running":
        ct(args.vmid, "systemctl disable --now qsm-consoles.service; systemctl stop 'qsm-session-*.service' "
                      + " ".join(slot_units(range(1, MAX_SLOTS + 1))), check=False)
        info(f"CT {args.vmid}: console display, login screen and sessions stopped "
             "(files and GPU passthrough left in place)")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)
    enable = sub.add_parser("enable", help="prepare a container and enable its QSM console")
    enable.add_argument("vmid", type=int)
    enable.add_argument("--user", default="qsm", help="desktop user to create if missing (default qsm)")
    enable.add_argument("--uid", type=int, default=1000)
    enable.add_argument("--session", choices=("wayland", "x11"), default="wayland",
                        help="session type the login screen offers by default")
    enable.add_argument("--nvidia-run", help="NVIDIA .run installer matching the host driver")
    enable.add_argument("--no-gpu", action="store_true", help="do not pass through the GPU")
    enable.add_argument("--no-admin", action="store_true",
                        help="do not add the desktop user to the sudo (polkit administrator) group")
    enable.add_argument("--grace", type=int, default=300,
                        help="seconds a closed console's desktop waits for its PVE user before logout (default 300)")
    enable.add_argument("--restart", action="store_true", help="restart the container if GPU access changed")
    enable.set_defaults(func=cmd_enable)
    session = sub.add_parser("session", help="set the login screen's default session type")
    session.add_argument("vmid", type=int)
    session.add_argument("type", choices=("wayland", "x11"))
    session.set_defaults(func=cmd_session)
    for name, func in (("status", cmd_status), ("disable", cmd_disable)):
        p = sub.add_parser(name)
        p.add_argument("vmid", type=int)
        p.set_defaults(func=func)
    args = parser.parse_args(argv)
    if os.geteuid() != 0:
        print("qsm-pve-direct-lxc: must run as root on the Proxmox VE node", file=sys.stderr)
        return 2
    if not (0 <= getattr(args, "grace", 0) <= 86400):
        print("qsm-pve-direct-lxc: --grace out of range (0..86400)", file=sys.stderr)
        return 2
    if not (1 <= getattr(args, "uid", 1000) <= 65533):
        print("qsm-pve-direct-lxc: --uid out of range", file=sys.stderr)
        return 2
    try:
        return args.func(args)
    except SetupError as error:
        print(f"qsm-pve-direct-lxc: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
