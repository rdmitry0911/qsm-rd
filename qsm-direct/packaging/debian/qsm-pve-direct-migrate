#!/usr/bin/python3
"""Plan or apply a stopped VM's migration to the shared PVE display bus."""
import argparse
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/qsm-pve-direct")
from direct_terminal.qsm_shared_migration import migration_plan
from direct_terminal.qsm_direct_terminal import DirectTerminalError


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("vmid", type=int)
    parser.add_argument("--apply", action="store_true", help="apply the plan; VM must be stopped")
    args = parser.parse_args()
    if os.geteuid() != 0 or not 100 <= args.vmid <= 999999999:
        parser.error("run as root with a valid VMID")
    raw = subprocess.check_output(["qm", "config", str(args.vmid), "--current", "1"], text=True)
    values = migration_plan(raw, args.vmid)
    # Administrator args can contain credentials. Retain them without printing.
    preview = {**values}
    if "args" in preview:
        preview["args"] = "remaining administrator/guest-channel arguments preserved"
    print(json.dumps({"vmid": args.vmid, "changes": preview}, indent=2))
    if not args.apply:
        return
    status = subprocess.check_output(["qm", "status", str(args.vmid)], text=True).strip()
    if status != "status: stopped":
        raise DirectTerminalError("stop the VM before applying the migration")
    # Test the feature on this node before any config write.
    subprocess.run(["pvesh", "usage", f"/nodes/{socket.gethostname()}/qemu/{args.vmid}/webrtcproxy"],
                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    backup_dir = Path("/var/lib/qsm-pve-direct/migration")
    backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    source = Path(f"/etc/pve/qemu-server/{args.vmid}.conf")
    backup = backup_dir / f"{args.vmid}-{time.time_ns()}.conf"
    fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write(source.read_bytes())
    command = ["qm", "set", str(args.vmid)]
    for key, value in values.items():
        command.extend(["--" + key, str(value)])
    subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "restart", "qsm-pve-direct-terminal.service"], check=True)
    print(f"Migration saved; start VM {args.vmid}. Backup: {backup}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, DirectTerminalError, subprocess.CalledProcessError) as error:
        message = ("system command failed; check installed native PVE support and VM configuration"
                   if isinstance(error, subprocess.CalledProcessError) else str(error))
        print(f"Migration failed: {message}", file=sys.stderr)
        sys.exit(1)
