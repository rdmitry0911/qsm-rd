#!/bin/sh
set -eu

case "${1:-}" in
    remove|deconfigure|purge)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl disable --now qsm-pve-direct-cert-reload.timer >/dev/null 2>&1 || true
            systemctl disable --now qsm-pve-direct-signal.service >/dev/null 2>&1 || true
        fi
        # The PVE page is re-rendered by pve-ui-overlays once dpkg removed the
        # overlay descriptor (file trigger); nothing to undo here.
        ;;
esac
