#!/bin/sh
set -e

restart_services() {
    if ! command -v systemctl >/dev/null 2>&1 || [ ! -d /run/systemd/system ]; then return 0; fi
    systemctl daemon-reload || return 0
    # An upgrade can change Display1 bus lifecycle or signalling code. Restart
    # only an already active service so its long-lived process picks up the new
    # code; first installation still leaves activation to the documented
    # command. pveproxy and pvedaemon are never touched: this package adds no
    # code to them.
    systemctl try-restart qsm-pve-direct-terminal.service || true
    systemctl try-restart qsm-pve-direct-signal.service || true
}

case "${1:-}" in
    configure)
        install -d -o root -g root -m 0700 /etc/qsm-pve-direct
        install -d -o root -g root -m 0750 /etc/qsm-pve-direct/instances.d
        install -d -o root -g root -m 0750 /etc/qsm-pve-direct/containers.d
        install -d -o root -g root -m 0700 /run/qsm-pve-direct
        # Migrate from the retired API-route design: remove its pveproxy and
        # pvedaemon drop-ins and revert those daemons to stock if present.
        migrated=0
        for drop_in in /usr/lib/systemd/system/pveproxy.service.d/qsm-pve-direct-api.conf \
                       /usr/lib/systemd/system/pvedaemon.service.d/qsm-pve-direct-api.conf; do
            if [ -e "$drop_in" ]; then rm -f -- "$drop_in"; migrated=1; fi
        done
        if [ "$migrated" = 1 ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl try-restart pvedaemon.service || true
            systemctl try-restart pveproxy.service || true
        fi
        restart_services
        # Track the certificate the signalling service serves so a later ACME
        # renewal restarts it to pick up the new file (it loads the cert only at
        # start).  Seed the fingerprint now (the service was just restarted
        # against this file) and enable the periodic check.
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            /usr/lib/qsm-pve-direct/bin/qsm-direct-cert-reload || true
            systemctl enable --now qsm-pve-direct-cert-reload.timer || true
        fi
        # The page injector this package used to ship is retired (pve-ui-overlays
        # renders the page now). dpkg removes only the files it shipped, so drop
        # what that helper created at run time: its bytecode cache and state.
        rm -rf /usr/lib/qsm-pve-direct/pve9-ui/__pycache__
        rmdir /usr/lib/qsm-pve-direct/pve9-ui 2>/dev/null || true
        rm -f /var/lib/qsm-pve-direct/pve9-ui/state.json
        rmdir /var/lib/qsm-pve-direct/pve9-ui 2>/dev/null || true
        # The overlay descriptor is rendered by pve-ui-overlays (its dpkg trigger
        # does this too); calling it here makes the Console entry immediate.
        /usr/sbin/pve-ui-overlays reconcile || echo "qsm-pve-direct: PVE Console UI was not changed" >&2
        echo "qsm-pve-direct installed; enable qsm-pve-direct-terminal.service for the native Proxmox WebRTC API. qsm-pve-direct-signal.service is needed only for legacy installations."
        ;;
esac
