#!/bin/sh
set -e
if [ "${1:-}" = configure ]; then
    qsm-pve-direct-endpoint --initialize
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        deb-systemd-helper enable qsm-pve-direct-terminal.service qsm-pve-direct-signal.service
        deb-systemd-invoke restart qsm-pve-direct-terminal.service qsm-pve-direct-signal.service
    fi
fi
#DEBHELPER#
