#cloud-config
hostname: qsm-pve9-lab
manage_etc_hosts: false
ssh_pwauth: false
disable_root: false
users:
  - name: root
    lock_passwd: true
    ssh_authorized_keys:
      - @QSM_DIRECT_LAB_SSH_PUBLIC_KEY@
write_files:
  - path: /etc/apt/sources.list.d/proxmox.sources
    permissions: '0644'
    content: |
      Types: deb
      URIs: http://download.proxmox.com/debian/pve
      Suites: trixie
      Components: pve-no-subscription
      Signed-By: /usr/share/keyrings/proxmox-release-trixie.gpg
  - path: /etc/systemd/system/qsm-lab-ready.service
    permissions: '0644'
    content: |
      [Unit]
      Description=QSM Direct Proxmox lab readiness marker
      After=pveproxy.service pvedaemon.service
      Wants=pveproxy.service pvedaemon.service

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/touch /var/lib/qsm-lab-ready

      [Install]
      WantedBy=multi-user.target
  - path: /usr/local/sbin/qsm-pve-lab-network
    permissions: '0700'
    content: |
      #!/bin/sh
      set -eu
      lab_ip="$(ip -4 -o addr show scope global | awk 'NR==1 {split($4, a, "/"); print a[1]}')"
      test -n "$lab_ip"
      # PVE requires its nodename to resolve first to a non-loopback IPv4
      # address. Keep the lab deterministic and exclude DHCP link-local IPv6
      # addresses, which OpenSSL cannot encode as a PVE certificate SAN.
      printf '%s\t%s\n127.0.0.1\tlocalhost\n::1\tlocalhost ip6-localhost ip6-loopback\n' \
        "$lab_ip" qsm-pve9-lab > /etc/hosts
      printf '%s\n' \
        'net.ipv6.conf.all.disable_ipv6 = 1' \
        'net.ipv6.conf.default.disable_ipv6 = 1' \
        'net.ipv6.conf.eth0.disable_ipv6 = 1' > /etc/sysctl.d/90-qsm-pve-lab-ipv6.conf
      sysctl --system >/dev/null
runcmd:
  - [ mkdir, -p, /usr/share/keyrings ]
  - [ curl, --fail, --location, --proto, '=https', --tlsv1.2, https://enterprise.proxmox.com/debian/proxmox-release-trixie.gpg, -o, /usr/share/keyrings/proxmox-release-trixie.gpg ]
  - [ apt-get, update ]
  - [ /usr/bin/env, DEBIAN_FRONTEND=noninteractive, apt-get, install, -y, --no-install-recommends, proxmox-ve, qemu-server, pve-manager, pve-container, ifupdown2, openssh-server, ca-certificates, curl, jq, socat, psmisc, libegl1, libgl1, libvirglrenderer1 ]
  - [ /usr/local/sbin/qsm-pve-lab-network ]
  # A freshly installed PVE 9 source file does not contain an Enabled field.
  # Remove a possible inherited setting and insert an explicit opt-out, so the
  # lab never tries the subscription-only repository on a later apt operation.
  - [ /bin/sh, -ec, 'if [ -f /etc/apt/sources.list.d/pve-enterprise.sources ]; then sed -i -E "/^Enabled:[[:space:]]*/d" /etc/apt/sources.list.d/pve-enterprise.sources; sed -i "1iEnabled: no" /etc/apt/sources.list.d/pve-enterprise.sources; fi' ]
  - [ pvecm, updatecerts, --force ]
  - [ systemctl, enable, --now, pve-cluster.service, pvedaemon.service, pveproxy.service, pvestatd.service ]
  - [ systemctl, enable, qsm-lab-ready.service ]
  - [ systemctl, start, qsm-lab-ready.service ]
final_message: 'QSM Direct Proxmox VE 9 lab cloud-init complete after $UPTIME seconds'
