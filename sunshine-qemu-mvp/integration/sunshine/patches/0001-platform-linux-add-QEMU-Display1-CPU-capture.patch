From 6cc26c6b782a5db9e5706dbbfa7875deb73e40d5 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 1 Sep 2026 08:35:20 +0000
Subject: [PATCH] platform/linux: add QEMU Display1 CPU capture

---
 cmake/compile_definitions/linux.cmake |  18 +-
 cmake/prep/options.cmake              |   2 +
 src/platform/linux/misc.cpp           |  28 +
 src/platform/linux/qemu_dbus.cpp      | 754 ++++++++++++++++++++++++++
 src/platform/linux/qemu_dbus.h        |  29 +
 5 files changed, 829 insertions(+), 2 deletions(-)
 create mode 100644 src/platform/linux/qemu_dbus.cpp
 create mode 100644 src/platform/linux/qemu_dbus.h

diff --git a/cmake/compile_definitions/linux.cmake b/cmake/compile_definitions/linux.cmake
index 485e419..3ff36c4 100644
--- a/cmake/compile_definitions/linux.cmake
+++ b/cmake/compile_definitions/linux.cmake
@@ -251,6 +251,19 @@ if(GIO_FOUND)
     list(APPEND PLATFORM_LIBRARIES ${GIO_LIBRARIES})
 endif()
 
+# QEMU Display1 D-Bus CPU capture.  GIO is already a baseline Linux
+# dependency for Sunshine, so this backend introduces no additional client
+# library.  It intentionally supports system-memory capture first; DMA-BUF is
+# a later optimization once the stock software path is qualified.
+set(QEMU_DBUS_FOUND OFF)
+if(${SUNSHINE_ENABLE_QEMU_DBUS})
+    set(QEMU_DBUS_FOUND ON)
+    add_compile_definitions(SUNSHINE_BUILD_QEMU_DBUS)
+    list(APPEND PLATFORM_TARGET_FILES
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/qemu_dbus.h"
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/qemu_dbus.cpp")
+endif()
+
 # Pipewire
 if(${SUNSHINE_ENABLE_KWIN} OR ${SUNSHINE_ENABLE_PORTAL})
     pkg_check_modules(PIPEWIRE libpipewire-0.3 REQUIRED)
@@ -292,8 +305,9 @@ if(NOT ${CUDA_FOUND}
         AND NOT ${KWIN_FOUND}
         AND NOT ${PORTAL_FOUND}
         AND NOT ${WAYLAND_FOUND}
-        AND NOT ${X11_FOUND})
-    message(FATAL_ERROR "Couldn't find either cuda, libdrm, libva, kwin, pipewire, portal, wayland or x11")
+        AND NOT ${X11_FOUND}
+        AND NOT ${QEMU_DBUS_FOUND})
+    message(FATAL_ERROR "Couldn't find either cuda, libdrm, libva, kwin, pipewire, portal, wayland, x11 or qemu-dbus")
 endif()
 
 # These need to be set before common.cmake adds the libvirtualhid subdirectory in order for them to be picked up
diff --git a/cmake/prep/options.cmake b/cmake/prep/options.cmake
index 4b2455b..3b77726 100644
--- a/cmake/prep/options.cmake
+++ b/cmake/prep/options.cmake
@@ -74,4 +74,6 @@ elseif(UNIX)  # Linux
             "Enable KWin ScreenCast grab if available" ON)
     option(SUNSHINE_ENABLE_PORTAL
             "Enable XDG portal grab if available" ON)
+    option(SUNSHINE_ENABLE_QEMU_DBUS
+            "Enable the QEMU Display1 D-Bus CPU capture backend" OFF)
 endif()
diff --git a/src/platform/linux/misc.cpp b/src/platform/linux/misc.cpp
index de36d54..72ca879 100644
--- a/src/platform/linux/misc.cpp
+++ b/src/platform/linux/misc.cpp
@@ -1124,6 +1124,9 @@ namespace platf {
 #endif
 #ifdef SUNSHINE_BUILD_PORTAL
       PORTAL,  ///< XDG PORTAL
+#endif
+#ifdef SUNSHINE_BUILD_QEMU_DBUS
+      QEMU_DBUS,  ///< QEMU Display1 over a private D-Bus address
 #endif
       MAX_FLAGS  ///< The maximum number of flags
     };
@@ -1205,10 +1208,24 @@ namespace platf {
   }
 #endif
 
+#ifdef SUNSHINE_BUILD_QEMU_DBUS
+  std::vector<std::string> qemu_dbus_display_names();
+  std::shared_ptr<display_t> qemu_dbus_display(mem_type_e hwdevice_type, const std::string &display_name, const video::config_t &config);
+
+  bool verify_qemu_dbus() {
+    return !qemu_dbus_display_names().empty();
+  }
+#endif
+
   /**
    * @brief List display names accepted by the selected capture backend.
    */
   std::vector<std::string> display_names(mem_type_e hwdevice_type) {
+#ifdef SUNSHINE_BUILD_QEMU_DBUS
+    if (sources[source::QEMU_DBUS]) {
+      return qemu_dbus_display_names();
+    }
+#endif
 #ifdef SUNSHINE_BUILD_CUDA
     // display using NvFBC only supports mem_type_e::cuda
     if (sources[source::NVFBC] && hwdevice_type == mem_type_e::cuda) {
@@ -1262,6 +1279,12 @@ namespace platf {
   }
 
   std::shared_ptr<display_t> display(mem_type_e hwdevice_type, const std::string &display_name, const video::config_t &config) {
+#ifdef SUNSHINE_BUILD_QEMU_DBUS
+    if (sources[source::QEMU_DBUS]) {
+      BOOST_LOG(info) << "Screencasting with QEMU Display1 D-Bus"sv;
+      return qemu_dbus_display(hwdevice_type, display_name, config);
+    }
+#endif
     // Keep KMS as first element to check before dropping CAP_SYS_ADMIN
 #ifdef SUNSHINE_BUILD_DRM
     if (sources[source::KMS]) {
@@ -1373,6 +1396,11 @@ namespace platf {
       sources[source::KWIN] = true;
     }
 #endif
+#ifdef SUNSHINE_BUILD_QEMU_DBUS
+    if (config::video.capture == "qemu_dbus" && verify_qemu_dbus()) {
+      sources[source::QEMU_DBUS] = true;
+    }
+#endif
 
     if (sources.none()) {
       BOOST_LOG(error) << "Unable to initialize capture method"sv;
diff --git a/src/platform/linux/qemu_dbus.cpp b/src/platform/linux/qemu_dbus.cpp
new file mode 100644
index 0000000..78a24f8
--- /dev/null
+++ b/src/platform/linux/qemu_dbus.cpp
@@ -0,0 +1,754 @@
+/**
+ * @file src/platform/linux/qemu_dbus.cpp
+ * @brief CPU-first QEMU Display1 D-Bus capture source for Linux.
+ */
+
+// standard includes
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <limits>
+#include <mutex>
+#include <string_view>
+#include <thread>
+#include <utility>
+#include <vector>
+
+// system includes
+#include <sys/socket.h>
+#include <unistd.h>
+
+// lib includes
+#include <gio/gio.h>
+#include <gio/gunixfdlist.h>
+
+// local includes
+#include "src/logging.h"
+#include "src/platform/linux/qemu_dbus.h"
+
+namespace platf {
+  using namespace std::literals;
+
+  namespace {
+    constexpr std::string_view qemu_address_environment = "SUNSHINE_QEMU_DBUS_ADDRESS";
+    constexpr std::string_view qemu_destination_environment = "SUNSHINE_QEMU_DBUS_DESTINATION";
+    constexpr char default_destination[] = "org.qemu";
+    constexpr char console_path[] = "/org/qemu/Display1/Console_0";
+    constexpr char console_interface[] = "org.qemu.Display1.Console";
+    constexpr char listener_path[] = "/org/qemu/Display1/Listener";
+    constexpr char listener_interface[] = "org.qemu.Display1.Listener";
+    constexpr std::uint32_t max_dimension = 16384U;
+    constexpr std::uint64_t max_frame_bytes = 512ULL * 1024ULL * 1024ULL;
+
+    // Public pixman wire values.  QEMU sends native byte arrays; all accepted
+    // layouts are normalized once to BGR0 because Sunshine's software encoder
+    // uses AV_PIX_FMT_BGR0 for four-byte CPU images.
+    constexpr std::uint32_t pixman_format(std::uint32_t bpp,
+                                          std::uint32_t type,
+                                          std::uint32_t alpha,
+                                          std::uint32_t red,
+                                          std::uint32_t green,
+                                          std::uint32_t blue) {
+      return (bpp << 24U) | (type << 16U) | (alpha << 12U) |
+             (red << 8U) | (green << 4U) | blue;
+    }
+
+    constexpr std::uint32_t pixman_a8r8g8b8 = pixman_format(32U, 2U, 8U, 8U, 8U, 8U);
+    constexpr std::uint32_t pixman_x8r8g8b8 = pixman_format(32U, 2U, 0U, 8U, 8U, 8U);
+    constexpr std::uint32_t pixman_a8b8g8r8 = pixman_format(32U, 3U, 8U, 8U, 8U, 8U);
+    constexpr std::uint32_t pixman_x8b8g8r8 = pixman_format(32U, 3U, 0U, 8U, 8U, 8U);
+    constexpr std::uint32_t pixman_b8g8r8a8 = pixman_format(32U, 8U, 8U, 8U, 8U, 8U);
+    constexpr std::uint32_t pixman_b8g8r8x8 = pixman_format(32U, 8U, 0U, 8U, 8U, 8U);
+    constexpr std::uint32_t pixman_r8g8b8a8 = pixman_format(32U, 9U, 8U, 8U, 8U, 8U);
+    constexpr std::uint32_t pixman_r8g8b8x8 = pixman_format(32U, 9U, 0U, 8U, 8U, 8U);
+
+    enum class packed_layout_e {
+      bgra,
+      bgrx,
+      rgba,
+      rgbx,
+      argb,
+      xrgb,
+      abgr,
+      xbgr,
+      unsupported,
+    };
+
+    packed_layout_e packed_layout(std::uint32_t format) {
+      switch (format) {
+        case pixman_a8r8g8b8: return packed_layout_e::bgra;
+        case pixman_x8r8g8b8: return packed_layout_e::bgrx;
+        case pixman_a8b8g8r8: return packed_layout_e::rgba;
+        case pixman_x8b8g8r8: return packed_layout_e::rgbx;
+        case pixman_b8g8r8a8: return packed_layout_e::argb;
+        case pixman_b8g8r8x8: return packed_layout_e::xrgb;
+        case pixman_r8g8b8a8: return packed_layout_e::abgr;
+        case pixman_r8g8b8x8: return packed_layout_e::xbgr;
+        default: return packed_layout_e::unsupported;
+      }
+    }
+
+    bool checked_frame_size(std::uint32_t width,
+                            std::uint32_t height,
+                            std::uint32_t stride,
+                            std::size_t &packed_size) {
+      if (width == 0U || height == 0U || width > max_dimension || height > max_dimension) {
+        return false;
+      }
+      const auto row_bytes = static_cast<std::uint64_t>(width) * 4U;
+      const auto source_bytes = static_cast<std::uint64_t>(stride) * height;
+      const auto destination_bytes = row_bytes * height;
+      if (stride < row_bytes || source_bytes > max_frame_bytes ||
+          destination_bytes > max_frame_bytes ||
+          destination_bytes > std::numeric_limits<std::size_t>::max()) {
+        return false;
+      }
+      packed_size = static_cast<std::size_t>(destination_bytes);
+      return true;
+    }
+
+    bool normalize_to_bgrx(const std::uint8_t *source,
+                           std::size_t source_size,
+                           std::uint32_t width,
+                           std::uint32_t height,
+                           std::uint32_t stride,
+                           std::uint32_t format,
+                           std::vector<std::uint8_t> &destination) {
+      std::size_t destination_size = 0U;
+      const auto layout = packed_layout(format);
+      const auto required_source_size = static_cast<std::uint64_t>(stride) * height;
+      if (layout == packed_layout_e::unsupported ||
+          !checked_frame_size(width, height, stride, destination_size) ||
+          source == nullptr || required_source_size > source_size) {
+        return false;
+      }
+
+      destination.resize(destination_size);
+      for (std::uint32_t y = 0U; y < height; ++y) {
+        const auto *src = source + static_cast<std::size_t>(y) * stride;
+        auto *dst = destination.data() + static_cast<std::size_t>(y) * width * 4U;
+        for (std::uint32_t x = 0U; x < width; ++x) {
+          const auto *pixel = src + static_cast<std::size_t>(x) * 4U;
+          auto *out = dst + static_cast<std::size_t>(x) * 4U;
+          switch (layout) {
+            case packed_layout_e::bgra:
+            case packed_layout_e::bgrx:
+              out[0] = pixel[0]; out[1] = pixel[1]; out[2] = pixel[2]; break;
+            case packed_layout_e::rgba:
+            case packed_layout_e::rgbx:
+              out[0] = pixel[2]; out[1] = pixel[1]; out[2] = pixel[0]; break;
+            case packed_layout_e::argb:
+            case packed_layout_e::xrgb:
+              out[0] = pixel[3]; out[1] = pixel[2]; out[2] = pixel[1]; break;
+            case packed_layout_e::abgr:
+            case packed_layout_e::xbgr:
+              out[0] = pixel[1]; out[1] = pixel[2]; out[2] = pixel[3]; break;
+            case packed_layout_e::unsupported:
+              return false;
+          }
+          out[3] = 255U;
+        }
+      }
+      return true;
+    }
+
+    void log_gerror(std::string_view operation, GError *gerror) {
+      BOOST_LOG(error) << "[qemu-dbus] "sv << operation << ": "sv
+                       << (gerror != nullptr ? gerror->message : "unknown GIO error");
+      if (gerror != nullptr) {
+        g_error_free(gerror);
+      }
+    }
+
+    class qemu_cpu_img_t final : public img_t {
+    public:
+      void reset(std::uint32_t new_width, std::uint32_t new_height) {
+        const auto row = static_cast<std::size_t>(new_width) * 4U;
+        pixels.resize(row * new_height);
+        width = static_cast<std::int32_t>(new_width);
+        height = static_cast<std::int32_t>(new_height);
+        pixel_pitch = 4;
+        row_pitch = static_cast<std::int32_t>(row);
+        data = pixels.data();
+      }
+
+      std::vector<std::uint8_t> pixels;
+    };
+
+    struct qemu_frame_t {
+      std::vector<std::uint8_t> pixels;
+      std::uint32_t width {};
+      std::uint32_t height {};
+      std::uint64_t sequence {};
+      std::uint64_t generation {};
+      std::chrono::steady_clock::time_point captured_at {};
+      bool available {};
+      bool disabled {};
+    };
+
+    class qemu_dbus_display_t final : public display_t {
+    public:
+      explicit qemu_dbus_display_t(std::string address)
+          : address_ {std::move(address)} {
+        if (const auto *configured_destination = std::getenv(qemu_destination_environment.data());
+            configured_destination != nullptr && configured_destination[0] != '\0') {
+          destination_ = configured_destination;
+        } else {
+          destination_ = default_destination;
+        }
+      }
+
+      ~qemu_dbus_display_t() override {
+        close();
+      }
+
+      bool init() {
+        if (!g_dbus_is_address(address_.c_str())) {
+          BOOST_LOG(error) << "[qemu-dbus] invalid SUNSHINE_QEMU_DBUS_ADDRESS"sv;
+          return false;
+        }
+        GError *gerror = nullptr;
+        main_bus_ = g_dbus_connection_new_for_address_sync(
+          address_.c_str(),
+          static_cast<GDBusConnectionFlags>(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                            G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION),
+          nullptr,
+          nullptr,
+          &gerror
+        );
+        if (main_bus_ == nullptr) {
+          log_gerror("connect private QEMU D-Bus", gerror);
+          return false;
+        }
+        g_dbus_connection_set_exit_on_close(main_bus_, false);
+        if ((g_dbus_connection_get_capabilities(main_bus_) &
+             G_DBUS_CAPABILITY_FLAGS_UNIX_FD_PASSING) == 0) {
+          BOOST_LOG(error) << "[qemu-dbus] private QEMU D-Bus does not permit Unix FD passing"sv;
+          return false;
+        }
+        g_signal_connect(main_bus_,
+                         "closed",
+                         G_CALLBACK(&qemu_dbus_display_t::connection_closed),
+                         this);
+
+        int sockets[2] {-1, -1};
+        if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) != 0) {
+          BOOST_LOG(error) << "[qemu-dbus] socketpair for listener failed"sv;
+          return false;
+        }
+        const int client_fd = sockets[0];
+        const int qemu_fd = sockets[1];
+
+        GUnixFDList *fd_list = g_unix_fd_list_new();
+        const int fd_handle = g_unix_fd_list_append(fd_list, qemu_fd, &gerror);
+        if (fd_handle < 0) {
+          ::close(client_fd);
+          ::close(qemu_fd);
+          g_object_unref(fd_list);
+          log_gerror("append QEMU listener fd", gerror);
+          return false;
+        }
+
+        GVariant *reply = g_dbus_connection_call_with_unix_fd_list_sync(
+          main_bus_,
+          destination_.c_str(),
+          console_path,
+          console_interface,
+          "RegisterListener",
+          g_variant_new("(h)", fd_handle),
+          G_VARIANT_TYPE_UNIT,
+          G_DBUS_CALL_FLAGS_NONE,
+          5000,
+          fd_list,
+          nullptr,
+          nullptr,
+          &gerror
+        );
+        g_object_unref(fd_list);
+        ::close(qemu_fd);
+        if (reply == nullptr) {
+          ::close(client_fd);
+          log_gerror("QEMU RegisterListener", gerror);
+          return false;
+        }
+        g_variant_unref(reply);
+
+        // RegisterListener hands its peer end to QEMU.  It must happen before
+        // opening the synchronous client connection, otherwise both peers can
+        // wait indefinitely for the other side's authentication handshake.
+        peer_context_ = g_main_context_new();
+        g_main_context_push_thread_default(peer_context_);
+        auto pop_context = [this] {
+          g_main_context_pop_thread_default(peer_context_);
+        };
+
+        GSocket *socket = g_socket_new_from_fd(client_fd, &gerror);
+        if (socket == nullptr) {
+          ::close(client_fd);
+          pop_context();
+          log_gerror("wrap QEMU listener socket", gerror);
+          return false;
+        }
+        // Bound the synchronous p2p authentication below.  QEMU owns the
+        // other end after RegisterListener; a stalled or crashed process must
+        // not leave Sunshine waiting forever during encoder probing.
+        g_socket_set_timeout(socket, 5U);
+        GSocketConnection *stream = g_socket_connection_factory_create_connection(socket);
+        g_object_unref(socket);
+        peer_bus_ = g_dbus_connection_new_sync(
+          G_IO_STREAM(stream),
+          nullptr,
+          static_cast<GDBusConnectionFlags>(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                            G_DBUS_CONNECTION_FLAGS_DELAY_MESSAGE_PROCESSING),
+          nullptr,
+          nullptr,
+          &gerror
+        );
+        g_object_unref(stream);
+        if (peer_bus_ == nullptr) {
+          pop_context();
+          log_gerror("open QEMU Display1 listener", gerror);
+          return false;
+        }
+        g_dbus_connection_set_exit_on_close(peer_bus_, false);
+        g_signal_connect(peer_bus_,
+                         "closed",
+                         G_CALLBACK(&qemu_dbus_display_t::connection_closed),
+                         this);
+
+        listener_introspection_ = g_dbus_node_info_new_for_xml(listener_xml, &gerror);
+        if (listener_introspection_ == nullptr) {
+          pop_context();
+          log_gerror("parse QEMU listener interface", gerror);
+          return false;
+        }
+        listener_registration_ = g_dbus_connection_register_object(
+          peer_bus_,
+          listener_path,
+          listener_introspection_->interfaces[0],
+          &listener_vtable,
+          this,
+          nullptr,
+          &gerror
+        );
+        if (listener_registration_ == 0U) {
+          pop_context();
+          log_gerror("register QEMU listener object", gerror);
+          return false;
+        }
+        g_dbus_connection_start_message_processing(peer_bus_);
+        peer_loop_ = g_main_loop_new(peer_context_, false);
+        pop_context();
+
+        peer_thread_ = std::thread([this] {
+          g_main_context_push_thread_default(peer_context_);
+          g_main_loop_run(peer_loop_);
+          g_main_context_pop_thread_default(peer_context_);
+        });
+
+        std::unique_lock lock(frame_mutex_);
+        if (!frame_ready_.wait_for(lock, 5s, [this] {
+              return frame_.available || shutting_down_ || transport_closed_;
+            })) {
+          BOOST_LOG(error) << "[qemu-dbus] timed out waiting for initial QEMU Scanout"sv;
+          return false;
+        }
+        if (shutting_down_ || transport_closed_ || !frame_.available) {
+          return false;
+        }
+        width = static_cast<int>(frame_.width);
+        height = static_cast<int>(frame_.height);
+        logical_width = width;
+        logical_height = height;
+        env_width = width;
+        env_height = height;
+        env_logical_width = width;
+        env_logical_height = height;
+        return true;
+      }
+
+      capture_e capture(const push_captured_image_cb_t &push_captured_image_cb,
+                        const pull_free_image_cb_t &pull_free_image_cb,
+                        bool *) override {
+        std::uint64_t last_sequence = 0U;
+        std::uint64_t generation = 0U;
+        {
+          std::lock_guard lock(frame_mutex_);
+          generation = frame_.generation;
+        }
+
+        while (true) {
+          qemu_frame_t captured;
+          {
+            std::unique_lock lock(frame_mutex_);
+            if (!frame_ready_.wait_for(lock, 100ms, [this, last_sequence, generation] {
+                  return shutting_down_ || transport_closed_ || frame_.disabled ||
+                         frame_.generation != generation ||
+                         (frame_.available && frame_.sequence != last_sequence);
+                })) {
+              lock.unlock();
+              if (!push_captured_image_cb({}, false)) {
+                return capture_e::ok;
+              }
+              continue;
+            }
+            if (shutting_down_) {
+              return capture_e::ok;
+            }
+            if (transport_closed_ || frame_.disabled || frame_.generation != generation) {
+              return capture_e::reinit;
+            }
+            captured = frame_;
+          }
+
+          std::shared_ptr<img_t> output;
+          if (!pull_free_image_cb(output)) {
+            return capture_e::interrupted;
+          }
+          auto *cpu_image = dynamic_cast<qemu_cpu_img_t *>(output.get());
+          if (cpu_image == nullptr) {
+            BOOST_LOG(error) << "[qemu-dbus] image pool returned an incompatible CPU image"sv;
+            return capture_e::error;
+          }
+          cpu_image->reset(captured.width, captured.height);
+          std::memcpy(cpu_image->data, captured.pixels.data(), captured.pixels.size());
+          cpu_image->frame_timestamp = captured.captured_at;
+
+          last_sequence = captured.sequence;
+          if (!push_captured_image_cb(std::move(output), true)) {
+            return capture_e::ok;
+          }
+        }
+      }
+
+      std::shared_ptr<img_t> alloc_img() override {
+        auto image = std::make_shared<qemu_cpu_img_t>();
+        std::lock_guard lock(frame_mutex_);
+        if (frame_.available) {
+          image->reset(frame_.width, frame_.height);
+        }
+        return image;
+      }
+
+      std::unique_ptr<avcodec_encode_device_t> make_avcodec_encode_device(pix_fmt_e) override {
+        return std::make_unique<avcodec_encode_device_t>();
+      }
+
+      int dummy_img(img_t *image) override {
+        auto *cpu_image = dynamic_cast<qemu_cpu_img_t *>(image);
+        if (cpu_image == nullptr) {
+          return -1;
+        }
+        std::lock_guard lock(frame_mutex_);
+        if (!frame_.available) {
+          return -1;
+        }
+        cpu_image->reset(frame_.width, frame_.height);
+        std::fill(cpu_image->pixels.begin(), cpu_image->pixels.end(), 0U);
+        return 0;
+      }
+
+    private:
+      inline static constexpr char listener_xml[] = R"xml(
+<node>
+  <interface name="org.qemu.Display1.Listener">
+    <method name="Scanout"><arg type="u" direction="in"/><arg type="u" direction="in"/><arg type="u" direction="in"/><arg type="u" direction="in"/><arg type="ay" direction="in"/></method>
+    <method name="Update"><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="u" direction="in"/><arg type="u" direction="in"/><arg type="ay" direction="in"/></method>
+    <method name="Disable"/>
+    <method name="MouseSet"><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
+    <method name="CursorDefine"><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="ay" direction="in"/></method>
+    <property name="Interfaces" type="as" access="read"/>
+  </interface>
+</node>
+)xml";
+
+      static void listener_method_call(GDBusConnection *,
+                                       const gchar *,
+                                       const gchar *,
+                                       const gchar *,
+                                       const gchar *method_name,
+                                       GVariant *parameters,
+                                       GDBusMethodInvocation *invocation,
+                                       gpointer userdata) {
+        try {
+          auto *self = static_cast<qemu_dbus_display_t *>(userdata);
+          if (std::strcmp(method_name, "Scanout") == 0) {
+            self->handle_scanout(parameters, invocation);
+            return;
+          }
+          if (std::strcmp(method_name, "Update") == 0) {
+            self->handle_update(parameters, invocation);
+            return;
+          }
+          if (std::strcmp(method_name, "Disable") == 0) {
+            self->handle_disable(invocation);
+            return;
+          }
+          if (std::strcmp(method_name, "MouseSet") == 0 ||
+              std::strcmp(method_name, "CursorDefine") == 0) {
+            // Cursor composition is intentionally a later layer.  Acknowledge
+            // the standard callbacks so that it cannot disrupt CPU frame flow.
+            g_dbus_method_invocation_return_value(invocation, g_variant_new("()"));
+            return;
+          }
+          g_dbus_method_invocation_return_error(invocation,
+                                                G_DBUS_ERROR,
+                                                G_DBUS_ERROR_UNKNOWN_METHOD,
+                                                "Unsupported QEMU listener method: %s",
+                                                method_name);
+        } catch (const std::exception &exception) {
+          BOOST_LOG(error) << "[qemu-dbus] listener callback failed: "sv << exception.what();
+          g_dbus_method_invocation_return_error(invocation,
+                                                G_DBUS_ERROR,
+                                                G_DBUS_ERROR_FAILED,
+                                                "%s",
+                                                exception.what());
+        } catch (...) {
+          BOOST_LOG(error) << "[qemu-dbus] listener callback failed with an unknown exception"sv;
+          g_dbus_method_invocation_return_error(invocation,
+                                                G_DBUS_ERROR,
+                                                G_DBUS_ERROR_FAILED,
+                                                "%s",
+                                                "unknown C++ exception");
+        }
+      }
+
+      static GVariant *listener_get_property(GDBusConnection *,
+                                             const gchar *,
+                                             const gchar *,
+                                             const gchar *interface_name,
+                                             const gchar *property_name,
+                                             GError **,
+                                             gpointer) {
+        if (std::strcmp(interface_name, listener_interface) == 0 &&
+            std::strcmp(property_name, "Interfaces") == 0) {
+          // Do not advertise Listener.Unix.Map until mmap ownership is added.
+          return g_variant_new_strv(nullptr, 0);
+        }
+        return nullptr;
+      }
+
+      static void connection_closed(GDBusConnection *,
+                                    gboolean,
+                                    GError *gerror,
+                                    gpointer userdata) {
+        auto *self = static_cast<qemu_dbus_display_t *>(userdata);
+        {
+          std::lock_guard lock(self->frame_mutex_);
+          if (!self->shutting_down_) {
+            self->transport_closed_ = true;
+            self->frame_.disabled = true;
+          }
+        }
+        self->frame_ready_.notify_all();
+        if (gerror != nullptr) {
+          BOOST_LOG(warning) << "[qemu-dbus] Display1 transport closed: "sv << gerror->message;
+        }
+      }
+
+      void handle_scanout(GVariant *parameters, GDBusMethodInvocation *invocation) {
+        guint32 new_width = 0U;
+        guint32 new_height = 0U;
+        guint32 stride = 0U;
+        guint32 format = 0U;
+        GVariant *bytes_variant = nullptr;
+        g_variant_get(parameters, "(uuuu@ay)", &new_width, &new_height, &stride,
+                      &format, &bytes_variant);
+        gsize byte_count = 0U;
+        const auto *bytes = static_cast<const std::uint8_t *>(
+          g_variant_get_fixed_array(bytes_variant, &byte_count, sizeof(std::uint8_t))
+        );
+        std::vector<std::uint8_t> normalized;
+        const bool valid = normalize_to_bgrx(
+          bytes, byte_count, new_width, new_height, stride, format, normalized
+        );
+        g_variant_unref(bytes_variant);
+        if (!valid) {
+          BOOST_LOG(warning) << "[qemu-dbus] ignored invalid or unsupported Scanout"sv;
+          g_dbus_method_invocation_return_value(invocation, nullptr);
+          return;
+        }
+
+        {
+          std::lock_guard lock(frame_mutex_);
+          const bool geometry_changed = frame_.available &&
+                                        (frame_.width != new_width || frame_.height != new_height);
+          if (!frame_.available || geometry_changed) {
+            ++frame_.generation;
+          }
+          frame_.pixels = std::move(normalized);
+          frame_.width = new_width;
+          frame_.height = new_height;
+          ++frame_.sequence;
+          frame_.captured_at = std::chrono::steady_clock::now();
+          frame_.available = true;
+          frame_.disabled = false;
+        }
+        frame_ready_.notify_all();
+        g_dbus_method_invocation_return_value(invocation, nullptr);
+      }
+
+      void handle_update(GVariant *parameters, GDBusMethodInvocation *invocation) {
+        gint32 x = 0;
+        gint32 y = 0;
+        gint32 update_width = 0;
+        gint32 update_height = 0;
+        guint32 stride = 0U;
+        guint32 format = 0U;
+        GVariant *bytes_variant = nullptr;
+        g_variant_get(parameters, "(iiiiuu@ay)", &x, &y, &update_width,
+                      &update_height, &stride, &format, &bytes_variant);
+        gsize byte_count = 0U;
+        const auto *bytes = static_cast<const std::uint8_t *>(
+          g_variant_get_fixed_array(bytes_variant, &byte_count, sizeof(std::uint8_t))
+        );
+
+        std::vector<std::uint8_t> normalized;
+        bool valid = x >= 0 && y >= 0 && update_width > 0 && update_height > 0 &&
+                     normalize_to_bgrx(
+                       bytes,
+                       byte_count,
+                       static_cast<std::uint32_t>(update_width),
+                       static_cast<std::uint32_t>(update_height),
+                       stride,
+                       format,
+                       normalized
+                     );
+        g_variant_unref(bytes_variant);
+        if (valid) {
+          std::lock_guard lock(frame_mutex_);
+          const auto right = static_cast<std::uint64_t>(x) +
+                             static_cast<std::uint64_t>(update_width);
+          const auto bottom = static_cast<std::uint64_t>(y) +
+                              static_cast<std::uint64_t>(update_height);
+          valid = frame_.available && right <= frame_.width && bottom <= frame_.height;
+          if (valid) {
+            const auto row_bytes = static_cast<std::size_t>(update_width) * 4U;
+            const auto destination_stride = static_cast<std::size_t>(frame_.width) * 4U;
+            for (gint32 row = 0; row < update_height; ++row) {
+              const auto source_offset = static_cast<std::size_t>(row) * row_bytes;
+              const auto destination_offset =
+                static_cast<std::size_t>(y + row) * destination_stride +
+                static_cast<std::size_t>(x) * 4U;
+              std::memcpy(frame_.pixels.data() + destination_offset,
+                          normalized.data() + source_offset,
+                          row_bytes);
+            }
+            ++frame_.sequence;
+            frame_.captured_at = std::chrono::steady_clock::now();
+          }
+        }
+        if (!valid) {
+          // A stale old-mode Update is valid D-Bus traffic but must never be
+          // copied into the current surface.  A later Scanout is authoritative.
+          BOOST_LOG(debug) << "[qemu-dbus] dropped incompatible QEMU Update"sv;
+        } else {
+          frame_ready_.notify_all();
+        }
+        g_dbus_method_invocation_return_value(invocation, nullptr);
+      }
+
+      void handle_disable(GDBusMethodInvocation *invocation) {
+        {
+          std::lock_guard lock(frame_mutex_);
+          frame_.disabled = true;
+        }
+        frame_ready_.notify_all();
+        g_dbus_method_invocation_return_value(invocation, nullptr);
+      }
+
+      void close() noexcept {
+        {
+          std::lock_guard lock(frame_mutex_);
+          shutting_down_ = true;
+        }
+        frame_ready_.notify_all();
+        if (peer_loop_ != nullptr) {
+          g_main_loop_quit(peer_loop_);
+        }
+        if (peer_thread_.joinable()) {
+          peer_thread_.join();
+        }
+        if (peer_bus_ != nullptr && listener_registration_ != 0U) {
+          g_dbus_connection_unregister_object(peer_bus_, listener_registration_);
+          listener_registration_ = 0U;
+        }
+        if (listener_introspection_ != nullptr) {
+          g_dbus_node_info_unref(listener_introspection_);
+          listener_introspection_ = nullptr;
+        }
+        if (peer_loop_ != nullptr) {
+          g_main_loop_unref(peer_loop_);
+          peer_loop_ = nullptr;
+        }
+        if (peer_bus_ != nullptr) {
+          g_object_unref(peer_bus_);
+          peer_bus_ = nullptr;
+        }
+        if (peer_context_ != nullptr) {
+          g_main_context_unref(peer_context_);
+          peer_context_ = nullptr;
+        }
+        if (main_bus_ != nullptr) {
+          g_object_unref(main_bus_);
+          main_bus_ = nullptr;
+        }
+      }
+
+      inline static const GDBusInterfaceVTable listener_vtable {
+        &qemu_dbus_display_t::listener_method_call,
+        &qemu_dbus_display_t::listener_get_property,
+        nullptr,
+      };
+
+      std::string address_;
+      std::string destination_;
+      GDBusConnection *main_bus_ {};
+      GDBusConnection *peer_bus_ {};
+      GDBusNodeInfo *listener_introspection_ {};
+      GMainContext *peer_context_ {};
+      GMainLoop *peer_loop_ {};
+      guint listener_registration_ {};
+      std::thread peer_thread_;
+
+      std::mutex frame_mutex_;
+      std::condition_variable frame_ready_;
+      qemu_frame_t frame_;
+      bool shutting_down_ {};
+      bool transport_closed_ {};
+    };
+  }  // namespace
+
+  std::vector<std::string> qemu_dbus_display_names() {
+    const auto *address = std::getenv(qemu_address_environment.data());
+    if (address == nullptr || address[0] == '\0') {
+      return {};
+    }
+    return {"QEMU Display1"};
+  }
+
+  std::shared_ptr<display_t> qemu_dbus_display(mem_type_e hwdevice_type,
+                                                const std::string &,
+                                                const video::config_t &) {
+    if (hwdevice_type != mem_type_e::system) {
+      BOOST_LOG(error) << "[qemu-dbus] CPU capture requires Sunshine's software encoder"sv;
+      return nullptr;
+    }
+    const auto *address = std::getenv(qemu_address_environment.data());
+    if (address == nullptr || address[0] == '\0') {
+      BOOST_LOG(error) << "[qemu-dbus] SUNSHINE_QEMU_DBUS_ADDRESS is not set"sv;
+      return nullptr;
+    }
+
+    auto display = std::make_shared<qemu_dbus_display_t>(address);
+    if (!display->init()) {
+      return nullptr;
+    }
+    return display;
+  }
+}  // namespace platf
