+                                        std::uint32_t sample_rate,
+                                        std::uint32_t frame_size,
+                                        bool continuous,
+                                        [[maybe_unused]] bool host_audio_enabled) override {
+        return session_->microphone(channels, sample_rate, frame_size, continuous);
