+    std::uint64_t read_audio_unsigned(const std::uint8_t *bytes,
+                                      std::size_t byte_count,
+                                      bool big_endian) {
+      std::uint64_t value = 0U;
+      if (big_endian) {
+        for (std::size_t index = 0U; index < byte_count; ++index) {
+          value = (value << 8U) | bytes[index];
+        }
+      } else {
+        for (std::size_t index = 0U; index < byte_count; ++index) {
+          value |= static_cast<std::uint64_t>(bytes[index]) << (index * 8U);
+        }
+      }
+      return value;
+    }
+
+    float integer_pcm_to_float(const std::uint8_t *bytes,
+                               std::size_t byte_count,
+                               std::uint8_t bits,
+                               bool is_signed,
+                               bool big_endian) {
+      if (bits == 0U || bits > 32U || byte_count == 0U || byte_count > 4U) {
+        return 0.0F;
+      }
+      const auto raw = read_audio_unsigned(bytes, byte_count, big_endian);
+      const auto mask = (std::uint64_t {1U} << bits) - 1U;
+      const auto value = raw & mask;
+      const auto scale = static_cast<double>(std::uint64_t {1U} << (bits - 1U));
+      if (is_signed) {
+        const auto sign_bit = std::uint64_t {1U} << (bits - 1U);
+        const auto signed_value = (value & sign_bit) != 0U
+                                    ? static_cast<std::int64_t>(value | ~mask)
+                                    : static_cast<std::int64_t>(value);
+        return static_cast<float>(std::clamp(
+          static_cast<double>(signed_value) / scale, -1.0, 1.0
+        ));
+      }
+      return static_cast<float>(std::clamp(
+        (static_cast<double>(value) - scale) / scale, -1.0, 1.0
+      ));
+    }
+
+    float floating_pcm_to_float(const std::uint8_t *bytes,
+                                std::size_t byte_count,
+                                std::uint8_t bits,
+                                bool big_endian) {
+      const auto raw = read_audio_unsigned(bytes, byte_count, big_endian);
+      if (bits == 32U && byte_count == sizeof(std::uint32_t)) {
+        const auto value = std::bit_cast<float>(static_cast<std::uint32_t>(raw));
+        return std::isfinite(value) ? std::clamp(value, -1.0F, 1.0F) : 0.0F;
+      }
+      if (bits == 64U && byte_count == sizeof(std::uint64_t)) {
+        const auto value = std::bit_cast<double>(raw);
+        return std::isfinite(value)
+                 ? static_cast<float>(std::clamp(value, -1.0, 1.0))
+                 : 0.0F;
+      }
+      return 0.0F;
+    }
+
     /**
      * Map a GameStream/Moonlight Windows virtual key to the AT set-1 value
      * used by QEMU's historical qnum encoding.  Moonlight Qt explicitly sends
@@ -906,6 +979,790 @@ namespace platf {
       return input;
     }
 
+    /**
+     * Per-QEMU playback stream state supplied by AudioOutListener.Init.
+     * QEMU can have more than one voice; the MVP accepts only the one whose
+     * rate/layout exactly matches Sunshine's stereo Opus stream.
+     */
+    struct qemu_audio_stream_t {
+      std::uint8_t bits {};
+      bool is_signed {};
+      bool is_float {};
+      std::uint32_t sample_rate {};
+      std::uint8_t channels {};
+      std::uint32_t bytes_per_frame {};
+      std::uint32_t bytes_per_second {};
+      bool big_endian {};
+      bool enabled {};
+      bool muted {};
+      std::vector<std::uint8_t> volume;
+    };
+
+    struct qemu_audio_target_t {
+      std::uint32_t sample_rate {};
+      std::uint8_t channels {};
+      std::uint32_t frame_size {};
+      bool configured {};
+    };
+
+    class qemu_dbus_audio_mic_t;
+
+    /**
+     * Own the QEMU main-bus registration and the private AudioOutListener
+     * peer connection.  Audio callbacks only normalize/enqueue samples; the
+     * Sunshine audio thread is the sole FIFO consumer.
+     */
+    class qemu_dbus_audio_session_t final:
+        public std::enable_shared_from_this<qemu_dbus_audio_session_t> {
+    public:
+      qemu_dbus_audio_session_t(std::string address, std::string destination)
+          : address_ {std::move(address)}, destination_ {std::move(destination)} {
+      }
+
+      ~qemu_dbus_audio_session_t() {
+        close();
+      }
+
+      qemu_dbus_audio_session_t(const qemu_dbus_audio_session_t &) = delete;
+      qemu_dbus_audio_session_t &operator=(const qemu_dbus_audio_session_t &) = delete;
+
+      bool init() {
+        if (!g_dbus_is_address(address_.c_str())) {
+          BOOST_LOG(error) << "[qemu-dbus] invalid SUNSHINE_QEMU_DBUS_ADDRESS for guest audio"sv;
+          return false;
+        }
+
+        GError *gerror = nullptr;
+        main_bus_ = g_dbus_connection_new_for_address_sync(
+          address_.c_str(),
+          static_cast<GDBusConnectionFlags>(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                            G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION),
+          nullptr,
+          nullptr,
+          &gerror
+        );
+        if (main_bus_ == nullptr) {
+          log_gerror("connect private QEMU D-Bus for guest audio", gerror);
+          return false;
+        }
+        g_dbus_connection_set_exit_on_close(main_bus_, false);
+        if ((g_dbus_connection_get_capabilities(main_bus_) &
+             G_DBUS_CAPABILITY_FLAGS_UNIX_FD_PASSING) == 0) {
+          BOOST_LOG(error) << "[qemu-dbus] private QEMU D-Bus does not permit AudioOutListener FD passing"sv;
+          return false;
+        }
+        g_signal_connect(main_bus_,
+                         "closed",
+                         G_CALLBACK(&qemu_dbus_audio_session_t::connection_closed),
+                         this);
+
+        int sockets[2] {-1, -1};
+        if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) != 0) {
+          BOOST_LOG(error) << "[qemu-dbus] socketpair for AudioOutListener failed"sv;
+          return false;
+        }
+        const int client_fd = sockets[0];
+        const int qemu_fd = sockets[1];
+
+        GUnixFDList *fd_list = g_unix_fd_list_new();
+        const int fd_handle = g_unix_fd_list_append(fd_list, qemu_fd, &gerror);
+        if (fd_handle < 0) {
+          ::close(client_fd);
+          ::close(qemu_fd);
+          g_object_unref(fd_list);
+          log_gerror("append QEMU AudioOutListener fd", gerror);
+          return false;
+        }
+
+        // QEMU 8.2 opens the audio peer synchronously from its
+        // RegisterOutListener method handler.  Calling that method
+        // synchronously before opening our end produces a circular wait:
+        // Sunshine waits for the method reply while QEMU waits for this peer
+        // authentication.  Issue the bounded main-bus call on one thread and
+        // authenticate/register the peer on this one instead.
+        struct register_result_t {
+          GVariant *reply {};
+          GError *error {};
+        } register_result;
+        std::thread register_thread([&] {
+          register_result.reply = g_dbus_connection_call_with_unix_fd_list_sync(
+            main_bus_,
+            destination_.c_str(),
+            audio_path,
+            audio_interface,
+            "RegisterOutListener",
+            g_variant_new("(h)", fd_handle),
+            G_VARIANT_TYPE_UNIT,
+            G_DBUS_CALL_FLAGS_NO_AUTO_START,
+            5000,
+            fd_list,
+            nullptr,
+            nullptr,
+            &register_result.error
+          );
+        });
+        bool register_finalized = false;
+        bool register_succeeded = false;
+        const auto finish_register = [&] {
+          if (register_finalized) {
+            return register_succeeded;
+          }
+          register_thread.join();
+          g_object_unref(fd_list);
+          ::close(qemu_fd);
+          register_finalized = true;
+          if (register_result.reply == nullptr) {
+            log_gerror("QEMU Audio.RegisterOutListener", register_result.error);
+            register_result.error = nullptr;
+            return false;
+          }
+          g_variant_unref(register_result.reply);
+          register_result.reply = nullptr;
+          register_succeeded = true;
+          return register_succeeded;
+        };
+
+        // QEMU owns its peer FD only after the registration method starts.
+        // Connecting immediately satisfies its synchronous server handshake;
+        // DELAY_MESSAGE_PROCESSING below lets us register the listener object
+        // before it can issue Init/SetEnabled/Write calls.
+        peer_context_ = g_main_context_new();
+        g_main_context_push_thread_default(peer_context_);
+        bool context_pushed = true;
+        const auto pop_context = [&] {
+          if (context_pushed) {
+            g_main_context_pop_thread_default(peer_context_);
+            context_pushed = false;
+          }
+        };
+
+        GSocket *socket = g_socket_new_from_fd(client_fd, &gerror);
+        if (socket == nullptr) {
+          ::close(client_fd);
+          pop_context();
+          log_gerror("wrap QEMU AudioOutListener socket", gerror);
+          finish_register();
+          return false;
+        }
+        g_socket_set_timeout(socket, peer_auth_timeout_seconds);
+        GSocketConnection *stream = g_socket_connection_factory_create_connection(socket);
+        g_object_unref(socket);
+        peer_bus_ = g_dbus_connection_new_sync(
+          G_IO_STREAM(stream),
+          nullptr,
+          static_cast<GDBusConnectionFlags>(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                            G_DBUS_CONNECTION_FLAGS_DELAY_MESSAGE_PROCESSING),
+          nullptr,
+          nullptr,
+          &gerror
+        );
+        g_object_unref(stream);
+        if (peer_bus_ == nullptr) {
+          pop_context();
+          log_gerror("open QEMU AudioOutListener", gerror);
+          finish_register();
+          return false;
+        }
+        g_dbus_connection_set_exit_on_close(peer_bus_, false);
+        g_signal_connect(peer_bus_,
+                         "closed",
+                         G_CALLBACK(&qemu_dbus_audio_session_t::connection_closed),
+                         this);
+
+        listener_introspection_ = g_dbus_node_info_new_for_xml(listener_xml, &gerror);
+        if (listener_introspection_ == nullptr) {
+          pop_context();
+          log_gerror("parse QEMU AudioOutListener interface", gerror);
+          finish_register();
+          return false;
+        }
+        listener_registration_ = g_dbus_connection_register_object(
+          peer_bus_,
+          audio_listener_path,
+          listener_introspection_->interfaces[0],
+          &listener_vtable,
+          this,
+          nullptr,
+          &gerror
+        );
+        if (listener_registration_ == 0U) {
+          pop_context();
+          log_gerror("register QEMU AudioOutListener object", gerror);
+          finish_register();
+          return false;
+        }
+        g_dbus_connection_start_message_processing(peer_bus_);
+        peer_loop_ = g_main_loop_new(peer_context_, false);
+        pop_context();
+
+        peer_thread_ = std::thread([this] {
+          g_main_context_push_thread_default(peer_context_);
+          g_main_loop_run(peer_loop_);
+          g_main_context_pop_thread_default(peer_context_);
+        });
+        if (!finish_register()) {
+          return false;
+        }
+        {
+          std::lock_guard lock(audio_mutex_);
+          listener_ready_ = true;
+        }
+        BOOST_LOG(info) << "[qemu-dbus] registered QEMU AudioOutListener for guest PCM"sv;
+        return true;
+      }
+
+      std::unique_ptr<mic_t> microphone(int channels,
+                                        std::uint32_t sample_rate,
+                                        std::uint32_t frame_size,
+                                        bool continuous);
+
+      capture_e sample(std::vector<float> &frame_buffer, bool continuous) {
+        std::unique_lock lock(audio_mutex_);
+        if (!target_.configured || frame_buffer.size() !=
+                                     static_cast<std::size_t>(target_.frame_size) * target_.channels) {
+          return capture_e::error;
+        }
+        const auto wanted = frame_buffer.size();
+        const auto frame_duration = std::chrono::milliseconds(
+          std::max<std::uint64_t>(
+            1U,
+            static_cast<std::uint64_t>(target_.frame_size) * 1000U / target_.sample_rate
+          )
+        );
+        fifo_ready_.wait_for(lock, frame_duration, [&] {
+          return shutting_down_ || transport_closed_ || fifo_.size() >= wanted;
+        });
+        if (shutting_down_ || transport_closed_) {
+          return capture_e::reinit;
+        }
+        if (fifo_.size() >= wanted) {
+          std::copy_n(fifo_.begin(), wanted, frame_buffer.begin());
+          fifo_.erase(fifo_.begin(), fifo_.begin() + static_cast<std::ptrdiff_t>(wanted));
+          return capture_e::ok;
+        }
+        if (continuous) {
+          std::fill(frame_buffer.begin(), frame_buffer.end(), 0.0F);
+          return capture_e::ok;
+        }
+        return capture_e::timeout;
+      }
+
+      bool alive() const {
+        std::lock_guard lock(audio_mutex_);
+        return listener_ready_ && !shutting_down_ && !transport_closed_;
+      }
+
+      void close() noexcept {
+        {
+          std::lock_guard lock(audio_mutex_);
+          shutting_down_ = true;
+          listener_ready_ = false;
+          fifo_.clear();
+        }
+        fifo_ready_.notify_all();
+        if (peer_loop_ != nullptr) {
+          g_main_loop_quit(peer_loop_);
+        }
+        if (peer_thread_.joinable()) {
+          peer_thread_.join();
+        }
+        if (peer_bus_ != nullptr && listener_registration_ != 0U) {
+          g_dbus_connection_unregister_object(peer_bus_, listener_registration_);
+          listener_registration_ = 0U;
+        }
+        if (listener_introspection_ != nullptr) {
+          g_dbus_node_info_unref(listener_introspection_);
+          listener_introspection_ = nullptr;
+        }
+        if (peer_loop_ != nullptr) {
+          g_main_loop_unref(peer_loop_);
+          peer_loop_ = nullptr;
+        }
+        if (peer_bus_ != nullptr) {
+          g_object_unref(peer_bus_);
+          peer_bus_ = nullptr;
+        }
+        if (peer_context_ != nullptr) {
+          g_main_context_unref(peer_context_);
+          peer_context_ = nullptr;
+        }
+        if (main_bus_ != nullptr) {
+          g_object_unref(main_bus_);
+          main_bus_ = nullptr;
+        }
+      }
+
+    private:
+      inline static constexpr char listener_xml[] = R"xml(
+<node>
+  <interface name="org.qemu.Display1.AudioOutListener">
+    <method name="Init"><arg type="t" direction="in"/><arg type="y" direction="in"/><arg type="b" direction="in"/><arg type="b" direction="in"/><arg type="u" direction="in"/><arg type="y" direction="in"/><arg type="u" direction="in"/><arg type="u" direction="in"/><arg type="b" direction="in"/></method>
+    <method name="Fini"><arg type="t" direction="in"/></method>
+    <method name="SetEnabled"><arg type="t" direction="in"/><arg type="b" direction="in"/></method>
+    <method name="SetVolume"><arg type="t" direction="in"/><arg type="b" direction="in"/><arg type="ay" direction="in"/></method>
+    <method name="Write"><arg type="t" direction="in"/><arg type="ay" direction="in"/></method>
+    <property name="Interfaces" type="as" access="read"/>
+  </interface>
+</node>
+)xml";
+
+      static void listener_method_call(GDBusConnection *,
+                                       const gchar *,
+                                       const gchar *,
+                                       const gchar *,
+                                       const gchar *method_name,
+                                       GVariant *parameters,
+                                       GDBusMethodInvocation *invocation,
+                                       gpointer userdata) {
+        try {
+          auto *self = static_cast<qemu_dbus_audio_session_t *>(userdata);
+          std::string error;
+          if (std::strcmp(method_name, "Init") == 0) {
+            guint64 id = 0U;
+            guint8 bits = 0U;
+            gboolean is_signed = false;
+            gboolean is_float = false;
+            guint32 sample_rate = 0U;
+            guint8 channels = 0U;
+            guint32 bytes_per_frame = 0U;
+            guint32 bytes_per_second = 0U;
+            gboolean big_endian = false;
+            g_variant_get(parameters, "(tybbuyuub)", &id, &bits, &is_signed,
+                          &is_float, &sample_rate, &channels, &bytes_per_frame,
+                          &bytes_per_second, &big_endian);
+            if (!self->init_stream(id, bits, is_signed, is_float, sample_rate,
+                                   channels, bytes_per_frame, bytes_per_second,
+                                   big_endian, error)) {
+              g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                    G_DBUS_ERROR_INVALID_ARGS,
+                                                    "%s", error.c_str());
+              return;
+            }
+            g_dbus_method_invocation_return_value(invocation, nullptr);
+            return;
+          }
+          if (std::strcmp(method_name, "Fini") == 0) {
+            guint64 id = 0U;
+            g_variant_get(parameters, "(t)", &id);
+            if (!self->finish_stream(id, error)) {
+              g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                    G_DBUS_ERROR_INVALID_ARGS,
+                                                    "%s", error.c_str());
+              return;
+            }
+            g_dbus_method_invocation_return_value(invocation, nullptr);
+            return;
+          }
+          if (std::strcmp(method_name, "SetEnabled") == 0) {
+            guint64 id = 0U;
+            gboolean enabled = false;
+            g_variant_get(parameters, "(tb)", &id, &enabled);
+            if (!self->set_enabled(id, enabled, error)) {
+              g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                    G_DBUS_ERROR_INVALID_ARGS,
+                                                    "%s", error.c_str());
+              return;
+            }
+            g_dbus_method_invocation_return_value(invocation, nullptr);
+            return;
+          }
+          if (std::strcmp(method_name, "SetVolume") == 0) {
+            guint64 id = 0U;
+            gboolean muted = false;
+            GVariant *volume_variant = nullptr;
+            g_variant_get(parameters, "(tb@ay)", &id, &muted, &volume_variant);
+            gsize volume_size = 0U;
+            const auto *volume = static_cast<const std::uint8_t *>(
+              g_variant_get_fixed_array(volume_variant, &volume_size, sizeof(std::uint8_t))
+            );
+            const bool accepted = self->set_volume(id, muted, volume, volume_size, error);
+            g_variant_unref(volume_variant);
+            if (!accepted) {
+              g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                    G_DBUS_ERROR_INVALID_ARGS,
+                                                    "%s", error.c_str());
+              return;
+            }
+            g_dbus_method_invocation_return_value(invocation, nullptr);
+            return;
+          }
+          if (std::strcmp(method_name, "Write") == 0) {
+            guint64 id = 0U;
+            GVariant *pcm_variant = nullptr;
+            g_variant_get(parameters, "(t@ay)", &id, &pcm_variant);
+            gsize pcm_size = 0U;
+            const auto *pcm = static_cast<const std::uint8_t *>(
+              g_variant_get_fixed_array(pcm_variant, &pcm_size, sizeof(std::uint8_t))
+            );
+            const bool accepted = self->write_pcm(id, pcm, pcm_size, error);
+            g_variant_unref(pcm_variant);
+            if (!accepted) {
+              g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                    G_DBUS_ERROR_INVALID_ARGS,
+                                                    "%s", error.c_str());
+              return;
+            }
+            g_dbus_method_invocation_return_value(invocation, nullptr);
+            return;
+          }
+          g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                G_DBUS_ERROR_UNKNOWN_METHOD,
+                                                "Unsupported QEMU AudioOutListener method: %s",
+                                                method_name);
+        } catch (const std::exception &exception) {
+          BOOST_LOG(error) << "[qemu-dbus] AudioOutListener callback failed: "sv << exception.what();
+          g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                G_DBUS_ERROR_FAILED, "%s", exception.what());
+        } catch (...) {
+          BOOST_LOG(error) << "[qemu-dbus] AudioOutListener callback failed with an unknown exception"sv;
+          g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR,
+                                                G_DBUS_ERROR_FAILED,
+                                                "%s", "unknown audio listener failure");
+        }
+      }
