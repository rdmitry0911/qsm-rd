+      static void connection_closed(GDBusConnection *,
+                                    gboolean,
+                                    GError *gerror,
+                                    gpointer userdata) {
+        auto *self = static_cast<qemu_dbus_audio_session_t *>(userdata);
+        {
+          std::lock_guard lock(self->audio_mutex_);
+          if (!self->shutting_down_) {
+            self->transport_closed_ = true;
+            self->listener_ready_ = false;
+            self->fifo_.clear();
+          }
+        }
+        self->fifo_ready_.notify_all();
+        if (gerror != nullptr) {
+          BOOST_LOG(warning) << "[qemu-dbus] guest audio transport closed: "sv << gerror->message;
