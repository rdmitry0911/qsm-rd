+    std::unique_ptr<mic_t> qemu_dbus_audio_session_t::microphone(int channels,
+                                                                   std::uint32_t sample_rate,
+                                                                   std::uint32_t frame_size,
+                                                                   bool continuous) {
+      if (channels != qemu_audio_channels || sample_rate != qemu_audio_sample_rate ||
+          frame_size == 0U) {
+        BOOST_LOG(warning) << "[qemu-dbus] guest audio MVP supports only 48 kHz stereo Sunshine streams"sv;
+        return nullptr;
+      }
+      {
+        std::lock_guard lock(audio_mutex_);
+        if (shutting_down_ || transport_closed_) {
+          return nullptr;
+        }
+        target_ = {
+          .sample_rate = sample_rate,
+          .channels = static_cast<std::uint8_t>(channels),
+          .frame_size = frame_size,
+          .configured = true,
+        };
+        fifo_.clear();
+      }
+      fifo_ready_.notify_all();
+      return std::make_unique<qemu_dbus_audio_mic_t>(shared_from_this(), continuous);
+    }
