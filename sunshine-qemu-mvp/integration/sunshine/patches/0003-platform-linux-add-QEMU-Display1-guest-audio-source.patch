+
+      bool init_stream(std::uint64_t id,
+                       std::uint8_t bits,
+                       bool is_signed,
+                       bool is_float,
+                       std::uint32_t sample_rate,
+                       std::uint8_t channels,
+                       std::uint32_t bytes_per_frame,
+                       std::uint32_t bytes_per_second,
+                       bool big_endian,
+                       std::string &error) {
+        const auto sample_bytes = static_cast<std::uint32_t>((bits + 7U) / 8U);
+        const auto minimum_frame_bytes = static_cast<std::uint64_t>(sample_bytes) * channels;
+        if (id == 0U || bits == 0U || sample_rate == 0U || channels == 0U ||
+            bytes_per_frame == 0U || bytes_per_second == 0U || sample_bytes == 0U ||
+            minimum_frame_bytes > bytes_per_frame ||
+            (is_float && bits != 32U && bits != 64U) || (!is_float && bits > 32U)) {
+          error = "unsupported or internally inconsistent PCM format";
+          return false;
+        }
+        qemu_audio_stream_t state {
+          .bits = bits,
+          .is_signed = is_signed,
+          .is_float = is_float,
+          .sample_rate = sample_rate,
+          .channels = channels,
+          .bytes_per_frame = bytes_per_frame,
+          .bytes_per_second = bytes_per_second,
+          .big_endian = big_endian,
+          .volume = std::vector<std::uint8_t>(channels, 255U),
+        };
+        {
+          std::lock_guard lock(audio_mutex_);
+          streams_.insert_or_assign(id, std::move(state));
+          // QEMU reuses the listener across a guest-audio restart.  Never
+          // emit stale samples from the pre-restart stream.
+          fifo_.clear();
+        }
+        fifo_ready_.notify_all();
+        BOOST_LOG(info) << "[qemu-dbus] guest audio stream initialized: "sv
+                        << sample_rate << " Hz, "sv << static_cast<unsigned int>(channels)
+                        << " channels, "sv << static_cast<unsigned int>(bits)
+                        << (is_float ? "-bit float"sv : "-bit integer"sv);
+        return true;
+      }
+
+      bool finish_stream(std::uint64_t id, std::string &error) {
+        std::lock_guard lock(audio_mutex_);
+        if (streams_.erase(id) == 0U) {
+          error = "unknown QEMU guest-audio stream";
+          return false;
+        }
+        fifo_.clear();
+        fifo_ready_.notify_all();
+        return true;
+      }
+
+      bool set_enabled(std::uint64_t id, bool enabled, std::string &error) {
+        std::lock_guard lock(audio_mutex_);
+        const auto stream = streams_.find(id);
+        if (stream == streams_.end()) {
+          error = "unknown QEMU guest-audio stream";
+          return false;
+        }
+        stream->second.enabled = enabled;
+        if (!enabled) {
+          fifo_.clear();
+        }
+        fifo_ready_.notify_all();
+        return true;
+      }
+
+      bool set_volume(std::uint64_t id,
+                      bool muted,
+                      const std::uint8_t *volume,
+                      std::size_t volume_size,
+                      std::string &error) {
+        std::lock_guard lock(audio_mutex_);
+        const auto stream = streams_.find(id);
+        if (stream == streams_.end()) {
+          error = "unknown QEMU guest-audio stream";
+          return false;
+        }
+        stream->second.muted = muted;
+        stream->second.volume.clear();
+        if (volume != nullptr && volume_size != 0U) {
+          stream->second.volume.assign(volume, volume + volume_size);
+        }
+        stream->second.volume.resize(stream->second.channels, 255U);
+        if (muted) {
+          fifo_.clear();
+        }
+        fifo_ready_.notify_all();
+        return true;
+      }
+
+      bool write_pcm(std::uint64_t id,
+                     const std::uint8_t *pcm,
+                     std::size_t pcm_size,
+                     std::string &error) {
+        if (pcm_size > max_audio_packet_bytes) {
+          error = "guest PCM packet exceeds bounded listener limit";
+          return false;
+        }
+        qemu_audio_stream_t stream;
+        qemu_audio_target_t target;
+        {
+          std::lock_guard lock(audio_mutex_);
+          const auto found = streams_.find(id);
+          if (found == streams_.end()) {
+            error = "unknown QEMU guest-audio stream";
+            return false;
+          }
+          stream = found->second;
+          target = target_;
+        }
+        if (pcm_size % stream.bytes_per_frame != 0U) {
+          error = "PCM byte count is not a whole number of frames";
+          return false;
+        }
+        if (!stream.enabled || stream.muted || !target.configured ||
+            stream.sample_rate != target.sample_rate || stream.channels != target.channels) {
+          // The listener is intentionally permissive here: QEMU can create
+          // voices before Sunshine's session starts, and a later compatible
+          // voice must not be prevented by an error reply.
+          return true;
+        }
+
+        const auto sample_bytes = static_cast<std::size_t>((stream.bits + 7U) / 8U);
+        const auto frame_count = pcm_size / stream.bytes_per_frame;
+        if (frame_count > std::numeric_limits<std::size_t>::max() / stream.channels) {
+          error = "guest PCM frame count overflows local buffer";
+          return false;
+        }
+        std::vector<float> samples(frame_count * stream.channels, 0.0F);
+        for (std::size_t frame = 0U; frame < frame_count; ++frame) {
+          const auto frame_offset = frame * stream.bytes_per_frame;
+          for (std::size_t channel = 0U; channel < stream.channels; ++channel) {
+            const auto sample_offset = frame_offset + channel * sample_bytes;
+            float value = stream.is_float
+                            ? floating_pcm_to_float(pcm + sample_offset, sample_bytes,
+                                                   stream.bits, stream.big_endian)
+                            : integer_pcm_to_float(pcm + sample_offset, sample_bytes,
+                                                   stream.bits, stream.is_signed,
+                                                   stream.big_endian);
+            const auto volume = channel < stream.volume.size() ? stream.volume[channel] : 255U;
+            samples[frame * stream.channels + channel] = value *
+              static_cast<float>(volume) / 255.0F;
+          }
+        }
+
+        bool log_first_pcm = false;
+        bool log_drop = false;
+        {
+          std::lock_guard lock(audio_mutex_);
+          const auto found = streams_.find(id);
+          if (found == streams_.end() || !found->second.enabled || found->second.muted ||
+              !target_.configured || target_.sample_rate != target.sample_rate ||
+              target_.channels != target.channels) {
+            return true;
+          }
+          const auto max_samples = std::max<std::size_t>(
+            static_cast<std::size_t>(target_.frame_size) * target_.channels,
+            static_cast<std::size_t>(target_.sample_rate) * target_.channels *
+              qemu_audio_fifo_milliseconds / 1000U
+          );
+          const auto keep = std::min(samples.size(), max_samples);
+          const auto required_drop = fifo_.size() + keep > max_samples
+                                       ? fifo_.size() + keep - max_samples
+                                       : 0U;
+          if (required_drop > 0U) {
+            fifo_.erase(fifo_.begin(), fifo_.begin() +
+                         static_cast<std::ptrdiff_t>(std::min(required_drop, fifo_.size())));
+            log_drop = !logged_fifo_drop_;
+            logged_fifo_drop_ = true;
+          }
+          fifo_.insert(fifo_.end(), samples.end() - static_cast<std::ptrdiff_t>(keep), samples.end());
+          log_first_pcm = !logged_first_pcm_ && keep > 0U;
+          logged_first_pcm_ = logged_first_pcm_ || keep > 0U;
+        }
+        fifo_ready_.notify_all();
+        if (log_first_pcm) {
+          BOOST_LOG(info) << "[qemu-dbus] accepted guest PCM for Sunshine audio capture"sv;
+        }
+        if (log_drop) {
+          BOOST_LOG(warning) << "[qemu-dbus] guest-audio FIFO full; dropping oldest PCM"sv;
+        }
+        return true;
+      }
