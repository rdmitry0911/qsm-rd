From 9ea1c3f59b92441b5357f66d2920d922d466b142 Mon Sep 17 00:00:00 2001
From: q-sunshine contributors <q-sunshine@local>
Date: Wed, 2 Sep 2026 00:00:00 +0000
Subject: [PATCH] nvhttp: require system-auth media leases instead of PIN pairing

Add an opt-in, fail-closed GameStream admission mode for q-sunshine.  It
accepts only short-lived mTLS client certificates issued after system login,
binds them to the configured VM audience, removes the HTTPS and Web UI PIN
routes, and preserves the legacy paired-certificate path only when the mode is
off.

The trust anchor is loaded once from a root-owned, non-writable, regular file
without following symlinks.  Sensitive HTTPS requests reconstruct the client
identity from the active TLS socket rather than retaining a process-global
callback result.  Native launches require encrypted RTSP possession proof of
the launch key and reject leases that expire before admission; established
media is intentionally not interrupted merely because its short lease expires.
Native request diagnostics redact `rikey`, `rikeyid`, and case-insensitive
token/auth/cookie query or header values before they reach debug logs.

This patch requires the accompanying Simple-Web-Server request socket-handle
patch, applied inside Sunshine's nested third-party worktree.

---
diff --git a/src/config.cpp b/src/config.cpp
index de3979ee4a9c3afee298c8ddaad27d00865352e0..5a699ed0b607984c4850e906d6d7569cd950f612 100644
--- a/src/config.cpp
+++ b/src/config.cpp
@@ -831,6 +831,9 @@ namespace config {
     platf::get_host_name(),  // sunshine_name,
     "sunshine_state.json"s,  // file_state
     {},  // external_ip
+    false,  // qsm_system_auth_mode
+    {},  // qsm_system_auth_ca
+    {},  // qsm_system_auth_audience
   };
 
   /**
@@ -1699,6 +1702,9 @@ namespace config {
     path_f(vars, "credentials_file", config::sunshine.credentials_file);
 
     string_f(vars, "external_ip", nvhttp.external_ip);
+    bool_f(vars, "qsm_system_auth_mode", nvhttp.qsm_system_auth_mode);
+    path_f(vars, "qsm_system_auth_ca", nvhttp.qsm_system_auth_ca);
+    string_f(vars, "qsm_system_auth_audience", nvhttp.qsm_system_auth_audience);
     list_prep_cmd_f(vars, "global_prep_cmd", config::sunshine.prep_cmds);
 
     string_f(vars, "audio_sink", audio.sink);
diff --git a/src/config.h b/src/config.h
index adc4e84219a66b822f1030b7be4d002fa87adf7e..81bd1c48eb37a48609520ddf3e0b5543d10e5bc1 100644
--- a/src/config.h
+++ b/src/config.h
@@ -263,6 +263,15 @@ namespace config {
     std::string file_state;  ///< Path to the persisted Sunshine state file.
 
     std::string external_ip;  ///< External address advertised to clients when configured.
+
+    // q-sunshine's PIN-free GameStream mode is deliberately opt-in.  When it
+    // is enabled, the HTTPS server accepts only a short-lived client-auth
+    // certificate issued by this VM's system-auth lease CA.  The legacy
+    // paired-certificate store and /pair endpoint are not a fallback in this
+    // mode.
+    bool qsm_system_auth_mode;  ///< Require q-sunshine system-auth mTLS leases for GameStream HTTPS.
+    std::string qsm_system_auth_ca;  ///< PEM CA certificate used to verify per-VM media leases.
+    std::string qsm_system_auth_audience;  ///< Exact VM audience encoded in a media-lease URI SAN.
   };
 
   /**
diff --git a/src/confighttp.cpp b/src/confighttp.cpp
index 82da940b229a847099c7a0f531250ac175f2e2ae..a5d1a3070e76861bc3336ddc98c28036c4c01aed 100644
--- a/src/confighttp.cpp
+++ b/src/confighttp.cpp
@@ -1718,6 +1718,12 @@ namespace confighttp {
    * @api_examples{/api/pin| POST| {"pin":"1234","name":"My PC"}}
    */
   void savePin(const resp_https_t &response, const req_https_t &request) {
+    if (config::nvhttp.qsm_system_auth_mode) {
+      response->write(SimpleWeb::StatusCode::client_error_forbidden,
+                      "PIN pairing is disabled while q-sunshine system authentication is required");
+      response->close_connection_after_response = true;
+      return;
+    }
     if (!check_content_type(response, request, "application/json")) {
       return;
     }
@@ -2196,7 +2202,9 @@ namespace confighttp {
     server.resource["^/featured/?$"]["GET"] = page_handler("featured.html");
     server.resource["^/logout/?$"]["GET"] = page_handler("logout.html", false);
     server.resource["^/password/?$"]["GET"] = page_handler("password.html");
-    server.resource["^/pin/?$"]["GET"] = page_handler("pin.html");
+    if (!config::nvhttp.qsm_system_auth_mode) {
+      server.resource["^/pin/?$"]["GET"] = page_handler("pin.html");
+    }
     server.resource["^/troubleshooting/?$"]["GET"] = page_handler("troubleshooting.html");
     server.resource["^/welcome/?$"]["GET"] = page_handler("welcome.html", false, true);
 
@@ -2217,7 +2225,9 @@ namespace confighttp {
     server.resource["^/api/covers/upload$"]["POST"] = uploadCover;
     server.resource["^/api/csrf-token$"]["GET"] = getCSRFToken;
     server.resource["^/api/password$"]["POST"] = savePassword;
-    server.resource["^/api/pin$"]["POST"] = savePin;
+    if (!config::nvhttp.qsm_system_auth_mode) {
+      server.resource["^/api/pin$"]["POST"] = savePin;
+    }
     server.resource["^/api/logs$"]["GET"] = getLogs;
     server.resource["^/api/reset-display-device-persistence$"]["POST"] = resetDisplayDevicePersistence;
     server.resource["^/api/restart$"]["POST"] = restart;
diff --git a/src/nvhttp.cpp b/src/nvhttp.cpp
index a33ac63225cee97bf93bf523af09211c50b23387..86db828532009d6073bd50bb8dbcf9b146c5d9fb 100644
--- a/src/nvhttp.cpp
+++ b/src/nvhttp.cpp
@@ -6,17 +6,33 @@
 #define BOOST_BIND_GLOBAL_PLACEHOLDERS
 
 // standard includes
+#include <array>
+#include <chrono>
+#include <cctype>
+#include <ctime>
 #include <filesystem>
 #include <format>
+#include <memory>
+#include <optional>
+#include <stdexcept>
 #include <string>
+#include <string_view>
+#include <type_traits>
 #include <utility>
 
+#if !defined(_WIN32)
+  #include <fcntl.h>
+  #include <sys/stat.h>
+  #include <unistd.h>
+#endif
+
 // lib includes
 #include <boost/asio/ssl/context.hpp>
 #include <boost/asio/ssl/context_base.hpp>
 #include <boost/property_tree/json_parser.hpp>
 #include <boost/property_tree/ptree.hpp>
 #include <boost/property_tree/xml_parser.hpp>
+#include <openssl/x509v3.h>
 #include <Simple-Web-Server/server_http.hpp>
 
 // local includes
@@ -71,6 +87,22 @@ namespace nvhttp {
     std::function<int(SSL *)> verify;  ///< Callback that validates a client's TLS certificate after handshake.
     std::function<void(std::shared_ptr<Response>, std::shared_ptr<Request>)> on_verify_failed;  ///< Handler used to return the pairing challenge when client verification fails.
 
+    /**
+     * @brief Configure the listener for the q-sunshine system-auth media CA.
+     *
+     * The ordinary GameStream compatibility mode preserves its upstream TLS
+     * range. The lease mode has a patched client and may require TLS 1.3.
+     *
+     * @param ca PEM certificate for this VM's media-lease issuing CA.
+     */
+    void enable_system_auth_lease_mode(X509 *ca) {
+      X509_STORE *const trust_store = SSL_CTX_get_cert_store(context.native_handle());
+      if (ca == nullptr || trust_store == nullptr || X509_STORE_add_cert(trust_store, ca) != 1) {
+        throw std::runtime_error {"cannot install q-sunshine system-auth media CA"};
+      }
+      context.set_options(boost::asio::ssl::context::no_tlsv1_2);
+    }
+
   protected:
     boost::asio::ssl::context context;  ///< TLS server context configured with Sunshine's certificate and protocol policy.
 
@@ -174,9 +206,359 @@ namespace nvhttp {
   client_t client_root;  ///< In-memory representation of the paired-client database.
   std::atomic<uint32_t> session_id_counter;  ///< Monotonic counter used to allocate GameStream session IDs.
 
-  // Set by TLS verify callback, read by launch/resume handler (single-threaded HTTPS server)
-  std::string last_verified_client_cert;  ///< Last client certificate accepted by the TLS verify callback.  // NOSONAR(cpp:S5421): intentionally mutable global
-  std::string last_verified_client_name;  ///< Friendly name of last client certificate accepted by the TLS verify callback. // NOSONAR(cpp:S5421): intentionally mutable global
+  /**
+   * @brief Request-local GameStream client identity.
+   *
+   * It is reconstructed from the TLS socket for every sensitive request;
+   * retaining it in a process-global callback result would let independent
+   * connections race their launch identity.
+   */
+  struct authenticated_client_t {
+    std::string certificate;  ///< PEM leaf certificate presented by the client.
+    std::string name;  ///< Paired-device name or PAM subject for diagnostics/input identity.
+    bool has_system_auth_lease {};  ///< Whether this is a q-sunshine system-auth media lease.
+    std::chrono::system_clock::time_point system_auth_expires_at {};  ///< Absolute lease expiry when lease mode is active.
+  };
+
+  /**
+   * @brief Read a public media CA without following a replaceable path.
+   *
+   * Sunshine normally runs with elevated privileges.  Loading a CA through an
+   * unchecked pathname would let a writable or symlinked file become a media
+   * trust anchor.  Keep the descriptor open while reading, require the final
+   * object to be a root-owned regular file, and never reopen the pathname for
+   * OpenSSL.
+   *
+   * @param path Absolute path to the public per-VM CA certificate.
+   * @return Exact PEM bytes held by the opened descriptor.
+   * @throws std::runtime_error when the path cannot be used as a trust anchor.
+   */
+  std::string read_system_auth_ca_file(const std::string &path) {
+#if !defined(_WIN32) && defined(O_NOFOLLOW)
+    constexpr off_t max_ca_size = 1024 * 1024;
+    if (path.empty() || !fs::path {path}.is_absolute()) {
+      throw std::runtime_error {"q-sunshine system-auth CA path must be absolute"};
+    }
+
+    const int fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+      throw std::runtime_error {"cannot open q-sunshine system-auth CA"};
+    }
+    auto close_fd = util::fail_guard([fd]() {
+      ::close(fd);
+    });
+
+    struct stat metadata {};
+    if (::fstat(fd, &metadata) != 0 || !S_ISREG(metadata.st_mode) || metadata.st_uid != 0 ||
+        (metadata.st_mode & (S_IWGRP | S_IWOTH)) != 0 || metadata.st_size <= 0 ||
+        metadata.st_size > max_ca_size) {
+      throw std::runtime_error {"q-sunshine system-auth CA must be a root-owned non-writable regular file"};
+    }
+
+    std::string contents(static_cast<std::size_t>(metadata.st_size), '\0');
+    std::size_t offset {};
+    while (offset < contents.size()) {
+      const ssize_t read_count = ::read(fd, contents.data() + offset, contents.size() - offset);
+      if (read_count <= 0) {
+        throw std::runtime_error {"cannot read q-sunshine system-auth CA"};
+      }
+      offset += static_cast<std::size_t>(read_count);
+    }
+    return contents;
+#else
+    (void) path;
+    throw std::runtime_error {"q-sunshine system-auth CA requires O_NOFOLLOW support"};
+#endif
+  }
+
+  /**
+   * @brief Validate a short-lived q-sunshine GameStream client certificate.
+   */
+  class system_auth_lease_verifier_t {
+  public:
+    /**
+     * @brief Load one VM's lease CA and expected SAN audience.
+     *
+     * @param ca_path Path to the PEM CA certificate.
+     * @param audience Exact VM audience encoded in issued leaf certificates.
+     */
+    system_auth_lease_verifier_t(const std::string &ca_path, const std::string &audience):
+        ca_{crypto::x509(read_system_auth_ca_file(ca_path))},
+        store_{X509_STORE_new()},
+        expected_audience_uri_{"urn:q-sunshine:aud:"s + audience} {
+      if (!ca_ || !store_ || !valid_audience(audience) || !verify_ca_profile(ca_.get()) ||
+          X509_STORE_add_cert(store_.get(), ca_.get()) != 1) {
+        throw std::runtime_error {"invalid q-sunshine system-auth media CA configuration"};
+      }
+      X509_STORE_set_flags(store_.get(), X509_V_FLAG_X509_STRICT);
+    }
+
+    /**
+     * @brief Return the already-validated trust anchor for the TLS context.
+     *
+     * The caller must not reload the configured path: this certificate came
+     * from the checked descriptor used by the verifier above.
+     */
+    X509 *ca_certificate() noexcept {
+      return ca_.get();
+    }
+
+    /**
+     * @brief Verify a TLS peer and return its bounded media identity.
+     *
+     * @param ssl Native OpenSSL connection for the active HTTPS request.
+     * @return Identity only for a valid, unexpired, audience-bound leaf.
+     */
+    std::optional<authenticated_client_t> verify(SSL *ssl) const {
+      if (ssl == nullptr) {
+        return std::nullopt;
+      }
+      crypto::x509_t certificate {
+#if OPENSSL_VERSION_MAJOR >= 3
+        SSL_get1_peer_certificate(ssl)
+#else
+        SSL_get_peer_certificate(ssl)
+#endif
+      };
+      if (!certificate || !verify_certificate(certificate.get())) {
+        return std::nullopt;
+      }
+
+      auto expires_at = certificate_expiry(certificate.get());
+      auto subject = certificate_subject(certificate.get());
+      if (!expires_at || !subject) {
+        return std::nullopt;
+      }
+      return authenticated_client_t {
+        crypto::pem(certificate),
+        std::move(*subject),
+        true,
+        *expires_at,
+      };
+    }
+
+  private:
+    /**
+     * @brief Return whether an instance audience is safe for a URI SAN match.
+     *
+     * @param audience Configured VM audience text.
+     * @return True when the conservative protocol alphabet accepts it.
+     */
+    static bool valid_audience(const std::string_view audience) {
+      if (audience.empty() || audience.size() > 127 ||
+          !std::isalnum(static_cast<unsigned char>(audience.front()))) {
+        return false;
+      }
+      for (const char character : audience) {
+        if (!std::isalnum(static_cast<unsigned char>(character)) && character != '_' &&
+            character != '.' && character != ':' && character != '-') {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    /**
+     * @brief Return whether a PAM subject copied into a leaf CN is safe.
+     *
+     * @param subject Common-name bytes from the issued leaf.
+     * @return True only for the login protocol's conservative username grammar.
+     */
+    static bool valid_subject(const std::string_view subject) {
+      if (subject.empty() || subject.size() > 64 ||
+          !std::isalnum(static_cast<unsigned char>(subject.front()))) {
+        return false;
+      }
+      for (const char character : subject) {
+        if (!std::isalnum(static_cast<unsigned char>(character)) && character != '_' &&
+            character != '.' && character != '@' && character != '-') {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    /**
+     * @brief Check that an X.509 extension exists and is marked critical.
+     *
+     * @param certificate Leaf certificate to inspect.
+     * @param nid OpenSSL extension identifier.
+     * @return True only when the extension is present and critical.
+     */
+    static bool has_exactly_one_critical_extension(X509 *certificate, const int nid) {
+      const int index = X509_get_ext_by_NID(certificate, nid, -1);
+      if (index < 0) {
+        return false;
+      }
+      const X509_EXTENSION *extension = X509_get_ext(certificate, index);
+      return extension != nullptr && X509_EXTENSION_get_critical(extension) == 1 &&
+             X509_get_ext_by_NID(certificate, nid, index) == -1;
+    }
+
+    /**
+     * @brief Check that the configured trust anchor is a current, constrained VM CA.
+     *
+     * The CA is configured by a root-owned unit, but treating an arbitrary leaf
+     * as an anchor here would turn a configuration mistake into a media-auth
+     * bypass.  Keep this profile aligned with q_sunshine_lease_issuer.
+     *
+     * @param certificate Candidate per-VM issuer certificate.
+     * @return True only for a currently valid CA:TRUE/keyCertSign certificate.
+     */
+    static bool verify_ca_profile(X509 *certificate) {
+      const ASN1_TIME *const not_before = certificate == nullptr ? nullptr : X509_get0_notBefore(certificate);
+      const ASN1_TIME *const not_after = certificate == nullptr ? nullptr : X509_get0_notAfter(certificate);
+      if (certificate == nullptr || X509_get_version(certificate) != 2 || not_before == nullptr ||
+          not_after == nullptr || X509_cmp_current_time(not_before) > 0 ||
+          X509_cmp_current_time(not_after) <= 0 ||
+          X509_check_ca(certificate) != 1) {
+        return false;
+      }
+
+      BASIC_CONSTRAINTS *constraints = static_cast<BASIC_CONSTRAINTS *>(
+          X509_get_ext_d2i(certificate, NID_basic_constraints, nullptr, nullptr));
+      auto constraints_guard = util::safe_ptr<BASIC_CONSTRAINTS, BASIC_CONSTRAINTS_free> {constraints};
+      if (!constraints_guard || !constraints_guard->ca ||
+          !has_exactly_one_critical_extension(certificate, NID_basic_constraints)) {
+        return false;
+      }
+
+      ASN1_BIT_STRING *key_usage = static_cast<ASN1_BIT_STRING *>(
+          X509_get_ext_d2i(certificate, NID_key_usage, nullptr, nullptr));
+      auto key_usage_guard = util::safe_ptr<ASN1_BIT_STRING, ASN1_BIT_STRING_free> {key_usage};
+      return key_usage_guard && has_exactly_one_critical_extension(certificate, NID_key_usage) &&
+             ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 5) == 1;
+    }
+
+    /**
+     * @brief Validate the exact issuing-profile extensions on one lease leaf.
+     *
+     * @param certificate Parsed client leaf certificate.
+     * @return True only for the fixed CA:false/clientAuth/URI-SAN profile.
+     */
+    bool verify_leaf_profile(X509 *certificate) const {
+      BASIC_CONSTRAINTS *constraints = static_cast<BASIC_CONSTRAINTS *>(
+          X509_get_ext_d2i(certificate, NID_basic_constraints, nullptr, nullptr));
+      auto constraints_guard = util::safe_ptr<BASIC_CONSTRAINTS, BASIC_CONSTRAINTS_free> {constraints};
+      if (X509_get_version(certificate) != 2 || !constraints_guard || constraints_guard->ca ||
+          !has_exactly_one_critical_extension(certificate, NID_basic_constraints)) {
+        return false;
+      }
+
+      ASN1_BIT_STRING *key_usage = static_cast<ASN1_BIT_STRING *>(
+          X509_get_ext_d2i(certificate, NID_key_usage, nullptr, nullptr));
+      auto key_usage_guard = util::safe_ptr<ASN1_BIT_STRING, ASN1_BIT_STRING_free> {key_usage};
+      if (!key_usage_guard || !has_exactly_one_critical_extension(certificate, NID_key_usage) ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 0) != 1 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 2) != 1 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 1) != 0 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 3) != 0 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 4) != 0 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 5) != 0 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 6) != 0 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 7) != 0 ||
+          ASN1_BIT_STRING_get_bit(key_usage_guard.get(), 8) != 0) {
+        return false;
+      }
+
+      EXTENDED_KEY_USAGE *extended_usage = static_cast<EXTENDED_KEY_USAGE *>(
+          X509_get_ext_d2i(certificate, NID_ext_key_usage, nullptr, nullptr));
+      auto extended_usage_guard = util::safe_ptr<EXTENDED_KEY_USAGE, EXTENDED_KEY_USAGE_free> {extended_usage};
+      if (!extended_usage_guard || !has_exactly_one_critical_extension(certificate, NID_ext_key_usage) ||
+          sk_ASN1_OBJECT_num(extended_usage_guard.get()) != 1 ||
+          OBJ_obj2nid(sk_ASN1_OBJECT_value(extended_usage_guard.get(), 0)) != NID_client_auth) {
+        return false;
+      }
+
+      GENERAL_NAMES *names = static_cast<GENERAL_NAMES *>(
+          X509_get_ext_d2i(certificate, NID_subject_alt_name, nullptr, nullptr));
+      auto names_guard = util::safe_ptr<GENERAL_NAMES, GENERAL_NAMES_free> {names};
+      if (!names_guard || !has_exactly_one_critical_extension(certificate, NID_subject_alt_name) ||
+          sk_GENERAL_NAME_num(names_guard.get()) != 1) {
+        return false;
+      }
+      const GENERAL_NAME *name = sk_GENERAL_NAME_value(names_guard.get(), 0);
+      if (name == nullptr || name->type != GEN_URI) {
+        return false;
+      }
+      const ASN1_IA5STRING *uri = name->d.uniformResourceIdentifier;
+      return uri != nullptr && static_cast<std::size_t>(ASN1_STRING_length(uri)) == expected_audience_uri_.size() &&
+             CRYPTO_memcmp(ASN1_STRING_get0_data(uri), expected_audience_uri_.data(),
+                           expected_audience_uri_.size()) == 0;
+    }
+
+    /**
+     * @brief Convert a leaf's not-after value to an absolute UTC clock point.
+     *
+     * @param certificate Parsed certificate whose expiry is read.
+     * @return Empty when OpenSSL cannot safely convert the encoded timestamp.
+     */
+    static std::optional<std::chrono::system_clock::time_point> certificate_expiry(X509 *certificate) {
+      std::tm value {};
+      if (X509_get0_notAfter(certificate) == nullptr ||
+          ASN1_TIME_to_tm(X509_get0_notAfter(certificate), &value) != 1) {
+        return std::nullopt;
+      }
+#if defined(_WIN32)
+      const std::time_t seconds = _mkgmtime(&value);
+#else
+      const std::time_t seconds = timegm(&value);
+#endif
+      if (seconds == static_cast<std::time_t>(-1)) {
+        return std::nullopt;
+      }
+      return std::chrono::system_clock::from_time_t(seconds);
+    }
+
+    /**
+     * @brief Extract the conservative PAM subject from a signed leaf CN.
+     *
+     * @param certificate Parsed client certificate.
+     * @return Safe subject text, or empty if the issuer profile was not met.
+     */
+    static std::optional<std::string> certificate_subject(X509 *certificate) {
+      std::array<char, 65> buffer {};
+      const int length = X509_NAME_get_text_by_NID(X509_get_subject_name(certificate),
+                                                   NID_commonName, buffer.data(),
+                                                   static_cast<int>(buffer.size()));
+      if (length < 1 || length >= static_cast<int>(buffer.size())) {
+        return std::nullopt;
+      }
+      constexpr std::string_view prefix {"q-sunshine user "};
+      std::string subject {buffer.data(), static_cast<std::size_t>(length)};
+      if (!subject.starts_with(prefix)) {
+        return std::nullopt;
+      }
+      subject.erase(0, prefix.size());
+      return valid_subject(subject) ? std::optional<std::string> {std::move(subject)}
+                                    : std::nullopt;
+    }
+
+    /**
+     * @brief Verify CA chain, validity interval, purpose, and fixed leaf profile.
+     *
+     * @param certificate Parsed client certificate.
+     * @return True only for an unexpired direct leaf issued by this VM's CA.
+     */
+    bool verify_certificate(X509 *certificate) const {
+      if (!verify_leaf_profile(certificate)) {
+        return false;
+      }
+      crypto::x509_store_ctx_t context {X509_STORE_CTX_new()};
+      if (!context || X509_STORE_CTX_init(context.get(), store_.get(), certificate, nullptr) != 1 ||
+          X509_STORE_CTX_set_purpose(context.get(), X509_PURPOSE_SSL_CLIENT) != 1) {
