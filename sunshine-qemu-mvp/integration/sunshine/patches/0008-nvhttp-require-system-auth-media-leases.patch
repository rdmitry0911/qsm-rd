diff --git a/cmake/prep/options.cmake b/cmake/prep/options.cmake
index 2f0d2a4..4800fb0 100644
--- a/cmake/prep/options.cmake
+++ b/cmake/prep/options.cmake
@@ -18,6 +18,59 @@ option(SUNSHINE_CONFIGURE_ONLY "Configure special files only, then exit." OFF)
 
 option(SUNSHINE_ENABLE_TRAY "Enable system tray icon." ON)
 
+# Q-Sunshine is deployed by Proxmox as a per-VM GameStream transport.  In
+# that mode Proxmox owns discovery, configuration and authentication, so do
+# not build Sunshine's separate Web UI, pairing configuration surface or
+# desktop tray integration.  The profile is deliberately Linux-only: it is
+# consumed by the Proxmox package and must not silently alter normal Sunshine
+# builds on other platforms.
+option(QSUNSHINE_TRANSPORT_ONLY
+        "Build the Proxmox-managed Q-Sunshine GameStream transport only." OFF)
+
+if(QSUNSHINE_TRANSPORT_ONLY)
+    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+        message(FATAL_ERROR "QSUNSHINE_TRANSPORT_ONLY is supported only for the Linux Proxmox transport build")
+    endif()
+
+    # The upstream unit suite exercises the deliberately omitted Web UI and
+    # libcurl helpers.  Transport behaviour is covered by the Q-Sunshine E2E
+    # suite instead.
+    set(BUILD_TESTS OFF CACHE BOOL "Build tests" FORCE)
+    set(SUNSHINE_ENABLE_TRAY OFF CACHE BOOL "Enable system tray icon." FORCE)
+    # This is a VM media worker, never a host-desktop streaming server.  Make
+    # the complete capture/encoder graph deterministic here instead of relying
+    # on every package consumer to remember a collection of OFF switches.
+    # FORCE is intentional: a caller selecting this profile must not be able
+    # to re-enable a host display backend with a conflicting cache value.
+    set(SUNSHINE_ENABLE_CUDA OFF CACHE BOOL "Enable cuda specific code." FORCE)
+    set(CUDA_FAIL_ON_MISSING OFF CACHE BOOL
+        "Fail the build if CUDA is not found." FORCE)
+    set(SUNSHINE_ENABLE_DRM OFF CACHE BOOL "Enable KMS grab if available." FORCE)
+    set(SUNSHINE_ENABLE_VAAPI OFF CACHE BOOL "Enable building vaapi specific code." FORCE)
+    set(SUNSHINE_ENABLE_VULKAN OFF CACHE BOOL "Enable Vulkan video encoding." FORCE)
+    set(SUNSHINE_ENABLE_WAYLAND OFF CACHE BOOL "Enable building wayland specific code." FORCE)
+    set(SUNSHINE_ENABLE_X11 OFF CACHE BOOL "Enable X11 grab if available." FORCE)
+    set(SUNSHINE_ENABLE_KWIN OFF CACHE BOOL "Enable KWin ScreenCast grab if available" FORCE)
+    set(SUNSHINE_ENABLE_PORTAL OFF CACHE BOOL "Enable XDG portal grab if available" FORCE)
+    set(SUNSHINE_ENABLE_QEMU_DBUS ON CACHE BOOL
+        "Enable the QEMU Display1 D-Bus CPU capture backend" FORCE)
+    set(SUNSHINE_ENABLE_QEMU_DBUS_DMABUF ON CACHE BOOL
+        "Enable headless EGL CPU readback for QEMU Display1 DMA-BUF scanouts" FORCE)
+    set(SUNSHINE_ENABLE_QEMU_DBUS_AUDIO_ONLY ON CACHE BOOL
+        "Build QEMU Display1 guest audio without the host PulseAudio backend" FORCE)
+    # Input is injected directly into the QEMU guest.  libvirtualhid's XTest
+    # fallback is both unreachable and the last direct X11/Xtst link in this
+    # profile, so turn it off before the subproject defines its own option.
+    set(LIBVIRTUALHID_ENABLE_XTEST OFF CACHE BOOL
+        "Enable X11/XTest keyboard and mouse fallback on evdev platforms" FORCE)
+    # The VM transport accepts a fixed ASCII control grammar and does not use
+    # locale-aware Web UI/configuration formatting. Avoid pulling the large
+    # ICU runtime solely through Boost.Locale.
+    set(BOOST_LOCALE_ENABLE_ICU OFF CACHE BOOL
+        "Boost.Locale: enable ICU backend" FORCE)
+    message(STATUS "Q-Sunshine transport-only profile: PVE-owned control plane and QEMU-only media graph enabled")
+endif()
+
 if(WIN32)
