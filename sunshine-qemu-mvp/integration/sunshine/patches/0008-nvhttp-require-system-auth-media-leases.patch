index 0000000..29527cf
--- /dev/null
+++ b/src/process_transport.cpp
@@ -0,0 +1,86 @@
+/**
+ * @file src/process_transport.cpp
+ * @brief Fixed QEMU Console GameStream session state for Q-Sunshine.
+ */
+
+#include "process.h"
+
+#include "logging.h"
+
+using namespace std::literals;
+
+namespace proc {
+  namespace {
+    const std::vector<ctx_t> qemu_console_apps {
+      {
+        "QEMU Console",
+        std::to_string(qemu_console_app_id),
+      },
+    };
+
+    /**
+     * @brief Clears the volatile console-session marker during worker teardown.
+     */
+    class deinit_t final: public platf::deinit_t {
+    public:
+      ~deinit_t() override {
+        proc.terminate();
+      }
+    };
+  }  // namespace
+
+  proc_t proc;
+
+  int proc_t::execute(int app_id, std::shared_ptr<rtsp_stream::launch_session_t> launch_session) {
+    (void) launch_session;
+
+    if (app_id != qemu_console_app_id) {
+      BOOST_LOG(warning) << "Rejected non-QEMU GameStream application ID ["sv << app_id << ']';
+      return 404;
+    }
+
+    int expected = 0;
+    if (!_app_id.compare_exchange_strong(expected, qemu_console_app_id, std::memory_order_acq_rel)) {
+      BOOST_LOG(warning) << "QEMU Console is already active"sv;
+      return 409;
+    }
+
+    BOOST_LOG(info) << "Activated fixed QEMU Console GameStream session"sv;
+    return 0;
+  }
+
+  int proc_t::running() const {
+    return _app_id.load(std::memory_order_acquire);
+  }
+
+  const std::vector<ctx_t> &proc_t::get_apps() const {
+    return qemu_console_apps;
+  }
+
+  std::string proc_t::get_app_image(int app_id) const {
+    if (app_id != qemu_console_app_id) {
+      return {};
+    }
+    return DEFAULT_APP_IMAGE_PATH;
+  }
+
+  std::string proc_t::get_last_run_app_name() const {
+    return qemu_console_apps.front().name;
+  }
+
+  void proc_t::terminate() {
+    if (_app_id.exchange(0, std::memory_order_acq_rel) != 0) {
+      BOOST_LOG(info) << "Stopped fixed QEMU Console GameStream session"sv;
+    }
+  }
+
+  void refresh(const std::string &file_name) {
+    // A transport worker never consumes an application manifest. Do not even
+    // inspect the path: it may be user-controlled in a direct invocation.
+    (void) file_name;
+  }
+
+  std::unique_ptr<platf::deinit_t> init() {
+    return std::make_unique<deinit_t>();
+  }
+}  // namespace proc
