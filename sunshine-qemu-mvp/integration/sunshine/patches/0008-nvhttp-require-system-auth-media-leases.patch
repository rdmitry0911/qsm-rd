+  /**
+   * @brief Consume an absolute transport-owned path without appdata lookup.
+   *
+   * The PVE transport receives root-provisioned certificates and a static
+   * application manifest.  Silently creating a Sunshine state/configuration
+   * tree would turn a missing Proxmox policy into a different authentication
+   * system.  In particular, do not use `platf::appdata()` here: besides
+   * normalizing a relative name, that helper can run the legacy migration.
+   */
+  void path_no_create_f(std::unordered_map<std::string, std::string> &vars,
+                        const std::string &name, std::string &input) {
+    fs::path candidate = input;
+    std::string configured;
+    string_f(vars, name, configured);
+    if (!configured.empty()) {
+      candidate = configured;
+    }
+    if (!candidate.empty() && candidate.is_relative()) {
+      // The caller's mandatory-material validation turns this into a clear
+      // startup failure.  Do not silently reinterpret it beneath $HOME.
+#ifdef QSUNSHINE_TRANSPORT_ONLY
+      transport_path_is_invalid = true;
+#endif
+      input.clear();
+      return;
+    }
+    input = candidate.string();
+  }
+
