From 34817fdc5ec8fde9553df1d6950674308a6bffee Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 1 Sep 2026 13:16:01 +0000
Subject: [PATCH] platform/linux: add QEMU guest-audio-only build

---
 cmake/compile_definitions/linux.cmake  | 26 ++++++++++++++++++++------
 cmake/prep/options.cmake               |  2 ++
 src/platform/linux/audio_qemu_only.cpp | 24 ++++++++++++++++++++++++
 3 files changed, 46 insertions(+), 6 deletions(-)
 create mode 100644 src/platform/linux/audio_qemu_only.cpp

diff --git a/cmake/compile_definitions/linux.cmake b/cmake/compile_definitions/linux.cmake
index 44cb206..e95c5d8 100644
--- a/cmake/compile_definitions/linux.cmake
+++ b/cmake/compile_definitions/linux.cmake
@@ -285,6 +285,9 @@ if(${SUNSHINE_ENABLE_QEMU_DBUS})
         endif()
     endif()
 endif()
+if(${SUNSHINE_ENABLE_QEMU_DBUS_AUDIO_ONLY} AND NOT ${SUNSHINE_ENABLE_QEMU_DBUS})
+    message(FATAL_ERROR "SUNSHINE_ENABLE_QEMU_DBUS_AUDIO_ONLY requires SUNSHINE_ENABLE_QEMU_DBUS")
+endif()
 
 # Pipewire
 if(${SUNSHINE_ENABLE_KWIN} OR ${SUNSHINE_ENABLE_PORTAL})
@@ -355,12 +358,23 @@ list(APPEND PLATFORM_TARGET_FILES
         "${CMAKE_SOURCE_DIR}/src/platform/linux/graphics.h"
         "${CMAKE_SOURCE_DIR}/src/platform/linux/graphics.cpp"
         "${CMAKE_SOURCE_DIR}/src/platform/linux/misc.h"
-        "${CMAKE_SOURCE_DIR}/src/platform/linux/misc.cpp"
-        "${CMAKE_SOURCE_DIR}/src/platform/linux/audio.cpp")
+        "${CMAKE_SOURCE_DIR}/src/platform/linux/misc.cpp")
+
+if(${SUNSHINE_ENABLE_QEMU_DBUS_AUDIO_ONLY})
+    # QEMU AudioOutListener already provides the guest PCM capture backend.
+    # Keep this deployment free of PulseAudio and its host-desktop transitive
+    # dependencies; non-QEMU capture modes intentionally have no audio here.
+    list(APPEND PLATFORM_TARGET_FILES
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/audio_qemu_only.cpp")
+    message(STATUS "QEMU Display1 audio: guest-only (PulseAudio disabled)")
+else()
+    list(APPEND PLATFORM_TARGET_FILES
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/audio.cpp")
+    list(APPEND PLATFORM_LIBRARIES
+            pulse
+            pulse-simple)
+endif()
 
-list(APPEND PLATFORM_LIBRARIES
-        dl
-        pulse
-        pulse-simple)
+list(APPEND PLATFORM_LIBRARIES dl)
 
 list(APPEND SUNSHINE_EXTERNAL_LIBRARIES glad)
diff --git a/cmake/prep/options.cmake b/cmake/prep/options.cmake
index 9294bff..2f0d2a4 100644
--- a/cmake/prep/options.cmake
+++ b/cmake/prep/options.cmake
@@ -78,4 +78,6 @@ elseif(UNIX)  # Linux
             "Enable the QEMU Display1 D-Bus CPU capture backend" OFF)
     option(SUNSHINE_ENABLE_QEMU_DBUS_DMABUF
             "Enable headless EGL CPU readback for QEMU Display1 DMA-BUF scanouts" ON)
+    option(SUNSHINE_ENABLE_QEMU_DBUS_AUDIO_ONLY
+            "Build QEMU Display1 guest audio without the host PulseAudio backend" OFF)
 endif()
diff --git a/src/platform/linux/audio_qemu_only.cpp b/src/platform/linux/audio_qemu_only.cpp
new file mode 100644
index 0000000..39d2da8
--- /dev/null
+++ b/src/platform/linux/audio_qemu_only.cpp
@@ -0,0 +1,24 @@
+/**
+ * @file src/platform/linux/audio_qemu_only.cpp
+ * @brief QEMU Display1 guest-audio-only platform controller.
+ *
+ * This deliberately replaces the host PulseAudio implementation in the
+ * QEMU-only deployment.  It is selected only when the capture backend is the
+ * private QEMU Display1 D-Bus transport, whose AudioOutListener supplies the
+ * PCM consumed by Sunshine's normal Opus pipeline.
+ */
+
+#include "src/config.h"
+#include "src/logging.h"
+#include "src/platform/common.h"
+#include "src/platform/linux/qemu_dbus.h"
+
+namespace platf {
+  std::unique_ptr<audio_control_t> audio_control() {
+    if (config::video.capture != "qemu_dbus") {
+      BOOST_LOG(error) << "[qemu-dbus] guest-audio-only build requires capture=qemu_dbus";
+      return nullptr;
+    }
+    return qemu_dbus_audio_control();
+  }
+}  // namespace platf
-- 
2.43.0

