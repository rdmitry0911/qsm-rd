+      std::string destination_;
+      bool active_ {true};
+      bool absolute_pointer_ {};
+      bool warned_hscroll_ {};
+      bool warned_missing_mouse_geometry_ {};
+      std::uint32_t scanout_width_ {};
+      std::uint32_t scanout_height_ {};
+      std::uint32_t client_width_ {};
+      std::uint32_t client_height_ {};
+      std::optional<std::int64_t> last_absolute_x_;
+      std::optional<std::int64_t> last_absolute_y_;
+      std::optional<double> relative_absolute_x_;
+      std::optional<double> relative_absolute_y_;
+      std::uint64_t relative_calls_ {};
+      std::uint64_t relative_nonzero_calls_ {};
+      std::uint64_t absolute_calls_ {};
