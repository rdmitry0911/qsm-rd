+    private:
+      bool ready_unlocked() const {
+        return active_ && bus_ != nullptr;
+      }
+
+      void queue_unlocked(const char *interface_name,
+                          const char *method_name,
+                          GVariant *parameters) {
+        // These calls deliberately do not synchronously wait for QEMU.  A
+        // Moonlight control packet must never stall behind a wedged VM; the
+        // per-call timeout still bounds the D-Bus operation and connection
+        // closure disables this route before any host-input fallback occurs.
+        g_dbus_connection_call(
+          bus_,
+          destination_.c_str(),
+          console_path,
+          interface_name,
+          method_name,
+          parameters,
+          G_VARIANT_TYPE_UNIT,
+          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+          input_send_timeout_ms,
+          nullptr,
+          nullptr,
+          nullptr
+        );
+      }
