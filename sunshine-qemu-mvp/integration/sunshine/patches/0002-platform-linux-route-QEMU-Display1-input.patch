+          return;
+        }
+        for (int tick = 0; tick < magnitude; ++tick) {
+          queue_unlocked(mouse_interface, "Press", g_variant_new("(u)", qemu_button));
+          queue_unlocked(mouse_interface, "Release", g_variant_new("(u)", qemu_button));
+        }
