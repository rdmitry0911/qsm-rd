@@ -40,10 +43,16 @@ namespace platf {
     constexpr char default_destination[] = "org.qemu";
     constexpr char console_path[] = "/org/qemu/Display1/Console_0";
     constexpr char console_interface[] = "org.qemu.Display1.Console";
+    constexpr char keyboard_interface[] = "org.qemu.Display1.Keyboard";
+    constexpr char mouse_interface[] = "org.qemu.Display1.Mouse";
     constexpr char listener_path[] = "/org/qemu/Display1/Listener";
     constexpr char listener_interface[] = "org.qemu.Display1.Listener";
     constexpr std::uint32_t max_dimension = 16384U;
     constexpr std::uint64_t max_frame_bytes = 512ULL * 1024ULL * 1024ULL;
+    constexpr gint input_probe_timeout_ms = 1000;
+    constexpr gint ui_info_timeout_ms = 500;
