+    struct qemu_input_registry_t {
+      std::mutex mutex;
+      std::weak_ptr<qemu_input_transport_t> active;
+    };
+
+    qemu_input_registry_t &qemu_input_registry() {
+      static qemu_input_registry_t registry;
+      return registry;
+    }
+
+    void activate_qemu_input(const std::shared_ptr<qemu_input_transport_t> &input) {
+      auto &registry = qemu_input_registry();
+      std::lock_guard lock(registry.mutex);
+      registry.active = input;
+    }
+
+    void deactivate_qemu_input(const std::shared_ptr<qemu_input_transport_t> &input) {
+      if (!input) {
+        return;
+      }
+      input->deactivate();
+      auto &registry = qemu_input_registry();
+      std::lock_guard lock(registry.mutex);
+      const auto active = registry.active.lock();
+      if (active == input) {
+        registry.active.reset();
+      }
+    }
+
+    std::shared_ptr<qemu_input_transport_t> active_qemu_input() {
+      auto &registry = qemu_input_registry();
+      std::shared_ptr<qemu_input_transport_t> input;
+      {
+        std::lock_guard lock(registry.mutex);
+        input = registry.active.lock();
+      }
+      if (!input || !input->active()) {
+        if (input) {
+          std::lock_guard lock(registry.mutex);
+          if (registry.active.lock() == input) {
+            registry.active.reset();
+          }
+        }
+        return nullptr;
+      }
+      return input;
+    }
