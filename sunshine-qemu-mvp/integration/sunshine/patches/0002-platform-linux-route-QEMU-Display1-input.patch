+      void type_ascii(const char *utf8, int size) {
+        if (utf8 == nullptr || size <= 0) {
+          return;
+        }
+        std::vector<ascii_key_t> keys;
+        keys.reserve(static_cast<std::size_t>(size));
+        for (int index = 0; index < size; ++index) {
+          const auto character = static_cast<unsigned char>(utf8[index]);
+          if (character >= 0x80U) {
+            BOOST_LOG(warning) << "[qemu-dbus] cannot type non-ASCII UTF-8 without a guest keyboard-layout bridge"sv;
+            return;
+          }
+          if (character == '\r' && index + 1 < size && utf8[index + 1] == '\n') {
+            continue;
+          }
+          const auto key = ascii_key(character);
+          if (!key) {
+            BOOST_LOG(warning) << "[qemu-dbus] cannot type unsupported ASCII character 0x"sv
+                               << std::hex << static_cast<unsigned int>(character) << std::dec;
+            return;
+          }
+          keys.push_back(*key);
+        }
