+      bool request_ui_size(std::uint32_t width, std::uint32_t height, bool initial_request = false) {
+        if (width == 0U || height == 0U || width > max_dimension || height > max_dimension) {
+          return false;
+        }
+        const auto millimetres_at_96_dpi = [](std::uint32_t pixels) {
+          constexpr std::uint64_t numerator = 254U;
+          constexpr std::uint64_t denominator = 960U;
+          const auto millimetres = (static_cast<std::uint64_t>(pixels) * numerator + denominator / 2U) / denominator;
+          return static_cast<guint16>(std::clamp<std::uint64_t>(millimetres, 1U, std::numeric_limits<guint16>::max()));
+        };
+
+        std::lock_guard lock(call_mutex_);
+        if (!ready_unlocked()) {
+          return false;
+        }
+        client_width_ = width;
+        client_height_ = height;
+        GError *gerror = nullptr;
+        GVariant *reply = g_dbus_connection_call_sync(
+          bus_,
+          destination_.c_str(),
+          console_path,
+          console_interface,
+          "SetUIInfo",
+          g_variant_new("(qqiiuu)",
+                        millimetres_at_96_dpi(width),
+                        millimetres_at_96_dpi(height),
+                        0,
+                        0,
+                        width,
+                        height),
+          G_VARIANT_TYPE_UNIT,
+          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+          ui_info_timeout_ms,
+          nullptr,
+          &gerror
+        );
+        if (reply == nullptr) {
+          if (initial_request) {
+            BOOST_LOG(info) << "[qemu-dbus] Console.SetUIInfo is unavailable for this VM; guest scanout remains authoritative"sv;
+          } else {
+            BOOST_LOG(warning) << "[qemu-dbus] Console.SetUIInfo request failed"sv;
+          }
+          if (gerror != nullptr) {
+            BOOST_LOG(debug) << "[qemu-dbus] Console.SetUIInfo detail: "sv << gerror->message;
+            g_error_free(gerror);
+          }
+          return false;
+        }
+        g_variant_unref(reply);
+        if (initial_request) {
+          BOOST_LOG(info) << "[qemu-dbus] Console.SetUIInfo accepted "sv << width << 'x' << height
+                          << " at 96 DPI; waiting for guest scanout"sv;
+        }
+        return true;
+      }
