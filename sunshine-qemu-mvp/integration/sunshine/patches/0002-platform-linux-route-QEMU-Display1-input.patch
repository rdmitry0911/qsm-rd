+    constexpr int wheel_delta = 120;
 
     // Public pixman wire values.  QEMU sends native byte arrays; all accepted
     // layouts are normalized once to BGR0 because Sunshine's software encoder
@@ -165,6 +174,738 @@ namespace platf {
       }
     }
 
+    /**
+     * Map a GameStream/Moonlight Windows virtual key to the AT set-1 value
+     * used by QEMU's historical qnum encoding.  Moonlight Qt explicitly sends
+     * virtual-key values (rather than local symbols) to preserve the physical
+     * QWERTY key position across client layouts.
+     *
+     * The table is derived from QEMU's keycodemapdb `win32` and `atset1`
+     * columns.  QEMU Display1's Keyboard interface accepts qnums, not raw
+     * USB/evdev keycodes.
+     */
+    std::optional<std::uint16_t> at_set1_for_virtual_key(std::uint16_t virtual_key) {
+      constexpr std::array letter_keys {
+        0x1eU, 0x30U, 0x2eU, 0x20U, 0x12U, 0x21U, 0x22U,
+        0x23U, 0x17U, 0x24U, 0x25U, 0x26U, 0x32U, 0x31U,
+        0x18U, 0x19U, 0x10U, 0x13U, 0x1fU, 0x14U, 0x16U,
+        0x2fU, 0x11U, 0x2dU, 0x15U, 0x2cU,
+      };
+      constexpr std::array digit_keys {
+        0x0bU, 0x02U, 0x03U, 0x04U, 0x05U,
+        0x06U, 0x07U, 0x08U, 0x09U, 0x0aU,
+      };
+      constexpr std::array keypad_keys {
+        0x52U, 0x4fU, 0x50U, 0x51U, 0x4bU,
+        0x4cU, 0x4dU, 0x47U, 0x48U, 0x49U,
+      };
+      constexpr std::array function_keys {
+        0x3bU, 0x3cU, 0x3dU, 0x3eU, 0x3fU, 0x40U,
+        0x41U, 0x42U, 0x43U, 0x44U, 0x57U, 0x58U,
+        0x5dU, 0x5eU, 0x5fU, 0x55U, 0xe003U, 0xe077U,
+        0xe004U, 0x5aU, 0x74U, 0xe079U, 0x6dU, 0x6fU,
+      };
+
+      if (virtual_key >= 0x30U && virtual_key <= 0x39U) {
+        return digit_keys[virtual_key - 0x30U];
+      }
+      if (virtual_key >= 0x41U && virtual_key <= 0x5aU) {
+        return letter_keys[virtual_key - 0x41U];
+      }
+      if (virtual_key >= 0x60U && virtual_key <= 0x69U) {
+        return keypad_keys[virtual_key - 0x60U];
+      }
+      if (virtual_key >= 0x70U && virtual_key <= 0x87U) {
+        return function_keys[virtual_key - 0x70U];
+      }
+
+      switch (virtual_key) {
+        case 0x08U: return 0x0eU;       // VK_BACK
+        case 0x09U: return 0x0fU;       // VK_TAB
+        case 0x0dU: return 0x1cU;       // VK_RETURN
+        case 0x10U: return 0x2aU;       // VK_SHIFT
+        case 0x11U: return 0x1dU;       // VK_CONTROL
+        case 0x12U: return 0x38U;       // VK_MENU
+        case 0x13U: return 0xe046U;     // VK_PAUSE
+        case 0x14U: return 0x3aU;       // VK_CAPITAL
+        case 0x15U: return 0x78U;       // VK_KANA
+        case 0x16U: return 0xf2U;       // VK_IME_ON
+        case 0x19U: return 0xf1U;       // VK_HANJA
+        case 0x1aU: return 0xf1U;       // VK_IME_OFF
+        case 0x1bU: return 0x01U;       // VK_ESCAPE
+        case 0x1cU: return 0x79U;       // VK_CONVERT
+        case 0x1dU: return 0x7bU;       // VK_NONCONVERT
+        case 0x20U: return 0x39U;       // VK_SPACE
+        case 0x21U: return 0xe049U;     // VK_PRIOR
+        case 0x22U: return 0xe051U;     // VK_NEXT
+        case 0x23U: return 0xe04fU;     // VK_END
+        case 0x24U: return 0xe047U;     // VK_HOME
+        case 0x25U: return 0xe04bU;     // VK_LEFT
+        case 0x26U: return 0xe048U;     // VK_UP
+        case 0x27U: return 0xe04dU;     // VK_RIGHT
+        case 0x28U: return 0xe050U;     // VK_DOWN
+        case 0x2aU: return 0xe039U;     // VK_PRINT
+        case 0x2cU: return 0x54U;       // VK_SNAPSHOT
+        case 0x2dU: return 0xe052U;     // VK_INSERT
+        case 0x2eU: return 0xe053U;     // VK_DELETE
+        case 0x2fU: return 0xe075U;     // VK_HELP
+        case 0x5bU: return 0xe05bU;     // VK_LWIN
+        case 0x5cU: return 0xe05cU;     // VK_RWIN
+        case 0x5dU: return 0xe05dU;     // VK_APPS
+        case 0x5fU: return 0xe05fU;     // VK_SLEEP
+        case 0x6aU: return 0x37U;       // VK_MULTIPLY
+        case 0x6bU: return 0x4eU;       // VK_ADD
+        case 0x6cU: return 0x7eU;       // VK_SEPARATOR
+        case 0x6dU: return 0x4aU;       // VK_SUBTRACT
+        case 0x6eU: return 0x53U;       // VK_DECIMAL
+        case 0x6fU: return 0xe035U;     // VK_DIVIDE
+        case 0x90U: return 0x45U;       // VK_NUMLOCK
+        case 0x91U: return 0x46U;       // VK_SCROLL
+        case 0xa0U: return 0x2aU;       // VK_LSHIFT
+        case 0xa1U: return 0x36U;       // VK_RSHIFT
+        case 0xa2U: return 0x1dU;       // VK_LCONTROL
+        case 0xa3U: return 0xe01dU;     // VK_RCONTROL
+        case 0xa4U: return 0x38U;       // VK_LMENU
+        case 0xa5U: return 0xe038U;     // VK_RMENU
+        case 0xa6U: return 0xe06aU;     // VK_BROWSER_BACK
+        case 0xa7U: return 0xe069U;     // VK_BROWSER_FORWARD
+        case 0xa8U: return 0xe067U;     // VK_BROWSER_REFRESH
+        case 0xa9U: return 0xe068U;     // VK_BROWSER_STOP
+        case 0xaaU: return 0xe065U;     // VK_BROWSER_SEARCH
+        case 0xacU: return 0xe032U;     // VK_BROWSER_HOME
+        case 0xadU: return 0xe020U;     // VK_VOLUME_MUTE
+        case 0xaeU: return 0xe02eU;     // VK_VOLUME_DOWN
+        case 0xafU: return 0xe030U;     // VK_VOLUME_UP
+        case 0xb0U: return 0xe019U;     // VK_MEDIA_NEXT_TRACK
+        case 0xb1U: return 0xe010U;     // VK_MEDIA_PREV_TRACK
+        case 0xb2U: return 0xe024U;     // VK_MEDIA_STOP
+        case 0xb3U: return 0xe022U;     // VK_MEDIA_PLAY_PAUSE
+        case 0xb4U: return 0xe03fU;     // VK_LAUNCH_MAIL
+        case 0xbaU: return 0x27U;       // VK_OEM_1
+        case 0xbbU: return 0x0dU;       // VK_OEM_PLUS
+        case 0xbcU: return 0x33U;       // VK_OEM_COMMA
+        case 0xbdU: return 0x0cU;       // VK_OEM_MINUS
+        case 0xbeU: return 0x34U;       // VK_OEM_PERIOD
+        case 0xbfU: return 0x35U;       // VK_OEM_2
+        case 0xc0U: return 0x29U;       // VK_OEM_3
+        case 0xdbU: return 0x1aU;       // VK_OEM_4
+        case 0xdcU: return 0x2bU;       // VK_OEM_5
+        case 0xddU: return 0x1bU;       // VK_OEM_6
+        case 0xdeU: return 0x28U;       // VK_OEM_7
+        case 0xe2U: return 0x56U;       // VK_OEM_102
+        case 0xf2U: return 0x70U;       // VK_OEM_COPY
+        case 0xfaU: return 0xe033U;     // VK_PLAY
+        default: return std::nullopt;
+      }
+    }
+
+    std::optional<std::uint32_t> qemu_key_number(std::uint16_t virtual_key) {
+      const auto at_set1 = at_set1_for_virtual_key(virtual_key);
+      if (!at_set1) {
+        return std::nullopt;
+      }
+      if (*at_set1 == 0xf1U || *at_set1 == 0xf2U) {
+        // Hanja/Hangeul keep their historical QEMU qnum values.
+        return *at_set1 & 0x7fU;
+      }
+      if ((*at_set1 & 0xff00U) == 0xe000U) {
+        return 0x80U | (*at_set1 & 0x7fU);
+      }
+      if (*at_set1 <= 0x7fU) {
+        return *at_set1;
+      }
+      return std::nullopt;
+    }
+
+    struct ascii_key_t {
+      std::uint16_t virtual_key {};
+      bool shift {};
+    };
+
+    std::optional<ascii_key_t> ascii_key(unsigned char character) {
+      if (character >= 'a' && character <= 'z') {
+        return ascii_key_t {static_cast<std::uint16_t>('A' + character - 'a'), false};
+      }
+      if (character >= 'A' && character <= 'Z') {
+        return ascii_key_t {static_cast<std::uint16_t>(character), true};
+      }
+      if (character >= '0' && character <= '9') {
+        return ascii_key_t {static_cast<std::uint16_t>(character), false};
+      }
+      switch (character) {
+        case '\b': return ascii_key_t {0x08U, false};
+        case '\t': return ascii_key_t {0x09U, false};
+        case '\n': return ascii_key_t {0x0dU, false};
+        case ' ': return ascii_key_t {0x20U, false};
+        case '!': return ascii_key_t {0x31U, true};
+        case '@': return ascii_key_t {0x32U, true};
+        case '#': return ascii_key_t {0x33U, true};
+        case '$': return ascii_key_t {0x34U, true};
+        case '%': return ascii_key_t {0x35U, true};
+        case '^': return ascii_key_t {0x36U, true};
+        case '&': return ascii_key_t {0x37U, true};
+        case '*': return ascii_key_t {0x38U, true};
+        case '(': return ascii_key_t {0x39U, true};
+        case ')': return ascii_key_t {0x30U, true};
+        case '-': return ascii_key_t {0xbdU, false};
+        case '_': return ascii_key_t {0xbdU, true};
+        case '=': return ascii_key_t {0xbbU, false};
+        case '+': return ascii_key_t {0xbbU, true};
+        case '[': return ascii_key_t {0xdbU, false};
+        case '{': return ascii_key_t {0xdbU, true};
+        case ']': return ascii_key_t {0xddU, false};
+        case '}': return ascii_key_t {0xddU, true};
+        case '\\': return ascii_key_t {0xdcU, false};
+        case '|': return ascii_key_t {0xdcU, true};
+        case ';': return ascii_key_t {0xbaU, false};
+        case ':': return ascii_key_t {0xbaU, true};
+        case '\'': return ascii_key_t {0xdeU, false};
+        case '"': return ascii_key_t {0xdeU, true};
+        case ',': return ascii_key_t {0xbcU, false};
+        case '<': return ascii_key_t {0xbcU, true};
+        case '.': return ascii_key_t {0xbeU, false};
+        case '>': return ascii_key_t {0xbeU, true};
+        case '/': return ascii_key_t {0xbfU, false};
+        case '?': return ascii_key_t {0xbfU, true};
+        case '`': return ascii_key_t {0xc0U, false};
+        case '~': return ascii_key_t {0xc0U, true};
+        default: return std::nullopt;
+      }
+    }
+
+    /**
+     * One active capture owns the VM input path.  The transport holds its own
+     * reference to the session bus, which lets control packets outlive a
+     * transient display callback without exposing the raw GDBus connection to
+     * global platform wrappers.
+     */
+    class qemu_input_transport_t final {
+    public:
+      qemu_input_transport_t(GDBusConnection *bus, std::string destination):
+          bus_ {G_DBUS_CONNECTION(g_object_ref(bus))},
+          destination_ {std::move(destination)} {}
+
+      ~qemu_input_transport_t() {
+        deactivate();
+        if (bus_ != nullptr) {
+          g_object_unref(bus_);
+          bus_ = nullptr;
+        }
+      }
+
+      bool probe() {
+        std::lock_guard lock(call_mutex_);
+        if (!active_ || bus_ == nullptr) {
+          return false;
+        }
+        GError *gerror = nullptr;
+        GVariant *reply = g_dbus_connection_call_sync(
+          bus_,
+          destination_.c_str(),
+          console_path,
+          "org.freedesktop.DBus.Properties",
+          "Get",
+          g_variant_new("(ss)", console_interface, "Interfaces"),
+          G_VARIANT_TYPE("(v)"),
+          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+          input_probe_timeout_ms,
+          nullptr,
+          &gerror
+        );
+        if (reply == nullptr) {
+          log_gerror("query QEMU Display1 input capabilities", gerror);
+          return false;
+        }
+
+        bool has_keyboard = false;
+        bool has_mouse = false;
+        GVariant *boxed = g_variant_get_child_value(reply, 0U);
+        GVariant *interfaces = g_variant_get_variant(boxed);
+        GVariantIter iterator;
+        const gchar *interface_name = nullptr;
+        g_variant_iter_init(&iterator, interfaces);
+        while (g_variant_iter_next(&iterator, "&s", &interface_name)) {
+          has_keyboard = has_keyboard || std::strcmp(interface_name, keyboard_interface) == 0;
+          has_mouse = has_mouse || std::strcmp(interface_name, mouse_interface) == 0;
+        }
+        g_variant_unref(interfaces);
+        g_variant_unref(boxed);
+        g_variant_unref(reply);
+
+        if (!has_keyboard || !has_mouse) {
+          BOOST_LOG(error) << "[qemu-dbus] QEMU Display1 lacks required Keyboard/Mouse interfaces"sv;
+          return false;
+        }
+
+        gerror = nullptr;
+        reply = g_dbus_connection_call_sync(
+          bus_,
+          destination_.c_str(),
+          console_path,
+          "org.freedesktop.DBus.Properties",
+          "Get",
+          g_variant_new("(ss)", mouse_interface, "IsAbsolute"),
+          G_VARIANT_TYPE("(v)"),
+          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+          input_probe_timeout_ms,
+          nullptr,
+          &gerror
+        );
+        if (reply == nullptr) {
+          log_gerror("query QEMU Display1 mouse mode", gerror);
+          return false;
+        }
+        boxed = g_variant_get_child_value(reply, 0U);
+        GVariant *absolute = g_variant_get_variant(boxed);
+        absolute_pointer_ = g_variant_get_boolean(absolute);
+        g_variant_unref(absolute);
+        g_variant_unref(boxed);
+        g_variant_unref(reply);
+
+        BOOST_LOG(info) << "[qemu-dbus] QEMU input ready: keyboard=yes mouse="sv
+                        << (absolute_pointer_ ? "absolute" : "relative");
+        return true;
+      }
+
+      bool active() const {
+        std::lock_guard lock(call_mutex_);
+        return active_ && bus_ != nullptr;
+      }
+
+      /**
+       * Update the guest scanout dimensions used to translate Moonlight's
+       * relative client mouse deltas to QEMU's absolute-pointer API.  QEMU
+       * explicitly rejects RelMotion when IsAbsolute is true, while the SDL
+       * Moonlight frontend normally runs in relative-mouse mode.
+       */
+      void set_scanout_geometry(std::uint32_t width, std::uint32_t height) {
+        if (width == 0U || height == 0U || width > max_dimension || height > max_dimension) {
+          return;
+        }
+        std::lock_guard lock(call_mutex_);
+        if (scanout_width_ != width || scanout_height_ != height) {
+          scanout_width_ = width;
+          scanout_height_ = height;
+          // A mode switch invalidates a coordinate accumulated against the
+          // old desktop.  The next relative event starts at the new center.
+          relative_absolute_x_.reset();
+          relative_absolute_y_.reset();
+        }
+      }
+
+      /**
+       * Set the coordinate space of the negotiated Moonlight stream.  It is
+       * used only to keep relative-pointer speed proportional when QEMU's
+       * guest scanout differs from the requested client mode.
+       */
+      void set_client_geometry(std::uint32_t width, std::uint32_t height) {
+        if (width == 0U || height == 0U || width > max_dimension || height > max_dimension) {
+          return;
+        }
+        std::lock_guard lock(call_mutex_);
+        client_width_ = width;
+        client_height_ = height;
+      }
+
+      void report_input_stats() const {
+        std::lock_guard lock(call_mutex_);
+        BOOST_LOG(info) << "[qemu-dbus] input stats: relative_calls="sv << relative_calls_
+                        << " relative_nonzero="sv << relative_nonzero_calls_
+                        << " absolute_calls="sv << absolute_calls_
+                        << " button_calls="sv << button_calls_
+                        << " queued_rel="sv << queued_relative_calls_
+                        << " queued_abs="sv << queued_absolute_calls_
+                        << " dropped_no_geometry="sv << dropped_relative_calls_;
+      }
+
+      void deactivate() {
+        std::lock_guard lock(call_mutex_);
+        active_ = false;
+      }
+
+      void move_relative(int delta_x, int delta_y) {
+        std::lock_guard lock(call_mutex_);
+        ++relative_calls_;
+        if (delta_x != 0 || delta_y != 0) {
+          ++relative_nonzero_calls_;
+        }
+        if (!ready_unlocked()) {
+          return;
+        }
+        if (absolute_pointer_) {
+          if (scanout_width_ == 0U || scanout_height_ == 0U) {
+            ++dropped_relative_calls_;
+            if (!warned_missing_mouse_geometry_) {
+              warned_missing_mouse_geometry_ = true;
+              BOOST_LOG(warning) << "[qemu-dbus] dropped relative Moonlight mouse input before a QEMU scanout"sv;
+            }
+            return;
+          }
+
+          const auto scale_delta = [](int delta, std::uint32_t client_extent,
+                                      std::uint32_t scanout_extent) {
+            if (client_extent == 0U || scanout_extent == 0U) {
+              return static_cast<double>(delta);
+            }
+            return static_cast<double>(delta) * static_cast<double>(scanout_extent) /
+                   static_cast<double>(client_extent);
+          };
+          const auto clamp_coordinate = [](double coordinate, std::uint32_t extent) {
+            return std::clamp(coordinate, 0.0, static_cast<double>(extent - 1U));
+          };
+          const auto center_x = static_cast<double>(scanout_width_ - 1U) / 2.0;
+          const auto center_y = static_cast<double>(scanout_height_ - 1U) / 2.0;
+          const auto next_x = clamp_coordinate(
+            relative_absolute_x_.value_or(center_x) +
+              scale_delta(delta_x, client_width_, scanout_width_), scanout_width_
+          );
+          const auto next_y = clamp_coordinate(
+            relative_absolute_y_.value_or(center_y) +
+              scale_delta(delta_y, client_height_, scanout_height_), scanout_height_
+          );
+          relative_absolute_x_ = next_x;
+          relative_absolute_y_ = next_y;
+          queue_unlocked(mouse_interface, "SetAbsPosition",
+                         g_variant_new("(uu)",
+                                       static_cast<guint>(std::lround(next_x)),
+                                       static_cast<guint>(std::lround(next_y))));
+          ++queued_absolute_calls_;
+          return;
+        }
+        queue_unlocked(mouse_interface, "RelMotion", g_variant_new("(ii)", delta_x, delta_y));
+        ++queued_relative_calls_;
+      }
+
+      void move_absolute(const touch_port_t &touch_port, float x, float y) {
+        if (!std::isfinite(x) || !std::isfinite(y) || touch_port.width <= 0 || touch_port.height <= 0) {
+          BOOST_LOG(warning) << "[qemu-dbus] ignored invalid absolute pointer coordinates"sv;
+          return;
+        }
+
+        const auto width = static_cast<std::uint32_t>(touch_port.width);
+        const auto height = static_cast<std::uint32_t>(touch_port.height);
+        const auto clamp_coordinate = [](float coordinate, std::uint32_t dimension) {
+          const auto maximum = static_cast<float>(dimension - 1U);
+          return static_cast<std::uint32_t>(std::lround(std::clamp(coordinate, 0.0F, maximum)));
+        };
+        const auto target_x = clamp_coordinate(x, width);
+        const auto target_y = clamp_coordinate(y, height);
+
+        std::lock_guard lock(call_mutex_);
+        ++absolute_calls_;
+        if (!ready_unlocked()) {
+          return;
+        }
+        if (absolute_pointer_) {
+          // Keep a later relative Moonlight packet continuous with an
+          // absolute packet (for example after the SDL ungrab shortcut).
+          const auto maximum_x = scanout_width_ == 0U ? target_x : scanout_width_ - 1U;
+          const auto maximum_y = scanout_height_ == 0U ? target_y : scanout_height_ - 1U;
+          relative_absolute_x_ = static_cast<double>(std::min(target_x, maximum_x));
+          relative_absolute_y_ = static_cast<double>(std::min(target_y, maximum_y));
+          queue_unlocked(mouse_interface,
+                         "SetAbsPosition",
+                         g_variant_new("(uu)", target_x, target_y));
+          ++queued_absolute_calls_;
+          return;
+        }
+
+        // A Moonlight client can choose absolute desktop mode even when the
+        // VM was started with a relative PS/2 mouse.  Preserve ownership of
+        // the input path and approximate it with deltas instead of falling
+        // through to the host cursor.
+        const auto center_x = static_cast<std::int64_t>(width / 2U);
+        const auto center_y = static_cast<std::int64_t>(height / 2U);
+        const auto previous_x = last_absolute_x_.value_or(center_x);
+        const auto previous_y = last_absolute_y_.value_or(center_y);
+        const auto delta_x = static_cast<std::int64_t>(target_x) - previous_x;
+        const auto delta_y = static_cast<std::int64_t>(target_y) - previous_y;
+        last_absolute_x_ = target_x;
+        last_absolute_y_ = target_y;
+        queue_unlocked(mouse_interface,
+                       "RelMotion",
+                       g_variant_new("(ii)",
+                                     static_cast<gint>(std::clamp<std::int64_t>(
+                                       delta_x, std::numeric_limits<gint>::min(), std::numeric_limits<gint>::max()
+                                     )),
+                                     static_cast<gint>(std::clamp<std::int64_t>(
+                                       delta_y, std::numeric_limits<gint>::min(), std::numeric_limits<gint>::max()
+                                     ))));
+        ++queued_relative_calls_;
+      }
+
+      void button(int button, bool release) {
+        std::optional<std::uint32_t> qemu_button;
+        switch (button) {
+          case BUTTON_LEFT: qemu_button = 0U; break;
+          case BUTTON_MIDDLE: qemu_button = 1U; break;
+          case BUTTON_RIGHT: qemu_button = 2U; break;
+          case BUTTON_X1: qemu_button = 5U; break;
+          case BUTTON_X2: qemu_button = 6U; break;
+          default:
+            BOOST_LOG(warning) << "[qemu-dbus] ignored unsupported mouse button "sv << button;
+            return;
+        }
+        std::lock_guard lock(call_mutex_);
+        ++button_calls_;
+        if (!ready_unlocked()) {
+          return;
+        }
+        queue_unlocked(mouse_interface,
+                       release ? "Release" : "Press",
+                       g_variant_new("(u)", *qemu_button));
+      }
