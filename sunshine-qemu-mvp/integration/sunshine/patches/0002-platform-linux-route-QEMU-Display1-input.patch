+      void scroll(int high_res_distance) {
+        if (high_res_distance == 0) {
+          return;
+        }
+        const auto absolute_distance = high_res_distance < 0
+                                         ? -static_cast<std::int64_t>(high_res_distance)
+                                         : static_cast<std::int64_t>(high_res_distance);
+        const auto magnitude = static_cast<int>(std::min<std::int64_t>(
+          16,
+          std::max<std::int64_t>(1, absolute_distance / wheel_delta)
+        ));
+        const auto qemu_button = high_res_distance > 0 ? 3U : 4U;
