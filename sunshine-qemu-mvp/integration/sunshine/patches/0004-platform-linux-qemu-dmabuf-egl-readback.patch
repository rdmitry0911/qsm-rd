+    [[nodiscard]] int take_unix_fd(GDBusMethodInvocation *invocation, gint fd_index) {
+      if (fd_index < 0) {
+        throw std::invalid_argument("QEMU DMA-BUF listener received a negative FD index");
+      }
+      GDBusMessage *message = g_dbus_method_invocation_get_message(invocation);
+      GUnixFDList *fd_list = message == nullptr ? nullptr : g_dbus_message_get_unix_fd_list(message);
+      if (fd_list == nullptr || fd_index >= g_unix_fd_list_get_length(fd_list)) {
+        throw std::invalid_argument("QEMU DMA-BUF listener received an unavailable FD index");
+      }
+      GError *gerror = nullptr;
+      const int owned_fd = g_unix_fd_list_get(fd_list, fd_index, &gerror);
+      if (owned_fd < 0) {
+        const std::string message_text = gerror != nullptr
+                                           ? gerror->message
+                                           : "unknown GIO error";
+        if (gerror != nullptr) {
+          g_error_free(gerror);
+        }
+        throw std::runtime_error("duplicate QEMU DMA-BUF FD: " + message_text);
+      }
+      // g_unix_fd_list_get() returns a CLOEXEC duplicate.  The DMA-BUF
+      // helper now owns it through the active scanout or its exception path.
+      return owned_fd;
+    }
+
+    [[nodiscard]] std::string qemu_render_node() {
+      if (const auto *configured_node = std::getenv(qemu_render_node_environment.data());
+          configured_node != nullptr && configured_node[0] != '\0') {
+        return configured_node;
+      }
+      return default_render_node;
+    }
+#endif
