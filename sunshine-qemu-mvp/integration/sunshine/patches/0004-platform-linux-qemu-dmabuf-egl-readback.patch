index 0000000..fce7d22
--- /dev/null
+++ b/src/platform/linux/qemu_dbus_dmabuf.cpp
@@ -0,0 +1,568 @@
+/**
+ * @file src/platform/linux/qemu_dbus_dmabuf.cpp
+ * @brief Headless EGL DMA-BUF import and CPU readback for QEMU Display1.
+ */
+
+#include "src/platform/linux/qemu_dbus_dmabuf.h"
+
+// standard includes
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+// system includes
+#include <unistd.h>
+
+// lib includes
+#include <drm_fourcc.h>
+#include <gbm.h>
+#include <glad/egl.h>
+#include <glad/gl.h>
+
+namespace platf {
+  namespace {
+    constexpr std::uint32_t max_dimension = 16384U;
+    constexpr std::uint64_t max_frame_bytes = 512ULL * 1024ULL * 1024ULL;
+
+    [[nodiscard]] std::uint64_t checked_product(std::uint64_t left,
+                                                std::uint64_t right,
+                                                std::string_view label) {
+      if (left != 0U && right > std::numeric_limits<std::uint64_t>::max() / left) {
+        throw std::invalid_argument(std::string(label) + " overflows");
+      }
+      return left * right;
+    }
+
+    [[nodiscard]] bool has_egl_extension(const char *extensions, std::string_view wanted) {
+      if (extensions == nullptr || wanted.empty()) {
+        return false;
+      }
+      const std::string_view available {extensions};
+      std::size_t offset = 0U;
+      while (offset < available.size()) {
+        const auto end = available.find(' ', offset);
+        const auto token_end = end == std::string_view::npos ? available.size() : end;
+        if (available.substr(offset, token_end - offset) == wanted) {
+          return true;
+        }
+        if (end == std::string_view::npos) {
+          break;
+        }
+        offset = end + 1U;
+      }
+      return false;
+    }
+
+    [[nodiscard]] std::string egl_error(std::string_view operation) {
+      return std::string(operation) + " failed (EGL error 0x" +
+             std::to_string(static_cast<unsigned int>(eglGetError())) + ')';
+    }
+
+    void close_fd(int &fd) noexcept {
+      if (fd >= 0) {
+        ::close(fd);
+        fd = -1;
+      }
+    }
+
+    void validate_scanout(std::uint32_t width,
+                          std::uint32_t height,
+                          std::uint32_t stride,
+                          std::uint32_t fourcc) {
+      if (width == 0U || height == 0U || width > max_dimension || height > max_dimension) {
+        throw std::invalid_argument("DMA-BUF dimensions are outside limits");
+      }
+      const auto row_bytes = checked_product(width, 4U, "DMA-BUF pixel row");
+      if (stride < row_bytes || stride > static_cast<std::uint32_t>(std::numeric_limits<int>::max()) ||
+          checked_product(stride, height, "DMA-BUF size") > max_frame_bytes) {
+        throw std::invalid_argument("DMA-BUF stride or size is invalid");
+      }
+      switch (fourcc) {
+        case DRM_FORMAT_XRGB8888:
+        case DRM_FORMAT_ARGB8888:
+        case DRM_FORMAT_XBGR8888:
+        case DRM_FORMAT_ABGR8888:
+          return;
+        default:
+          throw std::invalid_argument("unsupported DMA-BUF fourcc");
+      }
+    }
+
+    void validate_damage(std::int32_t x,
+                         std::int32_t y,
+                         std::int32_t width,
+                         std::int32_t height,
+                         std::uint32_t scanout_width,
+                         std::uint32_t scanout_height) {
+      if (x < 0 || y < 0 || width <= 0 || height <= 0 ||
+          static_cast<std::uint64_t>(x) + static_cast<std::uint64_t>(width) > scanout_width ||
+          static_cast<std::uint64_t>(y) + static_cast<std::uint64_t>(height) > scanout_height) {
+        throw std::invalid_argument("DMA-BUF damage is outside scanout");
+      }
+    }
+  }  // namespace
+
+  /**
+   * Own an EGL context on QEMU's peer-listener thread.  NVIDIA's GBM driver
+   * may import VirGL DMA-BUFs yet reject gbm_bo_map() with EAGAIN.  Importing
+   * directly through EGL_EXT_image_dma_buf_import and reading an ordinary FBO
+   * is portable across that boundary and does not need X11 or Wayland.
+   */
+  struct qemu_dbus_dmabuf_readback_t::egl_readback_t final {
+    explicit egl_readback_t(::gbm_device *gbm_device) try {
+      if (gbm_device == nullptr) {
+        throw std::invalid_argument("EGL DMA-BUF readback has no GBM device");
+      }
+      // EGL core entry points need an initial load before a GBM display exists.
+      if (!gladLoaderLoadEGL(EGL_NO_DISPLAY)) {
+        throw std::runtime_error("could not load EGL entry points");
+      }
+
+      if (eglGetPlatformDisplayEXT != nullptr) {
+        display_ = eglGetPlatformDisplayEXT(
+          EGL_PLATFORM_GBM_KHR,
+          reinterpret_cast<EGLNativeDisplayType>(gbm_device),
+          nullptr
+        );
+      }
+      if (display_ == EGL_NO_DISPLAY && eglGetPlatformDisplay != nullptr) {
+        display_ = eglGetPlatformDisplay(
+          EGL_PLATFORM_GBM_KHR,
+          reinterpret_cast<EGLNativeDisplayType>(gbm_device),
+          nullptr
+        );
+      }
+      if (display_ == EGL_NO_DISPLAY) {
+        display_ = eglGetDisplay(reinterpret_cast<EGLNativeDisplayType>(gbm_device));
+      }
+      if (display_ == EGL_NO_DISPLAY) {
+        throw std::runtime_error(egl_error("eglGetDisplay(GBM)"));
+      }
+
+      EGLint major = 0;
+      EGLint minor = 0;
+      if (eglInitialize(display_, &major, &minor) != EGL_TRUE) {
+        const auto error = egl_error("eglInitialize(GBM)");
+        display_ = EGL_NO_DISPLAY;
+        throw std::runtime_error(error);
+      }
+      initialized_ = true;
+      if (!gladLoaderLoadEGL(display_)) {
+        throw std::runtime_error("could not load EGL extensions for GBM display");
+      }
+
+      const auto *extensions = eglQueryString(display_, EGL_EXTENSIONS);
+      if (!has_egl_extension(extensions, "EGL_EXT_image_dma_buf_import")) {
+        throw std::runtime_error("EGL render node lacks EGL_EXT_image_dma_buf_import");
+      }
+      has_modifiers_ = has_egl_extension(extensions, "EGL_EXT_image_dma_buf_import_modifiers");
+      if (eglBindAPI(EGL_OPENGL_API) != EGL_TRUE) {
+        throw std::runtime_error(egl_error("eglBindAPI(OpenGL)"));
+      }
+
+      constexpr EGLint config_attributes[] {
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+        EGL_RED_SIZE, 8,
+        EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8,
+        EGL_ALPHA_SIZE, 8,
+        EGL_NONE,
+      };
+      EGLint config_count = 0;
+      if (eglChooseConfig(display_, config_attributes, &config_, 1, &config_count) != EGL_TRUE ||
+          config_count == 0) {
+        throw std::runtime_error(egl_error("eglChooseConfig"));
+      }
+
+      constexpr EGLint pbuffer_attributes[] {
+        EGL_WIDTH, 1,
+        EGL_HEIGHT, 1,
+        EGL_NONE,
+      };
+      surface_ = eglCreatePbufferSurface(display_, config_, pbuffer_attributes);
+      if (surface_ == EGL_NO_SURFACE) {
+        throw std::runtime_error(egl_error("eglCreatePbufferSurface"));
+      }
+      context_ = eglCreateContext(display_, config_, EGL_NO_CONTEXT, nullptr);
+      if (context_ == EGL_NO_CONTEXT) {
+        throw std::runtime_error(egl_error("eglCreateContext"));
+      }
+      make_current();
+      if (!gladLoadGLContext(&gl_context_, eglGetProcAddress) || !gl_context_.VERSION_3_0) {
+        throw std::runtime_error("EGL render node lacks required OpenGL 3.0 entry points");
+      }
+      image_target_ = reinterpret_cast<egl_image_target_texture_2d_fn>(
+        eglGetProcAddress("glEGLImageTargetTexture2DOES")
+      );
+      if (image_target_ == nullptr) {
+        throw std::runtime_error("EGL render node lacks glEGLImageTargetTexture2DOES");
+      }
+    } catch (...) {
+      // A constructor that fails after eglInitialize() still needs to release
+      // the GBM-backed EGL objects; destructors do not run for an object whose
+      // construction did not complete.
+      destroy();
+      throw;
+    }
+
+    ~egl_readback_t() {
+      destroy();
+    }
+
+    egl_readback_t(const egl_readback_t &) = delete;
+    egl_readback_t &operator=(const egl_readback_t &) = delete;
+
+    void import(int fd,
+                std::uint32_t width,
+                std::uint32_t height,
+                std::uint32_t stride,
+                std::uint32_t fourcc,
+                std::uint64_t modifier) {
+      if (modifier != 0U && !has_modifiers_) {
+        throw std::runtime_error("EGL render node lacks DMA-BUF modifier import support");
+      }
+      make_current();
+      reset_image();
+
+      std::vector<EGLint> attributes {
+        EGL_WIDTH, static_cast<EGLint>(width),
+        EGL_HEIGHT, static_cast<EGLint>(height),
+        EGL_LINUX_DRM_FOURCC_EXT, static_cast<EGLint>(fourcc),
+        EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(stride),
+      };
+      // QEMU emits modifiers only when the producer supplied one.  Do the
+      // same: zero is not an implicit DRM_FORMAT_MOD_LINEAR declaration.
+      if (modifier != 0U) {
+        attributes.push_back(EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT);
+        attributes.push_back(static_cast<EGLint>(modifier & 0xffffffffULL));
+        attributes.push_back(EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT);
+        attributes.push_back(static_cast<EGLint>(modifier >> 32U));
+      }
+      attributes.push_back(EGL_NONE);
+
+      EGLImageKHR image = eglCreateImageKHR(display_, EGL_NO_CONTEXT,
+                                             EGL_LINUX_DMA_BUF_EXT, nullptr,
+                                             attributes.data());
+      if (image == EGL_NO_IMAGE_KHR) {
+        throw std::runtime_error(egl_error("eglCreateImageKHR(DMA-BUF)"));
+      }
+
+      try {
+        gl_context_.GenTextures(1, &source_texture_);
+        gl_context_.BindTexture(GL_TEXTURE_2D, source_texture_);
+        gl_context_.TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        gl_context_.TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        image_target_(GL_TEXTURE_2D, reinterpret_cast<void *>(image));
+        const auto image_target_error = gl_context_.GetError();
+        if (eglDestroyImageKHR(display_, image) != EGL_TRUE) {
+          throw std::runtime_error(egl_error("eglDestroyImageKHR(DMA-BUF)"));
+        }
+        image = EGL_NO_IMAGE_KHR;
+        if (image_target_error != GL_NO_ERROR) {
+          throw std::runtime_error("glEGLImageTargetTexture2DOES failed (GL error " +
+                                   std::to_string(static_cast<unsigned int>(image_target_error)) + ')');
+        }
+
+        gl_context_.GenFramebuffers(1, &source_framebuffer_);
+        gl_context_.BindFramebuffer(GL_FRAMEBUFFER, source_framebuffer_);
+        gl_context_.FramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                         GL_TEXTURE_2D, source_texture_, 0);
+        if (gl_context_.CheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+          throw std::runtime_error("DMA-BUF source framebuffer is incomplete");
+        }
+        check_gl("configure DMA-BUF source framebuffer");
+        ensure_destination(width, height);
+        width_ = width;
+        height_ = height;
+      } catch (...) {
+        if (image != EGL_NO_IMAGE_KHR) {
+          eglDestroyImageKHR(display_, image);
+        }
+        reset_image();
+        throw;
+      }
+    }
+
+    [[nodiscard]] qemu_dbus_dmabuf_frame_t read_full(bool y0_top) {
+      if (source_framebuffer_ == 0U || width_ == 0U || height_ == 0U) {
+        throw std::logic_error("EGL DMA-BUF image is not active");
+      }
+      make_current();
+      gl_context_.BindFramebuffer(GL_READ_FRAMEBUFFER, source_framebuffer_);
+      gl_context_.BindFramebuffer(GL_DRAW_FRAMEBUFFER, destination_framebuffer_);
+      // glReadPixels is bottom-origin.  QEMU's VirGL path advertises
+      // y0_top=false, while a top-origin producer must be inverted here.
+      const auto source_y0 = y0_top ? static_cast<GLint>(height_) : 0;
+      const auto source_y1 = y0_top ? 0 : static_cast<GLint>(height_);
+      gl_context_.BlitFramebuffer(0, source_y0,
+                                  static_cast<GLint>(width_), source_y1,
+                                  0, 0,
+                                  static_cast<GLint>(width_), static_cast<GLint>(height_),
+                                  GL_COLOR_BUFFER_BIT, GL_NEAREST);
+      check_gl("blit DMA-BUF into readback framebuffer");
+
+      const auto byte_count = checked_product(
+        checked_product(width_, 4U, "EGL readback row"), height_, "EGL readback size"
+      );
+      if (byte_count > max_frame_bytes ||
+          byte_count > std::numeric_limits<std::size_t>::max()) {
+        throw std::invalid_argument("EGL DMA-BUF readback exceeds byte limit");
+      }
+      qemu_dbus_dmabuf_frame_t output;
+      output.width = width_;
+      output.height = height_;
+      output.pixels.resize(static_cast<std::size_t>(byte_count));
+      gl_context_.BindFramebuffer(GL_READ_FRAMEBUFFER, destination_framebuffer_);
+      gl_context_.ReadBuffer(GL_COLOR_ATTACHMENT0);
+      gl_context_.PixelStorei(GL_PACK_ALIGNMENT, 1);
+      gl_context_.ReadPixels(0, 0,
+                              static_cast<GLsizei>(width_), static_cast<GLsizei>(height_),
+                              GL_BGRA, GL_UNSIGNED_BYTE, output.pixels.data());
+      gl_context_.PixelStorei(GL_PACK_ALIGNMENT, 4);
+      check_gl("read DMA-BUF framebuffer");
+      for (std::size_t offset = 3U; offset < output.pixels.size(); offset += 4U) {
+        output.pixels[offset] = 255U;
+      }
+      return output;
+    }
+
+    void reset_image() noexcept {
+      if (!make_current_noexcept()) {
+        source_texture_ = 0U;
+        source_framebuffer_ = 0U;
+        width_ = 0U;
+        height_ = 0U;
+        return;
+      }
+      if (source_framebuffer_ != 0U) {
+        gl_context_.DeleteFramebuffers(1, &source_framebuffer_);
+        source_framebuffer_ = 0U;
+      }
+      if (source_texture_ != 0U) {
+        gl_context_.DeleteTextures(1, &source_texture_);
+        source_texture_ = 0U;
+      }
+      width_ = 0U;
+      height_ = 0U;
+    }
+
+    [[nodiscard]] bool active() const noexcept {
+      return source_framebuffer_ != 0U && width_ != 0U && height_ != 0U;
+    }
+
+  private:
+    using egl_image_target_texture_2d_fn = void (*)(GLenum target, void *image);
+
+    void make_current() {
+      if (eglMakeCurrent(display_, surface_, surface_, context_) != EGL_TRUE) {
+        throw std::runtime_error(egl_error("eglMakeCurrent"));
+      }
+    }
+
+    [[nodiscard]] bool make_current_noexcept() noexcept {
+      return display_ != EGL_NO_DISPLAY && surface_ != EGL_NO_SURFACE &&
+             context_ != EGL_NO_CONTEXT &&
+             eglMakeCurrent(display_, surface_, surface_, context_) == EGL_TRUE;
+    }
+
+    void check_gl(std::string_view operation) const {
+      const auto error = gl_context_.GetError();
+      if (error != GL_NO_ERROR) {
+        throw std::runtime_error(std::string(operation) + " failed (GL error " +
+                                 std::to_string(static_cast<unsigned int>(error)) + ')');
+      }
+    }
+
+    void ensure_destination(std::uint32_t width, std::uint32_t height) {
+      if (destination_texture_ != 0U && destination_width_ == width &&
+          destination_height_ == height) {
+        return;
+      }
+      if (destination_framebuffer_ != 0U) {
+        gl_context_.DeleteFramebuffers(1, &destination_framebuffer_);
+        destination_framebuffer_ = 0U;
+      }
+      if (destination_texture_ != 0U) {
+        gl_context_.DeleteTextures(1, &destination_texture_);
+        destination_texture_ = 0U;
+      }
+      destination_width_ = 0U;
+      destination_height_ = 0U;
+
+      gl_context_.GenTextures(1, &destination_texture_);
+      gl_context_.BindTexture(GL_TEXTURE_2D, destination_texture_);
+      gl_context_.TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      gl_context_.TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      gl_context_.TexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8,
+                             static_cast<GLsizei>(width), static_cast<GLsizei>(height),
+                             0, GL_BGRA, GL_UNSIGNED_BYTE, nullptr);
+      gl_context_.GenFramebuffers(1, &destination_framebuffer_);
+      gl_context_.BindFramebuffer(GL_FRAMEBUFFER, destination_framebuffer_);
+      gl_context_.FramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                       GL_TEXTURE_2D, destination_texture_, 0);
+      if (gl_context_.CheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+        throw std::runtime_error("DMA-BUF readback framebuffer is incomplete");
+      }
+      check_gl("configure DMA-BUF readback framebuffer");
+      destination_width_ = width;
+      destination_height_ = height;
+    }
+
+    void destroy() noexcept {
+      reset_image();
+      if (make_current_noexcept()) {
+        if (destination_framebuffer_ != 0U) {
+          gl_context_.DeleteFramebuffers(1, &destination_framebuffer_);
+          destination_framebuffer_ = 0U;
+        }
+        if (destination_texture_ != 0U) {
+          gl_context_.DeleteTextures(1, &destination_texture_);
+          destination_texture_ = 0U;
+        }
+      }
+      if (display_ != EGL_NO_DISPLAY) {
+        eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        if (context_ != EGL_NO_CONTEXT) {
+          eglDestroyContext(display_, context_);
+          context_ = EGL_NO_CONTEXT;
+        }
+        if (surface_ != EGL_NO_SURFACE) {
+          eglDestroySurface(display_, surface_);
+          surface_ = EGL_NO_SURFACE;
+        }
+        if (initialized_) {
+          eglTerminate(display_);
+          initialized_ = false;
+        }
+        display_ = EGL_NO_DISPLAY;
+      }
+    }
+
+    EGLDisplay display_ {EGL_NO_DISPLAY};
+    EGLConfig config_ {};
+    EGLSurface surface_ {EGL_NO_SURFACE};
+    EGLContext context_ {EGL_NO_CONTEXT};
+    GladGLContext gl_context_ {};
+    egl_image_target_texture_2d_fn image_target_ {};
+    GLuint source_texture_ {};
+    GLuint source_framebuffer_ {};
+    GLuint destination_texture_ {};
+    GLuint destination_framebuffer_ {};
+    std::uint32_t width_ {};
+    std::uint32_t height_ {};
+    std::uint32_t destination_width_ {};
+    std::uint32_t destination_height_ {};
+    bool initialized_ {};
+    bool has_modifiers_ {};
+  };
+
+  qemu_dbus_dmabuf_readback_t::qemu_dbus_dmabuf_readback_t(std::string render_node):
+      render_node_ {std::move(render_node)} {
+    if (render_node_.empty()) {
+      throw std::invalid_argument("DMA-BUF render node is empty");
+    }
+    render_fd_ = ::open(render_node_.c_str(), O_RDWR | O_CLOEXEC);
+    if (render_fd_ < 0) {
+      throw std::system_error(errno, std::generic_category(),
+                              "open DMA-BUF render node " + render_node_);
+    }
+    gbm_device_ = gbm_create_device(render_fd_);
+    if (gbm_device_ == nullptr) {
+      const auto saved_errno = errno == 0 ? ENODEV : errno;
+      close_fd(render_fd_);
+      throw std::system_error(saved_errno, std::generic_category(),
+                              "gbm_create_device for " + render_node_);
+    }
+  }
+
+  qemu_dbus_dmabuf_readback_t::~qemu_dbus_dmabuf_readback_t() {
+    reset();
+    // The EGL display borrows GBM's native display, so tear it down first.
+    egl_readback_.reset();
+    if (gbm_device_ != nullptr) {
+      gbm_device_destroy(gbm_device_);
+      gbm_device_ = nullptr;
+    }
+    close_fd(render_fd_);
+  }
+
+  qemu_dbus_dmabuf_frame_t qemu_dbus_dmabuf_readback_t::scanout(
+    int owned_fd,
+    std::uint32_t width,
+    std::uint32_t height,
+    std::uint32_t stride,
+    std::uint32_t fourcc,
+    std::uint64_t modifier,
+    bool y0_top
+  ) {
+    if (owned_fd < 0) {
+      throw std::invalid_argument("DMA-BUF scanout has no file descriptor");
+    }
+    try {
+      validate_scanout(width, height, stride, fourcc);
+      reset();
+      if (!egl_readback_) {
+        egl_readback_ = std::make_unique<egl_readback_t>(gbm_device_);
+      }
+      egl_readback_->import(owned_fd, width, height, stride, fourcc, modifier);
+      scanout_fd_ = owned_fd;
+      owned_fd = -1;
+      width_ = width;
+      height_ = height;
+      stride_ = stride;
+      fourcc_ = fourcc;
+      modifier_ = modifier;
+      y0_top_ = y0_top;
+      return egl_readback_->read_full(y0_top_);
+    } catch (...) {
+      close_fd(owned_fd);
+      reset();
+      throw;
+    }
+  }
+
+  qemu_dbus_dmabuf_frame_t qemu_dbus_dmabuf_readback_t::update(
+    std::int32_t x,
+    std::int32_t y,
+    std::int32_t width,
+    std::int32_t height
+  ) {
+    if (!active()) {
+      throw std::logic_error("DMA-BUF update arrived before scanout");
+    }
+    validate_damage(x, y, width, height, width_, height_);
+    // QEMU's callback has already synchronized the producer before this
+    // reply.  A complete reread is a bounded correctness-first implementation
+    // until damage origin/stride behavior is independently qualified.
+    return egl_readback_->read_full(y0_top_);
+  }
+
+  void qemu_dbus_dmabuf_readback_t::reset() noexcept {
+    if (egl_readback_) {
+      egl_readback_->reset_image();
+    }
+    close_fd(scanout_fd_);
+    width_ = 0U;
+    height_ = 0U;
+    stride_ = 0U;
+    fourcc_ = 0U;
+    modifier_ = 0U;
+    y0_top_ = true;
+  }
+
+  bool qemu_dbus_dmabuf_readback_t::active() const noexcept {
+    return scanout_fd_ >= 0 && egl_readback_ != nullptr && egl_readback_->active();
+  }
+}  // namespace platf
