+/**
+ * @file src/platform/linux/qemu_dbus_dmabuf.h
+ * @brief Headless EGL readback for QEMU Display1 single-plane DMA-BUF scanouts.
+ */
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct gbm_device;
+
+namespace platf {
+  /**
+   * A normalized, tightly packed BGRX CPU image.  This is deliberately the
+   * boundary between QEMU's native scanout and Sunshine's existing software
+   * encoder path; no host window system is involved.
+   */
+  struct qemu_dbus_dmabuf_frame_t {
+    std::vector<std::uint8_t> pixels;
+    std::uint32_t width {};
+    std::uint32_t height {};
+  };
+
+  /**
+   * Import a QEMU Display1 ScanoutDMABUF through EGL_EXT_image_dma_buf_import
+   * on a render node, then synchronously read it into a BGRX CPU image.
+   *
+   * QEMU's UpdateDMABUF only describes damage.  The implementation rereads a
+   * complete normalized image on each update: this is intentionally CPU-first
+   * and avoids mixing the producer's origin with GL's readback origin.
+   */
+  class qemu_dbus_dmabuf_readback_t final {
+  public:
+    explicit qemu_dbus_dmabuf_readback_t(std::string render_node);
+    ~qemu_dbus_dmabuf_readback_t();
+
+    qemu_dbus_dmabuf_readback_t(const qemu_dbus_dmabuf_readback_t &) = delete;
+    qemu_dbus_dmabuf_readback_t &operator=(const qemu_dbus_dmabuf_readback_t &) = delete;
+
+    [[nodiscard]] qemu_dbus_dmabuf_frame_t scanout(int owned_fd,
+                                                    std::uint32_t width,
+                                                    std::uint32_t height,
+                                                    std::uint32_t stride,
+                                                    std::uint32_t fourcc,
+                                                    std::uint64_t modifier,
+                                                    bool y0_top);
+    [[nodiscard]] qemu_dbus_dmabuf_frame_t update(std::int32_t x,
+                                                   std::int32_t y,
+                                                   std::int32_t width,
+                                                   std::int32_t height);
+
+    void reset() noexcept;
+    [[nodiscard]] bool active() const noexcept;
+
+  private:
+    struct egl_readback_t;
+
+    std::string render_node_;
+    int render_fd_ {-1};
+    ::gbm_device *gbm_device_ {};
+    int scanout_fd_ {-1};
+    std::uint32_t width_ {};
+    std::uint32_t height_ {};
+    std::uint32_t stride_ {};
+    std::uint32_t fourcc_ {};
+    std::uint64_t modifier_ {};
+    bool y0_top_ {true};
+    std::unique_ptr<egl_readback_t> egl_readback_;
+  };
+}  // namespace platf
