From a41988824e0ee4c07c844c2d9c90030b0c351449 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 1 Sep 2026 13:03:24 +0000
Subject: [PATCH] platform/linux: add QEMU Display1 DMA-BUF EGL readback

---
 cmake/compile_definitions/linux.cmake   |  30 +-
 cmake/prep/options.cmake                |   2 +
 src/platform/linux/qemu_dbus.cpp        | 235 +++++++++-
 src/platform/linux/qemu_dbus_dmabuf.cpp | 568 ++++++++++++++++++++++++
 src/platform/linux/qemu_dbus_dmabuf.h   |  72 +++
 5 files changed, 886 insertions(+), 21 deletions(-)
 create mode 100644 src/platform/linux/qemu_dbus_dmabuf.cpp
 create mode 100644 src/platform/linux/qemu_dbus_dmabuf.h

diff --git a/cmake/compile_definitions/linux.cmake b/cmake/compile_definitions/linux.cmake
index 3ff36c4..44cb206 100644
--- a/cmake/compile_definitions/linux.cmake
+++ b/cmake/compile_definitions/linux.cmake
@@ -251,10 +251,11 @@ if(GIO_FOUND)
     list(APPEND PLATFORM_LIBRARIES ${GIO_LIBRARIES})
 endif()
 
-# QEMU Display1 D-Bus CPU capture.  GIO is already a baseline Linux
-# dependency for Sunshine, so this backend introduces no additional client
-# library.  It intentionally supports system-memory capture first; DMA-BUF is
-# a later optimization once the stock software path is qualified.
+# QEMU Display1 D-Bus capture.  GIO is already a baseline Linux dependency.
+# System-memory Scanout remains available without GBM/DRM.  When the optional
+# headers/libraries are installed, QEMU's single-plane ScanoutDMABUF is
+# imported by a headless EGL context and copied into the same CPU BGRX encoder
+# path; no X11 or Wayland dependency is introduced.
 set(QEMU_DBUS_FOUND OFF)
 if(${SUNSHINE_ENABLE_QEMU_DBUS})
     set(QEMU_DBUS_FOUND ON)
@@ -262,6 +263,27 @@ if(${SUNSHINE_ENABLE_QEMU_DBUS})
     list(APPEND PLATFORM_TARGET_FILES
             "${CMAKE_SOURCE_DIR}/src/platform/linux/qemu_dbus.h"
             "${CMAKE_SOURCE_DIR}/src/platform/linux/qemu_dbus.cpp")
+
+    if(${SUNSHINE_ENABLE_QEMU_DBUS_DMABUF})
+        pkg_check_modules(QEMU_DBUS_GBM QUIET IMPORTED_TARGET gbm)
+        pkg_check_modules(QEMU_DBUS_DRM QUIET IMPORTED_TARGET libdrm)
+        if(QEMU_DBUS_GBM_FOUND AND QEMU_DBUS_DRM_FOUND)
+            add_compile_definitions(SUNSHINE_BUILD_QEMU_DBUS_DMABUF)
+            include_directories(SYSTEM
+                    ${QEMU_DBUS_GBM_INCLUDE_DIRS}
+                    ${QEMU_DBUS_DRM_INCLUDE_DIRS})
+            list(APPEND PLATFORM_LIBRARIES
+                    PkgConfig::QEMU_DBUS_GBM
+                    PkgConfig::QEMU_DBUS_DRM)
+            list(APPEND PLATFORM_TARGET_FILES
+                    "${CMAKE_SOURCE_DIR}/src/platform/linux/qemu_dbus_dmabuf.h"
+                    "${CMAKE_SOURCE_DIR}/src/platform/linux/qemu_dbus_dmabuf.cpp")
+            list(APPEND SUNSHINE_DEFINITIONS EGL_NO_X11=1)
+            message(STATUS "QEMU Display1 DMA-BUF: enabled (headless EGL CPU readback)")
+        else()
+            message(STATUS "QEMU Display1 DMA-BUF: disabled (gbm and libdrm development packages are required)")
+        endif()
+    endif()
 endif()
 
 # Pipewire
diff --git a/cmake/prep/options.cmake b/cmake/prep/options.cmake
