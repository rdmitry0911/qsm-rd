From 2dfd2d7cd8bd94b07c236451afbc22ccedbdc9f2 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 1 Sep 2026 13:12:40 +0000
Subject: [PATCH] cmake: avoid X11 FFmpeg glue for software builds

---
 cmake/dependencies/ffmpeg.cmake | 37 ++++++++++++++++++++-------------
 1 file changed, 23 insertions(+), 14 deletions(-)

diff --git a/cmake/dependencies/ffmpeg.cmake b/cmake/dependencies/ffmpeg.cmake
index 291a6e5..f18c357 100644
--- a/cmake/dependencies/ffmpeg.cmake
+++ b/cmake/dependencies/ffmpeg.cmake
@@ -3,17 +3,32 @@
 #
 include_guard(GLOBAL)
 
-# ffmpeg pre-compiled binaries
-if(NOT DEFINED FFMPEG_PREPARED_BINARIES)
-    # Set platform-specific libraries
+function(sunshine_configure_ffmpeg_platform_libraries)
     if(WIN32)
-        set(FFMPEG_PLATFORM_LIBRARIES mfplat ole32 strmiids mfuuid vpl)
+        set(_sunshine_ffmpeg_platform_libraries mfplat ole32 strmiids mfuuid vpl)
     elseif(FREEBSD)
-        # numa is not available on FreeBSD
-        set(FFMPEG_PLATFORM_LIBRARIES va va-drm va-x11 X11)
+        # The bundled static FFmpeg needs libva even when Sunshine's VAAPI
+        # backend is disabled. Only the VAAPI backend needs libva's X11 glue.
+        set(_sunshine_ffmpeg_platform_libraries va va-drm)
+        if(SUNSHINE_ENABLE_VAAPI)
+            list(APPEND _sunshine_ffmpeg_platform_libraries va-x11 X11)
+        endif()
     elseif(UNIX AND NOT APPLE)
-        set(FFMPEG_PLATFORM_LIBRARIES numa va va-drm va-x11 X11)
+        # The bundled static FFmpeg pulls VAAPI objects through its codec
+        # registry, so core libva/libva-drm remain link requirements. Keep its
+        # X11 backend out of a software-only QEMU Display1 deployment.
+        set(_sunshine_ffmpeg_platform_libraries numa va va-drm)
+        if(SUNSHINE_ENABLE_VAAPI)
+            list(APPEND _sunshine_ffmpeg_platform_libraries va-x11 X11)
+        endif()
     endif()
+    set(FFMPEG_PLATFORM_LIBRARIES "${_sunshine_ffmpeg_platform_libraries}" PARENT_SCOPE)
+endfunction()
+
+# ffmpeg pre-compiled binaries
+if(NOT DEFINED FFMPEG_PREPARED_BINARIES)
+    # Set platform-specific libraries
+    sunshine_configure_ffmpeg_platform_libraries()
 
     # Determine download location
     set(FFMPEG_DOWNLOAD_DIR "${CMAKE_BINARY_DIR}/_deps")
@@ -137,13 +152,7 @@ else()
 
     # Set platform-specific libraries
     if(NOT DEFINED FFMPEG_PLATFORM_LIBRARIES)
-        if(WIN32)
-            set(FFMPEG_PLATFORM_LIBRARIES mfplat ole32 strmiids mfuuid vpl)
-        elseif(FREEBSD)
-            set(FFMPEG_PLATFORM_LIBRARIES va va-drm va-x11 X11)
-        elseif(UNIX AND NOT APPLE)
-            set(FFMPEG_PLATFORM_LIBRARIES numa va va-drm va-x11 X11)
-        endif()
+        sunshine_configure_ffmpeg_platform_libraries()
     endif()
 
     # Set base FFmpeg libraries (always required)
-- 
2.43.0

