From 11aa0b1ff115b86160c4d37e7c37e6a6b13b77ea Mon Sep 17 00:00:00 2001
From: q-sunshine integration <noreply@example.invalid>
Date: Mon, 1 Sep 2026 00:00:00 +0000
Subject: [PATCH] ui: add opt-in surfaceless inline D-Bus VirGL fallback

When a host deliberately does not expose a DRM render node, QEMU's normal
DMABUF route cannot initialise.  Keep that route unchanged, but provide an
explicit development-only Mesa surfaceless EGL fallback selected solely by
QEMU_EGL_SURFACELESS_FALLBACK=1.

The fallback consumes GL scanout with egl-headless and publishes the resulting
ordinary CPU surface through D-Bus Display1.  It is intentionally inline data,
not a DMABUF shortcut, and is useful for headless CI / restricted LXC
environments.  It is never selected automatically.

Base-commit: 11aa0b1ff115b86160c4d37e7c37e6a6b13b77ea
---
 include/ui/egl-helpers.h | 11 ++++++++++
 ui/dbus-console.c        | 18 +++++++++++++++++
 ui/dbus-listener.c       |  2 +-
 ui/dbus.c                |  7 ++++++-
 ui/dbus.h                |  1 +
 ui/egl-headless.c        | 34 +++++++++++++++++++---------------
 ui/egl-helpers.c         | 69 ++++++++++++++++++++++++++++++++++++++---------
 7 files changed, 115 insertions(+), 27 deletions(-)

diff --git a/include/ui/egl-helpers.h b/include/ui/egl-helpers.h
index 4b8c0d2..1042b7a 100644
--- a/include/ui/egl-helpers.h
+++ b/include/ui/egl-helpers.h
@@ -72,6 +72,17 @@ int qemu_egl_init_dpy_win32(EGLNativeDisplayType dpy, DisplayGLMode mode);
 EGLContext qemu_egl_init_ctx(void);
 bool qemu_egl_has_dmabuf(void);
 
+/*
+ * Explicit development fallback for hosts which deliberately expose no DRM
+ * render node.  It is only enabled by QEMU_EGL_SURFACELESS_FALLBACK=1 and
+ * uses a surfaceless EGL implementation (normally Mesa llvmpipe).  Callers
+ * use this to select an inline CPU transport instead of DMABUF export.
+ */
+bool qemu_egl_software_fallback_enabled(void);
+
+/* Attach the EGL headless readback listener to one graphic console. */
+void qemu_egl_headless_attach_console(QemuConsole *con);
+
 bool egl_init(const char *rendernode, DisplayGLMode mode, Error **errp);
 
 const char *qemu_egl_get_error_string(void);
diff --git a/ui/dbus-console.c b/ui/dbus-console.c
index 49da9cc..762b488 100644
--- a/ui/dbus-console.c
+++ b/ui/dbus-console.c
@@ -28,6 +28,10 @@
 #include "ui/kbd-state.h"
 #include "trace.h"
 
+#ifdef CONFIG_OPENGL
+#include "ui/egl-helpers.h"
+#endif
+
 #ifdef G_OS_UNIX
 #include <gio/gunixfdlist.h>
 #endif
@@ -134,6 +138,15 @@ const DisplayChangeListenerOps dbus_console_dcl_ops = {
     .dpy_gl_update           = dbus_gl_scanout_update,
 };
 
+/* The headless EGL fallback itself consumes GL scanout and writes it to the
+ * ordinary console surface.  This observer only needs 2D size notifications.
+ */
+static const DisplayChangeListenerOps dbus_console_inline_dcl_ops = {
+    .dpy_name                = "dbus-console-inline",
+    .dpy_gfx_switch          = dbus_gfx_switch,
+    .dpy_gfx_update          = dbus_gfx_update,
+};
+
 static void
 dbus_display_console_init(DBusDisplayConsole *object)
 {
@@ -558,6 +571,11 @@ dbus_display_console_new(DBusDisplay *display, QemuConsole *con)
                         NULL);
     ddc->display = display;
     ddc->dcl.con = con;
+#ifdef CONFIG_OPENGL
+    if (display->inline_gl) {
+        ddc->dcl.ops = &dbus_console_inline_dcl_ops;
+    }
+#endif
     /* handle errors, and skip non graphics? */
     qemu_console_fill_device_address(
         con, device_addr, sizeof(device_addr), NULL);
diff --git a/ui/dbus-listener.c b/ui/dbus-listener.c
index 18f556a..1c8ce4f 100644
--- a/ui/dbus-listener.c
+++ b/ui/dbus-listener.c
@@ -803,7 +803,7 @@ dbus_display_listener_constructed(GObject *object)
 
     ddl->dcl.ops = &dbus_dcl_ops;
 #ifdef CONFIG_OPENGL
-    if (display_opengl) {
+    if (display_opengl && !qemu_egl_software_fallback_enabled()) {
         ddl->dcl.ops = &dbus_gl_dcl_ops;
     }
 #endif
diff --git a/ui/dbus.c b/ui/dbus.c
index e08b5de..ee85906 100644
--- a/ui/dbus.c
+++ b/ui/dbus.c
@@ -120,6 +120,7 @@ dbus_display_init(Object *o)
 
 #ifdef CONFIG_OPENGL
     dd->glctx.ops = &dbus_gl_ops;
+    dd->inline_gl = qemu_egl_software_fallback_enabled();
     if (display_opengl) {
         dd->glctx.gls = qemu_gl_init_shader();
     }
@@ -177,7 +178,11 @@ dbus_display_add_console(DBusDisplay *dd, int idx, Error **errp)
 
     if (qemu_console_is_graphic(con) &&
         dd->gl_mode != DISPLAYGL_MODE_OFF) {
-        qemu_console_set_display_gl_ctx(con, &dd->glctx);
+        if (dd->inline_gl) {
+            qemu_egl_headless_attach_console(con);
+        } else {
+            qemu_console_set_display_gl_ctx(con, &dd->glctx);
+        }
     }
 
     dbus_console = dbus_display_console_new(dd, con);
diff --git a/ui/dbus.h b/ui/dbus.h
index d5637da..dd992ca 100644
--- a/ui/dbus.h
+++ b/ui/dbus.h
@@ -43,6 +43,7 @@ struct DBusDisplay {
     Object parent;
 
     DisplayGLMode gl_mode;
+    bool inline_gl;
     bool p2p;
     char *dbus_addr;
     char *audiodev;
diff --git a/ui/egl-headless.c b/ui/egl-headless.c
index d5637da..dd992ca 100644
--- a/ui/egl-headless.c
+++ b/ui/egl-headless.c
@@ -207,28 +207,36 @@ static void early_egl_headless_init(DisplayOptions *opts)
     egl_init(opts->u.egl_headless.rendernode, mode, &error_fatal);
 }
 
-static void egl_headless_init(DisplayState *ds, DisplayOptions *opts)
+void qemu_egl_headless_attach_console(QemuConsole *con)
 {
-    QemuConsole *con;
     egl_dpy *edpy;
+    DisplayGLCtx *ctx;
+
+    if (!qemu_console_is_graphic(con)) {
+        return;
+    }
+
+    edpy = g_new0(egl_dpy, 1);
+    edpy->dcl.con = con;
+    edpy->dcl.ops = &egl_ops;
+    edpy->gls = qemu_gl_init_shader();
+    ctx = g_new0(DisplayGLCtx, 1);
+    ctx->ops = &eglctx_ops;
+    qemu_console_set_display_gl_ctx(con, ctx);
+    register_displaychangelistener(&edpy->dcl);
+}
+
+static void egl_headless_init(DisplayState *ds, DisplayOptions *opts)
+{
     int idx;
 
     for (idx = 0;; idx++) {
-        DisplayGLCtx *ctx;
+        QemuConsole *con = qemu_console_lookup_by_index(idx);
 
-        con = qemu_console_lookup_by_index(idx);
         if (!con || !qemu_console_is_graphic(con)) {
             break;
         }
-
-        edpy = g_new0(egl_dpy, 1);
-        edpy->dcl.con = con;
-        edpy->dcl.ops = &egl_ops;
-        edpy->gls = qemu_gl_init_shader();
-        ctx = g_new0(DisplayGLCtx, 1);
-        ctx->ops = &eglctx_ops;
-        qemu_console_set_display_gl_ctx(con, ctx);
-        register_displaychangelistener(&edpy->dcl);
+        qemu_egl_headless_attach_console(con);
     }
 }
 
diff --git a/ui/egl-helpers.c b/ui/egl-helpers.c
index 3d19dbe..bccfe5d 100644
--- a/ui/egl-helpers.c
+++ b/ui/egl-helpers.c
@@ -217,6 +217,12 @@ void egl_texture_blend(QemuGLShader *gls, egl_fb *dst, egl_fb *src, bool flip,
 /* ---------------------------------------------------------------------- */
 
 EGLContext qemu_egl_rn_ctx;
+static bool qemu_egl_software_fallback;
+
+bool qemu_egl_software_fallback_enabled(void)
+{
+    return qemu_egl_software_fallback;
+}
 
 #ifdef CONFIG_GBM
 
@@ -469,10 +475,11 @@ static EGLDisplay qemu_egl_get_display(EGLNativeDisplayType native,
 
 static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
                              EGLenum platform,
+                             EGLint surface_type,
                              DisplayGLMode mode)
 {
-    static const EGLint conf_att_core[] = {
-        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+    EGLint conf_att_core[] = {
+        EGL_SURFACE_TYPE, 0,
         EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
         EGL_RED_SIZE,   5,
         EGL_GREEN_SIZE, 5,
@@ -480,8 +487,8 @@ static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
         EGL_ALPHA_SIZE, 0,
         EGL_NONE,
     };
-    static const EGLint conf_att_gles[] = {
-        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+    EGLint conf_att_gles[] = {
+        EGL_SURFACE_TYPE, 0,
         EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
         EGL_RED_SIZE,   5,
         EGL_GREEN_SIZE, 5,
@@ -494,6 +501,12 @@ static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
     EGLint n;
     bool gles = (mode == DISPLAYGL_MODE_ES);
 
+    /* The surfaceless fallback has no native window.  Its config only needs
+     * to support a pbuffer even though contexts are made current without one.
+     */
+    conf_att_core[1] = surface_type;
+    conf_att_gles[1] = surface_type;
+
     qemu_egl_display = qemu_egl_get_display(dpy, platform);
     if (qemu_egl_display == EGL_NO_DISPLAY) {
         error_report("egl: eglGetDisplay failed: %s", qemu_egl_get_error_string());
@@ -532,18 +545,32 @@ static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
 int qemu_egl_init_dpy_x11(EGLNativeDisplayType dpy, DisplayGLMode mode)
 {
 #ifdef EGL_KHR_platform_x11
-    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_X11_KHR, mode);
+    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_X11_KHR,
+                             EGL_WINDOW_BIT, mode);
 #else
-    return qemu_egl_init_dpy(dpy, 0, mode);
+    return qemu_egl_init_dpy(dpy, 0, EGL_WINDOW_BIT, mode);
 #endif
 }
 
 int qemu_egl_init_dpy_mesa(EGLNativeDisplayType dpy, DisplayGLMode mode)
 {
 #ifdef EGL_MESA_platform_gbm
-    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_GBM_MESA, mode);
+    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_GBM_MESA,
+                             EGL_WINDOW_BIT, mode);
+#else
+    return qemu_egl_init_dpy(dpy, 0, EGL_WINDOW_BIT, mode);
+#endif
+}
+
+static int qemu_egl_init_dpy_surfaceless(DisplayGLMode mode)
+{
+#ifdef EGL_PLATFORM_SURFACELESS_MESA
+    return qemu_egl_init_dpy(EGL_DEFAULT_DISPLAY,
+                             EGL_PLATFORM_SURFACELESS_MESA,
+                             EGL_PBUFFER_BIT, mode);
 #else
-    return qemu_egl_init_dpy(dpy, 0, mode);
+    error_report("egl: EGL_PLATFORM_SURFACELESS_MESA is unavailable");
+    return -1;
 #endif
 }
 #endif
@@ -557,7 +584,7 @@ int qemu_egl_init_dpy_win32(EGLNativeDisplayType dpy, DisplayGLMode mode)
         mode = DISPLAYGL_MODE_ES;
     }
 
-    if (qemu_egl_init_dpy(dpy, 0, mode) < 0) {
+    if (qemu_egl_init_dpy(dpy, 0, EGL_WINDOW_BIT, mode) < 0) {
         return -1;
     }
 
@@ -647,9 +674,27 @@ bool egl_init(const char *rendernode, DisplayGLMode mode, Error **errp)
         return false;
     }
 #elif defined(CONFIG_GBM)
-    if (egl_rendernode_init(rendernode, mode) < 0) {
-        error_setg(errp, "egl: render node init failed");
-        return false;
+    if (g_strcmp0(g_getenv("QEMU_EGL_SURFACELESS_FALLBACK"), "1") == 0) {
+        if (qemu_egl_init_dpy_surfaceless(mode) < 0) {
+            error_setg(errp, "egl: surfaceless fallback init failed");
+            return false;
+        }
+        if (!epoxy_has_egl_extension(qemu_egl_display,
+                                     "EGL_KHR_surfaceless_context")) {
+            error_setg(errp, "egl: surfaceless contexts are unavailable");
+            return false;
+        }
+        qemu_egl_rn_ctx = qemu_egl_init_ctx();
+        if (!qemu_egl_rn_ctx) {
+            error_setg(errp, "egl: surfaceless context init failed");
+            return false;
+        }
+        qemu_egl_software_fallback = true;
+    } else {
+        if (egl_rendernode_init(rendernode, mode) < 0) {
+            error_setg(errp, "egl: render node init failed");
+            return false;
+        }
     }
 #endif
 
