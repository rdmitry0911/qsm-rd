#!/usr/bin/perl -T
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Optional diagnostic CLI.  Stock /usr/bin/pvesh starts its own Perl process,
# so it cannot see a runtime registry extension loaded solely by pveproxy and
# pvedaemon.  This launcher makes the same route visible without modifying
# pvesh or Perl's global site configuration.

$ENV{'PATH'} = '/sbin:/bin:/usr/sbin:/usr/bin';
delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};

use strict;
use warnings;

use lib '/usr/lib/q-sunshine/pve9-api';

sub _exec_stock_pvesh {
    my ($reason) = @_;
    $reason = 'unsupported PVE environment' if !defined($reason) ||
        $reason !~ /\A[A-Za-z0-9 ._-]{1,128}\z/;
    my @arguments;
    for my $argument (@ARGV) {
        my ($clean) = $argument =~ m{\A([A-Za-z0-9][A-Za-z0-9._@%+=,/:?&-]{0,1023})\z};
        die "q-sunshine PVE API launcher refused unsafe stock arguments\n"
            if !defined($clean);
        push @arguments, $clean;
    }
    print STDERR "q-sunshine PVE API disabled: $reason; executing stock pvesh\n";
    exec { '/usr/bin/pvesh' } '/usr/bin/pvesh', @arguments;
    die "q-sunshine PVE API stock fallback failed: $!\n";
}

my $compatibility_loaded = eval { require PVE::QSunshine::Compatibility; 1; };
_exec_stock_pvesh('compatibility module unavailable') if !$compatibility_loaded;
my ($supported, $reason) = (0, 'compatibility check failed');
my $compatibility_checked = eval {
    ($supported, $reason) = PVE::QSunshine::Compatibility->supported('pvesh');
    1;
};
if (!$compatibility_checked || !$supported) {
    eval { PVE::QSunshine::Compatibility->exec_stock('pvesh', $reason, @ARGV); 1; };
    _exec_stock_pvesh('compatibility stock fallback failed');
}

my $pve_loaded = eval {
    require PVE::API2::QSunshine;
    require PVE::CLI::pvesh;
    1;
};
_exec_stock_pvesh('PVE extension could not be loaded') if !$pve_loaded;

PVE::CLI::pvesh->run_cli_handler();
