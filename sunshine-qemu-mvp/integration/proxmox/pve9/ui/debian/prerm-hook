#!/bin/sh
# Source this from q-sunshine-pve's prerm before removing the static overlay.
# Refuse removal if the package cannot prove that it owns the patched template:
# leaving the package installed is safer than removing its JS while an unknown
# diversion still references it.
set -eu

case "${1:-}" in
    remove|deconfigure|purge)
        /usr/sbin/q-sunshine-pve-ui remove
        ;;
esac
