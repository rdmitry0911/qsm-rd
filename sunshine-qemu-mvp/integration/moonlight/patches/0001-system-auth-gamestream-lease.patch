diff --git a/app/backend/gamestreamlease.h b/app/backend/gamestreamlease.h
new file mode 100644
index 0000000..d441aa0
--- /dev/null
+++ b/app/backend/gamestreamlease.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Ephemeral q-sunshine GameStream system-auth certificate lease.
+
+#pragma once
+
+#include <QByteArray>
+#include <QSslCertificate>
+#include <QString>
+
+// This deliberately is not a QObject.  There is one lease per Moonlight
+// process, it is acquired before the UI starts, and its key material must
+// never become a property, signal payload, QSettings value, or file.
+class GameStreamLease final
+{
+public:
+    // A partial configuration is an error, rather than a request to fall back
+    // to Moonlight's persistent pairing identity.
+    static bool requested();
+
+    // Reads a one-shot ticket from QSM_GAMESTREAM_TICKET_FD, creates an RSA
+    // key and CSR locally, and obtains the signed leaf over authenticated TLS.
+    // On failure, `error` contains no password, ticket, or certificate data.
+    static bool acquire(GameStreamLease* lease, QString* error);
+
+    bool isValid() const;
+    const QByteArray& clientCertificatePem() const;
+    const QByteArray& clientPrivateKeyPem() const;
+    QSslCertificate sunshineServerCertificate() const;
+    QString host() const;
+    quint16 httpsPort() const;
+    qint64 expiresAtUnixMs() const;
+
+    // Avoid accidental copies of a private key.  IdentityManager takes the
+    // finished object by move before any GameStream connection is created.
+    GameStreamLease() = default;
+    GameStreamLease(const GameStreamLease&) = delete;
+    GameStreamLease& operator=(const GameStreamLease&) = delete;
+    GameStreamLease(GameStreamLease&&) = default;
+    GameStreamLease& operator=(GameStreamLease&&) = default;
+    ~GameStreamLease();
+
+private:
+    void clear();
+
+    QByteArray m_ClientCertificatePem;
+    QByteArray m_ClientPrivateKeyPem;
+    QSslCertificate m_SunshineServerCertificate;
+    QString m_Host;
+    quint16 m_HttpsPort = 0;
+    qint64 m_ExpiresAtUnixMs = 0;
+};

diff --git a/app/backend/gamestreamlease.cpp b/app/backend/gamestreamlease.cpp
new file mode 100644
index 0000000..9516c30
--- /dev/null
+++ b/app/backend/gamestreamlease.cpp
@@ -0,0 +1,649 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PIN-free, short-lived GameStream mTLS identity acquisition for q-sunshine.
+
+#include "gamestreamlease.h"
+
+#include <QDateTime>
+#include <QElapsedTimer>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonParseError>
+#include <QRegularExpression>
+#include <QSet>
+#include <QSslConfiguration>
+#include <QSslKey>
+#include <QSslSocket>
+
+#include <cmath>
+#include <ctime>
+#include <limits>
+#include <utility>
+
+#ifdef Q_OS_UNIX
+#include <cerrno>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#endif
+
+#include <openssl/pem.h>
+#include <openssl/rsa.h>
+#include <openssl/x509.h>
+#include <openssl/x509v3.h>
+
+namespace {
+
+constexpr int kMaxTicketBytes = 2048;
+constexpr int kMaxRequestBytes = 20 * 1024;
+constexpr int kMaxResponseBytes = 40 * 1024;
+constexpr int kMaxCaBytes = 64 * 1024;
+constexpr int kConnectTimeoutMs = 12 * 1000;
+constexpr int kRequestTimeoutMs = 12 * 1000;
+constexpr qint64 kMinimumLeaseRemainingMs = 30 * 1000;
+constexpr qint64 kMaximumLeaseLifetimeMs = 15 * 60 * 1000 + 30 * 1000;
+
+constexpr const char* kAuthHost = "QSM_GAMESTREAM_AUTH_HOST";
+constexpr const char* kAuthPort = "QSM_GAMESTREAM_AUTH_PORT";
+constexpr const char* kAuthSni = "QSM_GAMESTREAM_AUTH_SNI";
+constexpr const char* kAuthCaFile = "QSM_GAMESTREAM_AUTH_CA_FILE";
+constexpr const char* kAudience = "QSM_GAMESTREAM_AUDIENCE";
+constexpr const char* kTicketFd = "QSM_GAMESTREAM_TICKET_FD";
+constexpr const char* kHost = "QSM_GAMESTREAM_HOST";
+constexpr const char* kHttpsPort = "QSM_GAMESTREAM_HTTPS_PORT";
+
+const char* const kEnvironmentNames[] = {
+    kAuthHost, kAuthPort, kAuthSni, kAuthCaFile, kAudience, kTicketFd, kHost, kHttpsPort,
+};
+
+void secureClear(QByteArray& value)
+{
+    value.fill('\0');
+    value.clear();
+}
+
+bool containsControl(const QString& value)
+{
+    for (const QChar character : value) {
+        if (character.isNull() || character.category() == QChar::Other_Control ||
+            character.isSpace()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool validAudience(const QString& value)
+{
+    static const QRegularExpression pattern(
+        QStringLiteral("\\A[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\\z"));
+    return pattern.match(value).hasMatch();
+}
+
+bool validHost(const QString& value)
+{
+    return !value.isEmpty() && value.size() <= 255 && !containsControl(value);
+}
+
+bool parsePort(const QString& value, quint16* port)
+{
+    static const QRegularExpression pattern(QStringLiteral("\\A[0-9]{1,5}\\z"));
+    bool converted = false;
+    const int candidate = value.toInt(&converted);
+    if (!converted || !pattern.match(value).hasMatch() || candidate < 1 || candidate > 65535) {
+        return false;
+    }
+    *port = static_cast<quint16>(candidate);
+    return true;
+}
+
+bool parseInteger(const QJsonValue& value, qint64 minimum, qint64 maximum, qint64* result)
+{
+    if (!value.isDouble()) {
+        return false;
+    }
+    const double number = value.toDouble();
+    if (!std::isfinite(number) || std::floor(number) != number ||
+        number < static_cast<double>(minimum) || number > static_cast<double>(maximum)) {
+        return false;
+    }
+    *result = static_cast<qint64>(number);
+    return true;
+}
+
+bool readTicketFromFd(QString fdValue, QByteArray* ticket, QString* error)
+{
+#ifndef Q_OS_UNIX
+    Q_UNUSED(fdValue);
+    Q_UNUSED(ticket);
+    *error = QStringLiteral("q-sunshine system-auth leases require an inherited ticket descriptor on this platform");
+    return false;
+#else
+    static const QRegularExpression pattern(QStringLiteral("\\A[0-9]{1,9}\\z"));
+    bool converted = false;
+    const int descriptor = fdValue.toInt(&converted);
+    if (!converted || !pattern.match(fdValue).hasMatch() || descriptor < 0) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth ticket descriptor");
+        return false;
+    }
+
+    const int descriptorFlags = fcntl(descriptor, F_GETFD);
+    const int statusFlags = fcntl(descriptor, F_GETFL);
+    if (descriptorFlags < 0 || statusFlags < 0 ||
+        fcntl(descriptor, F_SETFD, descriptorFlags | FD_CLOEXEC) != 0 ||
+        fcntl(descriptor, F_SETFL, statusFlags | O_NONBLOCK) != 0) {
+        if (descriptorFlags >= 0) {
+            close(descriptor);
+        }
+        *error = QStringLiteral("Could not secure q-sunshine system-auth ticket descriptor");
+        return false;
+    }
+
+    QByteArray raw;
+    raw.reserve(kMaxTicketBytes);
+    bool success = false;
+    QElapsedTimer timer;
+    timer.start();
+    for (;;) {
+        char buffer[256];
+        const ssize_t count = read(descriptor, buffer, sizeof(buffer));
+        if (count > 0) {
+            if (raw.size() + count > kMaxTicketBytes) {
+                break;
+            }
+            raw.append(buffer, static_cast<int>(count));
+            continue;
+        }
+        if (count == 0) {
+            success = true;
+            break;
+        }
+        if (errno == EINTR) {
+            continue;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+            break;
+        }
+        const int remaining = kRequestTimeoutMs - static_cast<int>(timer.elapsed());
+        if (remaining <= 0) {
+            break;
+        }
+        struct pollfd pollDescriptor = {descriptor, POLLIN | POLLHUP, 0};
+        if (poll(&pollDescriptor, 1, remaining) <= 0) {
+            break;
+        }
+    }
+    const int closeResult = close(descriptor);
+
+    if (!success || closeResult != 0) {
+        secureClear(raw);
+        *error = QStringLiteral("Could not read q-sunshine system-auth ticket");
+        return false;
+    }
+    if (raw.endsWith('\n')) {
+        raw.chop(1);
+    }
+    static const QRegularExpression ticketPattern(
+        QStringLiteral("\\Aqsa1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\z"));
+    const QString ticketText = QString::fromLatin1(raw);
+    if (raw.isEmpty() || raw.contains('\r') || raw.contains('\n') ||
+        !ticketPattern.match(ticketText).hasMatch()) {
+        secureClear(raw);
+        *error = QStringLiteral("Invalid q-sunshine system-auth ticket");
+        return false;
+    }
+    *ticket = std::move(raw);
+    return true;
+#endif
+}
+
+bool generateKeyAndCsr(QByteArray* privateKey, QByteArray* csr, QString* error)
+{
+    EVP_PKEY* key = nullptr;
+    X509_REQ* request = nullptr;
+    X509_NAME* subject = nullptr;
+    BIO* privateKeyBio = nullptr;
+    BIO* csrBio = nullptr;
+    bool success = false;
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+    key = EVP_RSA_gen(2048);
+#else
+    EVP_PKEY_CTX* keyContext = EVP_PKEY_CTX_new_id(EVP_PKEY_RSA, nullptr);
+    if (keyContext != nullptr && EVP_PKEY_keygen_init(keyContext) == 1 &&
+        EVP_PKEY_CTX_set_rsa_keygen_bits(keyContext, 2048) == 1) {
+        EVP_PKEY_keygen(keyContext, &key);
+    }
+    EVP_PKEY_CTX_free(keyContext);
+#endif
+    if (key == nullptr) {
+        goto done;
+    }
+    request = X509_REQ_new();
+    subject = X509_NAME_new();
+    if (request == nullptr || subject == nullptr || X509_REQ_set_version(request, 0L) != 1 ||
+        X509_NAME_add_entry_by_txt(subject, "CN", MBSTRING_ASC,
+                                   reinterpret_cast<const unsigned char*>("q-sunshine lease client"),
+                                   -1, -1, 0) != 1 ||
+        X509_REQ_set_subject_name(request, subject) != 1 ||
+        X509_REQ_set_pubkey(request, key) != 1 ||
+        X509_REQ_sign(request, key, EVP_sha256()) <= 0) {
+        goto done;
+    }
+    privateKeyBio = BIO_new(BIO_s_mem());
+    csrBio = BIO_new(BIO_s_mem());
+    if (privateKeyBio == nullptr || csrBio == nullptr ||
+        PEM_write_bio_PrivateKey(privateKeyBio, key, nullptr, nullptr, 0, nullptr, nullptr) != 1 ||
+        PEM_write_bio_X509_REQ(csrBio, request) != 1) {
+        goto done;
+    }
+    {
+        BUF_MEM* privateKeyMemory = nullptr;
+        BUF_MEM* csrMemory = nullptr;
+        BIO_get_mem_ptr(privateKeyBio, &privateKeyMemory);
+        BIO_get_mem_ptr(csrBio, &csrMemory);
+        if (privateKeyMemory == nullptr || csrMemory == nullptr ||
+            privateKeyMemory->length == 0 || csrMemory->length == 0 ||
+            csrMemory->length > 16 * 1024) {
+            goto done;
+        }
+        *privateKey = QByteArray(privateKeyMemory->data, static_cast<int>(privateKeyMemory->length));
+        *csr = QByteArray(csrMemory->data, static_cast<int>(csrMemory->length));
+    }
+    success = true;
+
+done:
+    if (!success) {
+        secureClear(*privateKey);
+        secureClear(*csr);
+        *error = QStringLiteral("Could not create q-sunshine system-auth lease credentials");
+    }
+    BIO_free(csrBio);
+    BIO_free(privateKeyBio);
+    X509_NAME_free(subject);
+    X509_REQ_free(request);
+    EVP_PKEY_free(key);
+    return success;
+}
+
+bool sendLeaseRequest(const QString& authHost, quint16 authPort, const QString& authSni,
+                      const QList<QSslCertificate>& authCa, QByteArray* request,
+                      QByteArray* response, QString* error)
+{
+    QSslSocket socket;
+    QSslConfiguration configuration = QSslConfiguration::defaultConfiguration();
+    configuration.setProtocol(QSsl::TlsV1_3OrLater);
+    configuration.setCaCertificates(authCa);
+    configuration.setSslOption(QSsl::SslOptionDisableSessionPersistence, true);
+    socket.setSslConfiguration(configuration);
+    socket.setPeerVerifyMode(QSslSocket::VerifyPeer);
+    socket.setPeerVerifyName(authSni);
+    socket.connectToHostEncrypted(authHost, authPort, authSni);
+    if (!socket.waitForEncrypted(kConnectTimeoutMs)) {
+        *error = QStringLiteral("Could not authenticate the q-sunshine system-auth gateway");
+        return false;
+    }
+    if (socket.write(*request) != request->size() || !socket.waitForBytesWritten(kRequestTimeoutMs)) {
+        *error = QStringLiteral("Could not send q-sunshine system-auth lease request");
+        return false;
+    }
+    // QSslSocket has accepted a copy for TLS transmission.  The caller clears
+    // the owned request immediately after this return, regardless of outcome.
+    QElapsedTimer timer;
+    timer.start();
+    while (!response->contains('\n') && timer.elapsed() < kRequestTimeoutMs) {
+        const int remaining = qMax(1, kRequestTimeoutMs - static_cast<int>(timer.elapsed()));
+        if (!socket.waitForReadyRead(remaining)) {
+            break;
+        }
+        response->append(socket.readAll());
+        if (response->size() > kMaxResponseBytes) {
+            *error = QStringLiteral("Invalid q-sunshine system-auth lease response");
+            return false;
+        }
+    }
+    response->append(socket.readAll());
+    const int newline = response->indexOf('\n');
+    if (newline < 0 || newline != response->size() - 1) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth lease response");
+        return false;
+    }
+    response->chop(1);
+    socket.disconnectFromHost();
+    return true;
+}
+
+bool verifyPrivateKeyMatchesCertificate(const QByteArray& certificatePem, const QByteArray& privateKeyPem)
+{
+    BIO* certificateBio = BIO_new_mem_buf(certificatePem.constData(), certificatePem.size());
+    BIO* privateKeyBio = BIO_new_mem_buf(privateKeyPem.constData(), privateKeyPem.size());
+    X509* certificate = certificateBio == nullptr ? nullptr : PEM_read_bio_X509(certificateBio, nullptr, nullptr, nullptr);
+    EVP_PKEY* privateKey = privateKeyBio == nullptr ? nullptr : PEM_read_bio_PrivateKey(privateKeyBio, nullptr, nullptr, nullptr);
+    const bool matches = certificate != nullptr && privateKey != nullptr &&
+                         X509_check_private_key(certificate, privateKey) == 1;
+    EVP_PKEY_free(privateKey);
+    X509_free(certificate);
+    BIO_free(privateKeyBio);
+    BIO_free(certificateBio);
+    return matches;
+}
+
+bool verifyClientCertificateProfile(const QByteArray& certificatePem, const QByteArray& privateKeyPem,
+                                    const QString& audience)
+{
+    BIO* bio = BIO_new_mem_buf(certificatePem.constData(), certificatePem.size());
+    X509* certificate = bio == nullptr ? nullptr : PEM_read_bio_X509(bio, nullptr, nullptr, nullptr);
+    BASIC_CONSTRAINTS* constraints = nullptr;
+    ASN1_BIT_STRING* keyUsage = nullptr;
+    EXTENDED_KEY_USAGE* extendedKeyUsage = nullptr;
+    GENERAL_NAMES* subjectAlternativeNames = nullptr;
+    bool valid = false;
+    int constraintsCritical = -1;
+    int keyUsageCritical = -1;
+    int extendedKeyUsageCritical = -1;
+    int subjectAlternativeNamesCritical = -1;
+    const QByteArray expectedUri = QByteArray("urn:q-sunshine:aud:") + audience.toUtf8();
+
+    if (certificate == nullptr || !verifyPrivateKeyMatchesCertificate(certificatePem, privateKeyPem) ||
+        X509_cmp_current_time(X509_get0_notBefore(certificate)) > 0 ||
+        X509_cmp_current_time(X509_get0_notAfter(certificate)) <= 0) {
+        goto done;
+    }
+    constraints = static_cast<BASIC_CONSTRAINTS*>(X509_get_ext_d2i(
+        certificate, NID_basic_constraints, &constraintsCritical, nullptr));
+    keyUsage = static_cast<ASN1_BIT_STRING*>(X509_get_ext_d2i(
+        certificate, NID_key_usage, &keyUsageCritical, nullptr));
+    extendedKeyUsage = static_cast<EXTENDED_KEY_USAGE*>(X509_get_ext_d2i(
+        certificate, NID_ext_key_usage, &extendedKeyUsageCritical, nullptr));
+    subjectAlternativeNames = static_cast<GENERAL_NAMES*>(X509_get_ext_d2i(
+        certificate, NID_subject_alt_name, &subjectAlternativeNamesCritical, nullptr));
+    if (constraints == nullptr || constraints->ca != 0 || constraintsCritical != 1 ||
+        keyUsage == nullptr || keyUsageCritical != 1 ||
+        ASN1_BIT_STRING_get_bit(keyUsage, 0) != 1 || ASN1_BIT_STRING_get_bit(keyUsage, 2) != 1 ||
+        extendedKeyUsage == nullptr || extendedKeyUsageCritical != 1 ||
+        sk_ASN1_OBJECT_num(extendedKeyUsage) != 1 ||
+        OBJ_obj2nid(sk_ASN1_OBJECT_value(extendedKeyUsage, 0)) != NID_client_auth ||
+        subjectAlternativeNames == nullptr || subjectAlternativeNamesCritical != 1 ||
+        sk_GENERAL_NAME_num(subjectAlternativeNames) != 1) {
+        goto done;
+    }
+    {
+        GENERAL_NAME* name = sk_GENERAL_NAME_value(subjectAlternativeNames, 0);
+        if (name == nullptr || name->type != GEN_URI || name->d.uniformResourceIdentifier == nullptr) {
+            goto done;
+        }
+        const ASN1_IA5STRING* uri = name->d.uniformResourceIdentifier;
+        if (ASN1_STRING_length(uri) != expectedUri.size() ||
+            CRYPTO_memcmp(ASN1_STRING_get0_data(uri), expectedUri.constData(),
+                          static_cast<size_t>(expectedUri.size())) != 0) {
+            goto done;
+        }
+    }
+    valid = true;
+
+done:
+    GENERAL_NAMES_free(subjectAlternativeNames);
+    EXTENDED_KEY_USAGE_free(extendedKeyUsage);
+    ASN1_BIT_STRING_free(keyUsage);
+    BASIC_CONSTRAINTS_free(constraints);
+    X509_free(certificate);
+    BIO_free(bio);
+    return valid;
+}
+
+bool verifyServerCertificate(const QByteArray& certificatePem)
+{
+    BIO* bio = BIO_new_mem_buf(certificatePem.constData(), certificatePem.size());
+    X509* certificate = bio == nullptr ? nullptr : PEM_read_bio_X509(bio, nullptr, nullptr, nullptr);
+    const bool valid = certificate != nullptr && X509_cmp_current_time(X509_get0_notBefore(certificate)) <= 0 &&
+                       X509_cmp_current_time(X509_get0_notAfter(certificate)) > 0;
+    X509_free(certificate);
+    BIO_free(bio);
+    return valid;
+}
+
+bool certificateNotAfterUnixMs(const QByteArray& certificatePem, qint64* result)
+{
+    BIO* bio = BIO_new_mem_buf(certificatePem.constData(), certificatePem.size());
+    X509* certificate = bio == nullptr ? nullptr : PEM_read_bio_X509(bio, nullptr, nullptr, nullptr);
+    struct tm expiration = {};
+    bool valid = certificate != nullptr &&
+                 ASN1_TIME_to_tm(X509_get0_notAfter(certificate), &expiration) == 1;
+    time_t seconds = 0;
+    if (valid) {
+#ifdef Q_OS_WIN
+        seconds = static_cast<time_t>(_mkgmtime64(&expiration));
+#else
+        seconds = timegm(&expiration);
+#endif
+        valid = seconds > 0 && seconds <= std::numeric_limits<qint64>::max() / 1000;
+    }
+    if (valid) {
+        *result = static_cast<qint64>(seconds) * 1000;
+    }
+    X509_free(certificate);
+    BIO_free(bio);
+    return valid;
+}
+
+bool parseLeaseResponse(const QByteArray& response, const QString& expectedAudience,
+                        const QByteArray& privateKey, QByteArray* clientCertificateOut,
+                        QSslCertificate* serverCertificateOut, qint64* expiresAtOut,
+                        QString* error)
+{
+    QJsonParseError parseError;
+    const QJsonDocument document = QJsonDocument::fromJson(response, &parseError);
+    if (parseError.error != QJsonParseError::NoError || !document.isObject()) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth lease response");
+        return false;
+    }
+    const QJsonObject topLevel = document.object();
+    if (topLevel.value(QStringLiteral("ok")) != true || topLevel.size() != 2 ||
+        !topLevel.contains(QStringLiteral("result")) || !topLevel.value(QStringLiteral("result")).isObject()) {
+        *error = QStringLiteral("q-sunshine system-auth lease was rejected");
+        return false;
+    }
+    const QJsonObject result = topLevel.value(QStringLiteral("result")).toObject();
+    static const QSet<QString> expectedFields = {
+        QStringLiteral("version"), QStringLiteral("audience"), QStringLiteral("subject"),
+        QStringLiteral("expires_at_unix_ms"), QStringLiteral("client_certificate_pem"),
+        QStringLiteral("sunshine_server_certificate_pem"),
+    };
+    QSet<QString> actualFields;
+    for (const QString& field : result.keys()) {
+        actualFields.insert(field);
+    }
+    if (result.size() != expectedFields.size() || actualFields != expectedFields ||
+        result.value(QStringLiteral("version")).toInt(-1) != 1 ||
+        !result.value(QStringLiteral("audience")).isString() ||
+        !result.value(QStringLiteral("subject")).isString() ||
+        !result.value(QStringLiteral("client_certificate_pem")).isString() ||
+        !result.value(QStringLiteral("sunshine_server_certificate_pem")).isString()) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth lease response");
+        return false;
+    }
+    const QString audience = result.value(QStringLiteral("audience")).toString();
+    const QString subject = result.value(QStringLiteral("subject")).toString();
+    qint64 expiresAt = 0;
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    if (audience != expectedAudience || !validAudience(audience) || subject.isEmpty() ||
+        subject.size() > 64 || containsControl(subject) ||
+        !parseInteger(result.value(QStringLiteral("expires_at_unix_ms")),
+                      now + kMinimumLeaseRemainingMs, now + kMaximumLeaseLifetimeMs, &expiresAt)) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth lease response");
+        return false;
+    }
+    const QByteArray clientCertificate = result.value(QStringLiteral("client_certificate_pem")).toString().toLatin1();
+    const QByteArray serverCertificate = result.value(QStringLiteral("sunshine_server_certificate_pem")).toString().toLatin1();
+    const QList<QSslCertificate> clientCertificates = QSslCertificate::fromData(clientCertificate, QSsl::Pem);
+    const QList<QSslCertificate> serverCertificates = QSslCertificate::fromData(serverCertificate, QSsl::Pem);
+    qint64 leafExpiresAt = 0;
+    if (clientCertificate.isEmpty() || serverCertificate.isEmpty() ||
+        clientCertificates.size() != 1 || serverCertificates.size() != 1 ||
+        !verifyClientCertificateProfile(clientCertificate, privateKey, audience) ||
+        !verifyServerCertificate(serverCertificate) ||
+        !certificateNotAfterUnixMs(clientCertificate, &leafExpiresAt) || expiresAt > leafExpiresAt) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth lease certificate");
+        return false;
+    }
+    *clientCertificateOut = clientCertificate;
+    *serverCertificateOut = serverCertificates.constFirst();
+    *expiresAtOut = expiresAt;
+    return true;
+}
+
+} // namespace
+
+GameStreamLease::~GameStreamLease()
+{
+    clear();
+}
+
+bool GameStreamLease::requested()
+{
+    for (const char* name : kEnvironmentNames) {
+        if (qEnvironmentVariableIsSet(name)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool GameStreamLease::acquire(GameStreamLease* lease, QString* error)
+{
+    if (lease == nullptr || error == nullptr) {
+        return false;
+    }
+    lease->clear();
+    *error = QString();
+    const QString authHost = qEnvironmentVariable(kAuthHost).trimmed();
+    const QString authPortString = qEnvironmentVariable(kAuthPort).trimmed();
+    const QString authSni = qEnvironmentVariable(kAuthSni).trimmed();
+    const QString authCaFile = qEnvironmentVariable(kAuthCaFile).trimmed();
+    const QString audience = qEnvironmentVariable(kAudience).trimmed();
+    const QString ticketFd = qEnvironmentVariable(kTicketFd).trimmed();
+    const QString host = qEnvironmentVariable(kHost).trimmed();
+    const QString httpsPortString = qEnvironmentVariable(kHttpsPort).trimmed();
+    quint16 authPort = 0;
+    quint16 httpsPort = 0;
+    if (!validHost(authHost) || !validHost(authSni) || !validHost(host) ||
+        authCaFile.isEmpty() || containsControl(authCaFile) || !validAudience(audience) ||
+        ticketFd.isEmpty() || !parsePort(authPortString, &authPort) ||
+        !parsePort(httpsPortString, &httpsPort)) {
+        *error = QStringLiteral("q-sunshine system-auth lease configuration is incomplete or invalid");
+        return false;
+    }
+
+    QFile caFile(authCaFile);
+    if (!caFile.open(QIODevice::ReadOnly) || caFile.size() <= 0 || caFile.size() > kMaxCaBytes) {
+        *error = QStringLiteral("Could not read q-sunshine system-auth gateway CA certificate");
+        return false;
+    }
+    const QList<QSslCertificate> authCa = QSslCertificate::fromData(caFile.readAll(), QSsl::Pem);
+    if (authCa.isEmpty()) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth gateway CA certificate");
+        return false;
+    }
+
+    QByteArray ticket;
+    QByteArray privateKey;
+    QByteArray csr;
+    QByteArray request;
+    QByteArray response;
+    QByteArray clientCertificate;
+    QSslCertificate serverCertificate;
+    qint64 expiresAt = 0;
+    bool success = false;
+    if (!readTicketFromFd(ticketFd, &ticket, error) || !generateKeyAndCsr(&privateKey, &csr, error)) {
+        goto done;
+    }
+    {
+        const QJsonObject payload{{QStringLiteral("op"), QStringLiteral("gamestream_lease")},
+                                  {QStringLiteral("version"), 1},
+                                  {QStringLiteral("session_token"), QString::fromLatin1(ticket)},
+                                  {QStringLiteral("csr_pem"), QString::fromLatin1(csr)}};
+        request = QJsonDocument(payload).toJson(QJsonDocument::Compact);
+        request.append('\n');
+    }
+    // The caller owns the pipe and packet; clear our copy as soon as it has
+    // been serialized.  The request buffer is cleared just after socket write.
+    secureClear(ticket);
+    if (request.size() > kMaxRequestBytes ||
+        !sendLeaseRequest(authHost, authPort, authSni, authCa, &request, &response, error)) {
+        goto done;
+    }
+    secureClear(request);
+    if (!parseLeaseResponse(response, audience, privateKey, &clientCertificate,
+                            &serverCertificate, &expiresAt, error)) {
+        goto done;
+    }
+    lease->m_ClientCertificatePem = std::move(clientCertificate);
+    lease->m_ClientPrivateKeyPem = std::move(privateKey);
+    lease->m_SunshineServerCertificate = serverCertificate;
+    lease->m_Host = host;
+    lease->m_HttpsPort = httpsPort;
+    lease->m_ExpiresAtUnixMs = expiresAt;
+    success = lease->isValid();
+    if (!success) {
+        *error = QStringLiteral("Invalid q-sunshine system-auth lease");
+    }
+
+done:
+    secureClear(ticket);
+    secureClear(csr);
+    secureClear(request);
+    secureClear(response);
+    secureClear(clientCertificate);
+    secureClear(privateKey);
+    if (!success) {
+        lease->clear();
+    }
+    return success;
+}
+
+bool GameStreamLease::isValid() const
+{
+    return !m_ClientCertificatePem.isEmpty() && !m_ClientPrivateKeyPem.isEmpty() &&
+           !m_SunshineServerCertificate.isNull() && !m_Host.isEmpty() && m_HttpsPort != 0 &&
+           m_ExpiresAtUnixMs > QDateTime::currentMSecsSinceEpoch();
+}
+
+const QByteArray& GameStreamLease::clientCertificatePem() const
+{
+    return m_ClientCertificatePem;
+}
+
+const QByteArray& GameStreamLease::clientPrivateKeyPem() const
+{
+    return m_ClientPrivateKeyPem;
+}
+
+QSslCertificate GameStreamLease::sunshineServerCertificate() const
+{
+    return m_SunshineServerCertificate;
+}
+
+QString GameStreamLease::host() const
+{
+    return m_Host;
+}
+
+quint16 GameStreamLease::httpsPort() const
+{
+    return m_HttpsPort;
+}
+
+qint64 GameStreamLease::expiresAtUnixMs() const
+{
+    return m_ExpiresAtUnixMs;
+}
+
+void GameStreamLease::clear()
+{
+    secureClear(m_ClientCertificatePem);
+    secureClear(m_ClientPrivateKeyPem);
+    m_SunshineServerCertificate = QSslCertificate();
+    m_Host.clear();
+    m_HttpsPort = 0;
+    m_ExpiresAtUnixMs = 0;
+}
