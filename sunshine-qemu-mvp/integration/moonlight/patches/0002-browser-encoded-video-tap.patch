+#define QSM_BROWSER_UNIX_PREFIX "unix:"
+#define QSM_BROWSER_PACKET_MAGIC 0x51534D50U
+#define QSM_BROWSER_PACKET_FIRST 0x00000001U
+#define QSM_BROWSER_PACKET_END 0x00000002U
+#define QSM_BROWSER_PACKET_IDR 0x00000004U
+#define QSM_BROWSER_PACKET_AUDIO 0x00000008U
+#define QSM_BROWSER_PACKET_CONFIG 0x00000010U
+#define QSM_BROWSER_MAX_FRAGMENT_BYTES (256U * 1024U)
