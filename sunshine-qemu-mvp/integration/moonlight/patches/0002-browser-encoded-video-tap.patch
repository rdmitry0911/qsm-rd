+#ifndef _WIN32
+static int openQsmBrowserSocket(const char* context)
+{
+    struct sockaddr_un address;
+    const char* path;
+    int descriptor;
+    int flags;
+
+    if (strncmp(context, QSM_BROWSER_UNIX_PREFIX, strlen(QSM_BROWSER_UNIX_PREFIX)) != 0) {
+        return -2;
+    }
+
+    path = context + strlen(QSM_BROWSER_UNIX_PREFIX);
+    if (path[0] != '/' || strlen(path) >= sizeof(address.sun_path)) {
+        return -1;
+    }
+
+    descriptor = socket(AF_UNIX, SOCK_SEQPACKET, 0);
+    if (descriptor < 0) {
+        return -1;
+    }
+
+    memset(&address, 0, sizeof(address));
+    address.sun_family = AF_UNIX;
+    strcpy(address.sun_path, path);
+    if (connect(descriptor, (struct sockaddr*)&address, sizeof(address)) != 0) {
+        close(descriptor);
+        return -1;
+    }
+    // A nonblocking AF_UNIX connect commonly returns EINPROGRESS even when
+    // the bridge is already listening.  Connect while blocking, then make
+    // the steady-state media path lossy/nonblocking so a stalled local
+    // browser cannot pause GameStream's decoder queue.
+    flags = fcntl(descriptor, F_GETFL);
+    if (flags < 0 || fcntl(descriptor, F_SETFL, flags | O_NONBLOCK) != 0) {
+        close(descriptor);
+        return -1;
+    }
+    return descriptor;
+}
+
+static void closeQsmBrowserSocket(int* descriptor)
+{
+    if (*descriptor >= 0) {
+        close(*descriptor);
+        *descriptor = -1;
+    }
+}
+
+static void sendQsmBrowserPacket(int* descriptor, unsigned int frameNumber,
+                                 unsigned int fragmentNumber, unsigned int flags,
+                                 const void* data, unsigned int length)
+{
+    uint32_t header[5];
+    struct iovec vectors[2];
+    struct msghdr message;
+    ssize_t sent;
+
+    if (*descriptor < 0 || length > QSM_BROWSER_MAX_FRAGMENT_BYTES) {
+        return;
+    }
+
+    header[0] = htonl(QSM_BROWSER_PACKET_MAGIC);
+    header[1] = htonl(frameNumber);
+    header[2] = htonl(fragmentNumber);
+    header[3] = htonl(flags);
+    header[4] = htonl(length);
+    memset(&message, 0, sizeof(message));
+    vectors[0].iov_base = header;
+    vectors[0].iov_len = sizeof(header);
+    vectors[1].iov_base = (void*)data;
+    vectors[1].iov_len = length;
+    message.msg_iov = vectors;
+    message.msg_iovlen = 2;
+    sent = sendmsg(*descriptor, &message, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (sent != (ssize_t)(sizeof(header) + length) && errno != EAGAIN && errno != EWOULDBLOCK) {
+        closeQsmBrowserSocket(descriptor);
+    }
+}
+#endif
