#cloud-config
#
# Materialized by run-virgl-qsf-wayland-clipboard-e2e.sh. Every executable and
# test payload member arrives on a separate read-only virtio block device and
# is verified before it is installed or used.
write_files:
  - path: /usr/local/sbin/qsf-virgl-wayland-bootstrap
    permissions: '0700'
    content: |
      #!/bin/sh
      set -u

      serial=/dev/ttyS0
      telemetry=/dev/virtio-ports/org.qsunshine.virgl.wayland.telemetry
      qsf_port=/dev/virtio-ports/org.qsunshine.agent
      payload=/mnt/qsf-virgl-wayland-payload
      payload_device=/dev/disk/by-label/qsfvirglwayland
      state=/var/lib/qsf-virgl-wayland
      runtime=/run/user/0
      expected_manifest_sha256='@PAYLOAD_MANIFEST_SHA256@'
      expected_agent_sha256='@AGENT_SHA256@'
      expected_input_watcher_sha256='@INPUT_WATCHER_SHA256@'
      expected_bridge_sha256='@BRIDGE_SHA256@'
      seatd_pid=''
      weston_pid=''
      bridge_pid=''
      workload_pid=''
      input_watcher_pid=''

      report() {
        printf '%s\n' "$*" >"$serial" 2>/dev/null || true
        if [ -c "$telemetry" ]; then
          printf '%s\n' "$*" >"$telemetry" 2>/dev/null || true
        fi
      }

      stop_process() {
        process=$1
        if [ -n "$process" ] && kill -0 "$process" 2>/dev/null; then
          kill "$process" 2>/dev/null || true
          wait "$process" 2>/dev/null || true
        fi
      }

      fail() {
        report "QSF_VIRGL_WAYLAND_GUEST_E2E_FAILED=$*"
        for detail_log in /tmp/qsf-virgl-wayland-weston.log \
            /tmp/qsf-virgl-wayland-weston-resize.log \
            /tmp/qsf-virgl-wayland-seatd.log \
            /tmp/qsf-virgl-wayland-simple-egl.log \
            /tmp/qsf-virgl-wayland-simple-egl-resize.log; do
          if [ -f "$detail_log" ]; then
            printf '%s\n' "--- $detail_log ---" >"$serial" 2>/dev/null || true
            tail -120 "$detail_log" >"$serial" 2>/dev/null || true
          fi
        done
        stop_process "$workload_pid"
        stop_process "$bridge_pid"
        stop_process "$weston_pid"
        stop_process "$seatd_pid"
        stop_process "$input_watcher_pid"
        sync
        exit 1
      }

      report QSF_VIRGL_WAYLAND_GUEST_E2E
      report "kernel=$(uname -srmo)"
      mkdir -p "$payload" "$state/incoming" "$state/outgoing" "$runtime" \
        || fail cannot_create_guest_state
      chmod 700 "$state" "$state/incoming" "$state/outgoing" "$runtime" \
        || fail cannot_protect_guest_state
      export XDG_RUNTIME_DIR="$runtime"
      export WAYLAND_DISPLAY=wayland-0

      mounted=0
      for _ in $(seq 1 60); do
        if [ -b "$payload_device" ] && mount -o ro "$payload_device" "$payload"; then
          mounted=1
          break
        fi
        sleep 1
      done
      [ "$mounted" = 1 ] || fail payload_volume_not_found
      [ -f "$payload/manifest.sha256" ] || fail payload_manifest_missing
      actual_manifest_sha256=$(sha256sum "$payload/manifest.sha256" | awk '{print $1}')
      [ "$actual_manifest_sha256" = "$expected_manifest_sha256" ] \
        || fail payload_manifest_hash_mismatch
      (cd "$payload" && sha256sum -c manifest.sha256) \
        >/tmp/qsf-virgl-wayland-payload-verify.txt 2>&1 || {
          sed -n '1,120p' /tmp/qsf-virgl-wayland-payload-verify.txt >"$serial" 2>/dev/null || true
          fail payload_member_hash_mismatch
        }
      actual_agent_sha256=$(sha256sum "$payload/qsf-guest-agent" | awk '{print $1}')
      actual_input_watcher_sha256=$(sha256sum "$payload/qsf-input-watcher" | awk '{print $1}')
      actual_bridge_sha256=$(sha256sum "$payload/qsf-wayland-clipboard-bridge" | awk '{print $1}')
      [ "$actual_agent_sha256" = "$expected_agent_sha256" ] || fail agent_hash_mismatch
      [ "$actual_input_watcher_sha256" = "$expected_input_watcher_sha256" ] || fail input_watcher_hash_mismatch
      [ "$actual_bridge_sha256" = "$expected_bridge_sha256" ] || fail bridge_hash_mismatch
      report "QSF_VIRGL_WAYLAND_GUEST_PAYLOAD_MANIFEST_SHA256=$actual_manifest_sha256"
      report "QSF_VIRGL_WAYLAND_GUEST_AGENT_SHA256=$actual_agent_sha256"
      report "QSF_VIRGL_WAYLAND_GUEST_INPUT_WATCHER_SHA256=$actual_input_watcher_sha256"
      report "QSF_VIRGL_WAYLAND_GUEST_BRIDGE_SHA256=$actual_bridge_sha256"

      for _ in $(seq 1 60); do
        [ -c "$qsf_port" ] && break
        sleep 1
      done
      [ -c "$qsf_port" ] || fail qsf_virtio_port_missing
      cp "$payload/qsf-guest-agent" /usr/local/sbin/qsf-guest-agent \
        || fail cannot_copy_static_agent
      cp "$payload/qsf-input-watcher" /usr/local/sbin/qsf-input-watcher \
        || fail cannot_copy_input_watcher
      cp "$payload/qsf-wayland-clipboard-bridge" /usr/local/sbin/qsf-wayland-clipboard-bridge \
        || fail cannot_copy_wayland_bridge
      chmod 700 /usr/local/sbin/qsf-guest-agent /usr/local/sbin/qsf-input-watcher \
        /usr/local/sbin/qsf-wayland-clipboard-bridge \
        || fail cannot_protect_guest_executables
      [ "$(stat -c '%a' /usr/local/sbin/qsf-guest-agent)" = 700 ] \
        || fail static_agent_mode_is_not_0700
      [ "$(stat -c '%a' /usr/local/sbin/qsf-input-watcher)" = 700 ] \
        || fail input_watcher_mode_is_not_0700
      [ "$(stat -c '%a' /usr/local/sbin/qsf-wayland-clipboard-bridge)" = 700 ] \
        || fail wayland_bridge_mode_is_not_0700
      : >"$state/qsf-clipboard.txt"
      chmod 600 "$state/qsf-clipboard.txt" || fail cannot_protect_qsf_clipboard_state
      cp "$payload/qsf-guest-download.txt" "$state/outgoing/guest-download.txt" \
        || fail cannot_seed_guest_download

      /usr/local/sbin/qsf-guest-agent --device "$qsf_port" --state-dir "$state" \
        >"$serial" 2>&1 &
      qsf_agent_pid=$!
      sleep 1
      kill -0 "$qsf_agent_pid" 2>/dev/null || fail static_agent_exited
      report 'QSF_VIRGL_WAYLAND_GUEST_AGENT_MODE=700'
      report 'QSF_VIRGL_WAYLAND_GUEST_INPUT_WATCHER_MODE=700'
      report 'QSF_VIRGL_WAYLAND_GUEST_BRIDGE_MODE=700'
      report 'QSF_VIRGL_WAYLAND_GUEST_AGENT_STARTED'

      if ! grep -Fqx 'https://dl-cdn.alpinelinux.org/alpine/v3.20/community' \
          /etc/apk/repositories; then
        printf '%s\n' 'https://dl-cdn.alpinelinux.org/alpine/v3.20/community' \
          >>/etc/apk/repositories || fail cannot_enable_alpine_community
      fi
      apk add --no-cache mesa-dri-gallium mesa-egl mesa-utils \
        weston weston-backend-drm weston-shell-desktop weston-clients \
        wl-clipboard seatd eudev gnu-libiconv \
        >/tmp/qsf-virgl-wayland-apk.log 2>&1 || {
          sed -n '1,180p' /tmp/qsf-virgl-wayland-apk.log >"$serial" 2>/dev/null || true
          fail cannot_install_wayland_virgl_packages
        }
      record_wayland_package_version() {
        package=$1
        installed=$(awk -v package="$package" '
          $0 == "P:" package { selected = 1; next }
          selected && /^V:/ { sub(/^V:/, ""); print; exit }
          /^P:/ { selected = 0 }
        ' /lib/apk/db/installed)
        [ -n "$installed" ] || fail "installed_wayland_package_version_missing_$package"
        report "guest_wayland_package_${package}=${package}-${installed}"
      }
      for package in mesa-dri-gallium mesa-egl mesa-utils \
          weston weston-backend-drm weston-shell-desktop weston-clients \
          wl-clipboard seatd eudev gnu-libiconv; do
        record_wayland_package_version "$package"
      done

      test -c /dev/dri/card0 || fail guest_card0_missing
      test -c /dev/dri/renderD128 || fail guest_renderD128_missing
      driver_node=$(find /sys/bus/virtio/drivers/virtio_gpu -mindepth 1 \
        -maxdepth 1 -type l 2>/dev/null | head -n1)
      test -n "$driver_node" || fail virtio_gpu_not_bound
      report 'guest_drm_driver=virtio_gpu'
      EGL_PLATFORM=surfaceless eglinfo -B >/tmp/qsf-virgl-wayland-eglinfo.log 2>&1 || true
      renderer=$(sed -n 's/^OpenGL core profile renderer: //p' \
        /tmp/qsf-virgl-wayland-eglinfo.log | head -n1)
      report "guest_gl_renderer=$renderer"
      printf '%s' "$renderer" | grep -qi virgl || fail "expected_virgl_renderer_got_$renderer"

      # The cloud image does not run a seat manager or udev daemon itself.
      # These guest-only services make the QEMU virtio HID devices visible to
      # libinput, so Weston exposes a real wl_seat required by wl-clipboard.
      udevd --daemon >/tmp/qsf-virgl-wayland-udevd.log 2>&1 || fail udevd_failed_to_start
      for _ in $(seq 1 100); do
        test -S /run/udev/control && break
        sleep 0.1
      done
      test -S /run/udev/control || fail udevd_control_socket_not_created
      udevadm trigger --action=add --subsystem-match=input \
        >/tmp/qsf-virgl-wayland-udev-trigger.log 2>&1 || fail udev_input_trigger_failed
      udevadm settle --timeout=10 >/tmp/qsf-virgl-wayland-udev-settle.log 2>&1 \
        || fail udev_input_settle_failed
      input_device=''
      for event in /dev/input/event*; do
        test -c "$event" || continue
        if udevadm info --query=property --name="$event" 2>/dev/null | grep -Fqx 'ID_INPUT=1'; then
          input_device=$event
          break
        fi
      done
      test -n "$input_device" || fail udev_did_not_tag_qemu_input
      report "guest_wayland_input=$input_device"

      rm -f "$state/input-watcher.ready"
      /usr/local/sbin/qsf-input-watcher --telemetry "$telemetry" \
        --ready-file "$state/input-watcher.ready" >"$serial" 2>&1 &
      input_watcher_pid=$!
      for _ in $(seq 1 100); do
        test -f "$state/input-watcher.ready" && break
        kill -0 "$input_watcher_pid" 2>/dev/null || break
        sleep 0.1
      done
      test -f "$state/input-watcher.ready" || fail input_watcher_not_ready
      kill -0 "$input_watcher_pid" 2>/dev/null || fail input_watcher_exited_after_ready
      report 'QSF_VIRGL_WAYLAND_GUEST_INPUT_WATCHER_STARTED'

      rm -f /run/seatd.sock "$runtime/wayland-0" /tmp/qsf-virgl-wayland-weston.log
      seatd -n -g root >/tmp/qsf-virgl-wayland-seatd.log 2>&1 &
      seatd_pid=$!
      for _ in $(seq 1 100); do
        test -S /run/seatd.sock && break
        kill -0 "$seatd_pid" 2>/dev/null || break
        sleep 0.1
      done
      test -S /run/seatd.sock || fail seatd_socket_not_created
      kill -0 "$seatd_pid" 2>/dev/null || fail seatd_exited_before_weston
      report 'guest_wayland_seat=seatd'

      weston --backend=drm-backend.so --socket=wayland-0 \
        --log=/tmp/qsf-virgl-wayland-weston.log --idle-time=0 --no-config \
        >"$serial" 2>&1 &
      weston_pid=$!
      for _ in $(seq 1 450); do
        test -S "$runtime/wayland-0" && break
        kill -0 "$weston_pid" 2>/dev/null || break
        sleep 0.1
      done
      test -S "$runtime/wayland-0" || fail weston_drm_socket_not_created
      kill -0 "$weston_pid" 2>/dev/null || fail weston_drm_exited_after_socket
      grep -qiE 'using /dev/dri/card0|drm-backend' /tmp/qsf-virgl-wayland-weston.log \
        || fail weston_log_does_not_confirm_drm_backend
      grep -qi 'GL renderer: virgl' /tmp/qsf-virgl-wayland-weston.log \
        || fail weston_log_renderer_is_not_virgl
      report 'guest_wayland_compositor=weston-drm'

      /usr/local/sbin/qsf-wayland-clipboard-bridge --state-dir "$state" \
        --telemetry "$telemetry" --runtime-dir "$runtime" >"$serial" 2>&1 &
      bridge_pid=$!
      for _ in $(seq 1 100); do
        test -f "$state/wayland-clipboard-bridge.ready" && break
        kill -0 "$bridge_pid" 2>/dev/null || break
        sleep 0.1
      done
      test -f "$state/wayland-clipboard-bridge.ready" || fail wayland_bridge_not_ready
      kill -0 "$bridge_pid" 2>/dev/null || fail wayland_bridge_exited_after_ready
      report 'QSF_VIRGL_WAYLAND_GUEST_BRIDGE_STARTED'

      # Keep a real client presenting frames during the Display1 probe.
      timeout 50 weston-simple-egl >/tmp/qsf-virgl-wayland-simple-egl.log 2>&1 &
      workload_pid=$!
      sleep 1
      kill -0 "$workload_pid" 2>/dev/null || fail weston_simple_egl_exited_early
      report 'guest_wayland_visual_workload=weston-simple-egl'
      report QSF_VIRGL_WAYLAND_GUEST_VIRGL_READY

      # The host sends qsf-client-clipboard.txt only after the readiness
      # marker. The first half of this coordinator proves that the bridge
      # actually published it to Wayland by reading wl-paste independently.
      (
        client_clipboard="$payload/qsf-client-clipboard.txt"
        guest_clipboard="$payload/qsf-guest-clipboard.txt"
        client_hash=$(sha256sum "$client_clipboard" | awk '{print $1}')
        guest_hash=$(sha256sum "$guest_clipboard" | awk '{print $1}')
        client_seen=0
        for _ in $(seq 1 900); do
          if cmp -s "$state/qsf-clipboard.txt" "$client_clipboard"; then
            client_seen=1
            break
          fi
          sleep 0.1
        done
        [ "$client_seen" = 1 ] || fail qsf_client_clipboard_not_received
        report "QSF_VIRGL_WAYLAND_GUEST_CLIENT_TO_WAYLAND_STATE_SHA256=$(sha256sum "$state/qsf-clipboard.txt" | awk '{print $1}')"
        wayland_seen=0
        for _ in $(seq 1 300); do
          if wl-paste --no-newline --type 'text/plain;charset=utf-8' \
              >/tmp/qsf-virgl-wayland-from-qsf.txt 2>/tmp/qsf-virgl-wayland-wl-paste.log \
              && cmp -s /tmp/qsf-virgl-wayland-from-qsf.txt "$client_clipboard"; then
            wayland_seen=1
            break
          fi
          sleep 0.1
        done
        [ "$wayland_seen" = 1 ] || fail qsf_client_clipboard_not_visible_in_wayland
        report "QSF_VIRGL_WAYLAND_GUEST_CLIENT_TO_WAYLAND_WL_PASTE_SHA256=$(sha256sum /tmp/qsf-virgl-wayland-from-qsf.txt | awk '{print $1}')"

        # This is a genuine guest Wayland clipboard mutation, not a write to
        # qsf-clipboard.txt. The bridge must observe it and publish it to the
        # static agent's state file, which then emits EVENT_CLIP to QSF.
        wl-copy --type 'text/plain;charset=utf-8' <"$guest_clipboard" \
          >/tmp/qsf-virgl-wayland-wl-copy.log 2>&1 || fail guest_native_wl_copy_failed
        report "QSF_VIRGL_WAYLAND_GUEST_NATIVE_WL_COPY_SHA256=$guest_hash"
        guest_seen=0
        for _ in $(seq 1 300); do
          if cmp -s "$state/qsf-clipboard.txt" "$guest_clipboard"; then
            guest_seen=1
            break
          fi
          sleep 0.1
        done
        [ "$guest_seen" = 1 ] || fail native_wayland_clipboard_not_published_to_qsf
        report "QSF_VIRGL_WAYLAND_GUEST_WAYLAND_TO_QSF_STATE_SHA256=$(sha256sum "$state/qsf-clipboard.txt" | awk '{print $1}')"

        report "QSF_VIRGL_WAYLAND_GUEST_QSF_DOWNLOAD_SHA256=$(sha256sum "$state/outgoing/guest-download.txt" | awk '{print $1}')"
        upload_seen=0
        for _ in $(seq 1 900); do
          if [ -f "$state/incoming/client-upload.txt" ]; then
            upload_seen=1
            break
          fi
          sleep 0.1
        done
        [ "$upload_seen" = 1 ] || fail qsf_client_upload_not_received
        report "QSF_VIRGL_WAYLAND_GUEST_UPLOAD_SHA256=$(sha256sum "$state/incoming/client-upload.txt" | awk '{print $1}')"
        resize_seen=0
        for _ in $(seq 1 900); do
          if cmp -s "$state/resolution" "$payload/qsf-resize-expected.txt"; then
            resize_seen=1
            break
          fi
          sleep 0.1
        done
        [ "$resize_seen" = 1 ] || fail qsf_resize_state_not_received
        # SetUIInfo first updates virtio-gpu's requested EDID mode. Weston 12
        # does not automatically reselect that preferred mode while its DRM
        # backend is live, so reconfigure this minimal desktop explicitly.
        # QSF state remains intact; the restarted bridge reseeds the native
        # Wayland selection from it before accepting new guest changes.
        sleep 2
        report 'QSF_VIRGL_WAYLAND_GUEST_RESIZE_RECONFIGURE=weston-drm-restart'
        stop_process "$workload_pid"
        workload_pid=''
        stop_process "$bridge_pid"
        bridge_pid=''
        stop_process "$weston_pid"
        weston_pid=''
        sleep 1
        rm -f "$runtime/wayland-0" "$runtime/wayland-0.lock" "$state/wayland-clipboard-bridge.ready" \
          /tmp/qsf-virgl-wayland-weston-resize.log
        weston --backend=drm-backend.so --socket=wayland-0 \
          --log=/tmp/qsf-virgl-wayland-weston-resize.log --idle-time=0 --no-config \
          >"$serial" 2>&1 &
        weston_pid=$!
        for _ in $(seq 1 450); do
          test -S "$runtime/wayland-0" && break
          kill -0 "$weston_pid" 2>/dev/null || break
          sleep 0.1
        done
        test -S "$runtime/wayland-0" || fail weston_resize_restart_socket_not_created
        kill -0 "$weston_pid" 2>/dev/null || fail weston_resize_restart_exited
        grep -qi 'GL renderer: virgl' /tmp/qsf-virgl-wayland-weston-resize.log \
          || fail weston_resize_restart_renderer_is_not_virgl
        /usr/local/sbin/qsf-wayland-clipboard-bridge --state-dir "$state" \
          --telemetry "$telemetry" --runtime-dir "$runtime" >"$serial" 2>&1 &
        bridge_pid=$!
        for _ in $(seq 1 100); do
          test -f "$state/wayland-clipboard-bridge.ready" && break
          kill -0 "$bridge_pid" 2>/dev/null || break
          sleep 0.1
        done
        test -f "$state/wayland-clipboard-bridge.ready" || fail wayland_bridge_resize_restart_not_ready
        kill -0 "$bridge_pid" 2>/dev/null || fail wayland_bridge_resize_restart_exited
        timeout 40 weston-simple-egl >/tmp/qsf-virgl-wayland-simple-egl-resize.log 2>&1 &
        workload_pid=$!
        sleep 1
        kill -0 "$workload_pid" 2>/dev/null || fail weston_simple_egl_resize_restart_exited_early
        report 'QSF_VIRGL_WAYLAND_GUEST_RESIZE_WESTON_RESTARTED'
        report "QSF_VIRGL_WAYLAND_GUEST_RESIZE=$(tr -d '\n' < "$state/resolution")"
      ) &

      report QSF_VIRGL_WAYLAND_GUEST_VIRGL_OK

runcmd:
  - [ /usr/local/sbin/qsf-virgl-wayland-bootstrap ]
