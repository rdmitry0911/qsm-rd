#!/bin/sh
set -eu

usage() {
    echo "usage: qsm-desktop-agent-setup USER" >&2
    exit 2
}

[ "$#" = 1 ] || usage
user=$1
case "$user" in
    *[!A-Za-z0-9._-]*|'') usage ;;
esac
id "$user" >/dev/null 2>&1 || { echo "qsm desktop setup: user does not exist" >&2; exit 1; }
usermod -a -G qsm-desktop "$user"
# Read the account's actual home rather than assuming /home/USER. The unit's
# read-only home sandbox needs this leaf directory to exist before it can bind
# it back read-write, otherwise systemd rejects the service with NAMESPACE.
user_home=$(getent passwd "$user" | awk -F: 'NR == 1 { print $6 }')
case "$user_home" in
    /*) ;;
    *) echo "qsm desktop setup: user has no absolute home directory" >&2; exit 1 ;;
esac
case "$user_home" in
    *[!A-Za-z0-9_./-]*)
        echo "qsm desktop setup: user home contains unsupported characters" >&2
        exit 1
        ;;
esac
desktop_state="$user_home/.local/share/qsm-desktop-agent"
legacy_state="$user_home/.local/share/qsm-guest-agent"
# Preserve the narrowly scoped clipboard/file exchange during the package
# rename.  Nothing outside this old package-owned state directory is moved.
if [ -d "$legacy_state" ] && [ ! -e "$desktop_state" ]; then
    mv -- "$legacy_state" "$desktop_state"
fi
install -d -m 0700 -o "$user" -g "$user" "$desktop_state"
# The old package created only this generated `home.conf`; remove it now that
# the old unit no longer exists.  Leave any administrator-created sibling
# drop-ins untouched.
legacy_dropin_directory="/etc/systemd/system/qsm-guest-agent@${user}.service.d"
rm -f -- "$legacy_dropin_directory/home.conf"
rmdir -- "$legacy_dropin_directory" 2>/dev/null || true
# Start the per-user Wayland bridge automatically at the next desktop login.
# It intentionally waits for a real compositor, so enabling it also from an
# SSH-created user manager is harmless and avoids a second manual setup step.
clipboard_wants="$user_home/.config/systemd/user/default.target.wants"
install -d -m 0700 -o "$user" -g "$user" "$clipboard_wants"
rm -f -- "$clipboard_wants/qsm-guest-clipboard.service"
ln -sfn /usr/lib/systemd/user/qsm-desktop-clipboard.service "$clipboard_wants/qsm-desktop-clipboard.service"
chown -h "$user:$user" "$clipboard_wants/qsm-desktop-clipboard.service"
# The template has a portable /home/USER default.  Keep arbitrary local
# account homes confined to their one writable exchange directory instead of
# accidentally using systemd's %%h (PID 1's /root).
dropin_directory="/etc/systemd/system/qsm-desktop-agent@${user}.service.d"
install -d -m 0755 "$dropin_directory"
umask 022
printf '%s\n' \
    '[Service]' \
    "Environment=HOME=$user_home" \
    "Environment=QSM_GUEST_HOME=$user_home" \
    'ReadWritePaths=' \
    "ReadWritePaths=$desktop_state" \
    > "$dropin_directory/home.conf"
systemctl daemon-reload
# The system unit owns the private virtio port. Enable its concrete user
# instance now; a missing port merely leaves the unit condition inactive until
# Display1 is saved and the VM is restarted.
systemctl enable "qsm-desktop-agent@${user}.service"
systemctl start "qsm-desktop-agent@${user}.service" 2>/dev/null || true
echo "QSM Desktop Agent and Wayland clipboard bridge enabled for $user. The bridge becomes ready when that user logs into a Wayland desktop."
