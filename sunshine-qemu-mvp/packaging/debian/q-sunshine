#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Launch the deliberately headless q-sunshine runtime.
set -eu

readonly binary=/usr/lib/q-sunshine/bin/sunshine

if [ ! -x "$binary" ]; then
    echo "q-sunshine: missing runtime binary: $binary" >&2
    exit 127
fi

# The qemu_dbus capture path never consumes a desktop session.  Clearing these
# avoids accidentally inheriting a Proxmox shell's graphical environment.
if [ "${QSUNSHINE_KEEP_DISPLAY_ENV:-0}" != "1" ]; then
    unset DISPLAY WAYLAND_DISPLAY WAYLAND_SOCKET XDG_SESSION_TYPE QT_QPA_PLATFORM
fi

# A concise alias is useful in manually managed per-VM units, but the upstream
# backend retains its explicit name as the source of truth.
if [ -n "${QSUNSHINE_DBUS_ADDRESS:-}" ] && [ -z "${SUNSHINE_QEMU_DBUS_ADDRESS:-}" ]; then
    export SUNSHINE_QEMU_DBUS_ADDRESS=$QSUNSHINE_DBUS_ADDRESS
fi

if [ -n "${QSUNSHINE_ENCODER:-}" ]; then
    # This is an explicit operator choice, not a device-node heuristic.  With
    # it unset Sunshine runs its own encoder probe and selects the first real
    # encoder it can initialize (for example NVENC on a correctly provisioned
    # NVIDIA host).  Keep the permitted values aligned with Sunshine's public
    # encoder setting so an EnvironmentFile cannot become an argument escape.
    case "$QSUNSHINE_ENCODER" in
        nvenc|quicksync|amdvce|vaapi|vulkan|software)
            set -- "$@" "encoder=$QSUNSHINE_ENCODER"
            ;;
        *)
            echo "q-sunshine: unsupported QSUNSHINE_ENCODER value" >&2
            exit 2
            ;;
    esac
fi

# The native GameStream lease path is a strict all-or-nothing transition. If
# authd has a configured issuer, Sunshine must receive the same VM CA/audience
# and must disable its paired-certificate/PIN fallback. A partial Environment-
# File is a startup error, not a reason to launch legacy pairing accidentally.
if [ -n "${QSUNSHINE_GAMESTREAM_LEASE_ISSUER:-}" ] || \
   [ -n "${QSUNSHINE_GAMESTREAM_LEASE_CA_CERT:-}" ] || \
   [ -n "${QSUNSHINE_GAMESTREAM_LEASE_CA_KEY:-}" ] || \
   [ -n "${QSUNSHINE_GAMESTREAM_LEASE_SUNSHINE_SERVER_CERT:-}" ] || \
   [ -n "${QSUNSHINE_GAMESTREAM_LEASE_TTL_SECONDS:-}" ]; then
    if [ -z "${QSUNSHINE_GAMESTREAM_LEASE_ISSUER:-}" ] || \
       [ -z "${QSUNSHINE_GAMESTREAM_LEASE_CA_CERT:-}" ] || \
       [ -z "${QSUNSHINE_GAMESTREAM_LEASE_CA_KEY:-}" ] || \
       [ -z "${QSUNSHINE_GAMESTREAM_LEASE_SUNSHINE_SERVER_CERT:-}" ] || \
       [ -z "${QSUNSHINE_GAMESTREAM_LEASE_TTL_SECONDS:-}" ] || \
       [ -z "${QSUNSHINE_AUTH_AUDIENCE:-}" ]; then
        echo "q-sunshine: complete GameStream lease config and QSUNSHINE_AUTH_AUDIENCE are required together" >&2
        exit 2
    fi
    case "$QSUNSHINE_GAMESTREAM_LEASE_CA_CERT" in
        /*) ;;
        *)
            echo "q-sunshine: QSUNSHINE_GAMESTREAM_LEASE_CA_CERT must be an absolute path" >&2
            exit 2
            ;;
    esac
    case "$QSUNSHINE_AUTH_AUDIENCE" in
        [!A-Za-z0-9]*|*[!A-Za-z0-9_.:-]* )
            echo "q-sunshine: QSUNSHINE_AUTH_AUDIENCE is invalid" >&2
            exit 2
            ;;
    esac
    set -- "$@" \
        qsm_system_auth_mode=enabled \
        "qsm_system_auth_ca=$QSUNSHINE_GAMESTREAM_LEASE_CA_CERT" \
        "qsm_system_auth_audience=$QSUNSHINE_AUTH_AUDIENCE"
fi

exec "$binary" "$@"
