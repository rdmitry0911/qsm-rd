#!/bin/sh
set -e

restart_pve_api_services() {
    # Maintainer scripts also run in an unpacked chroot where systemctl exists
    # but no manager does.  A no-op there is correct; the first real boot uses
    # the package-owned drop-ins.  On a live node, pvedaemon must reload before
    # pveproxy so both halves of PVE's protected route register together.
    if ! command -v systemctl >/dev/null 2>&1 || [ ! -d /run/systemd/system ]; then
        return 0
    fi
    if ! systemctl daemon-reload; then
        echo "q-sunshine-pve: could not reload systemd; PVE services were left unchanged" >&2
        return 0
    fi
    if ! systemctl try-restart pvedaemon.service; then
        echo "q-sunshine-pve: pvedaemon was left unchanged after installation" >&2
        return 0
    fi
    if ! systemctl try-restart pveproxy.service; then
        echo "q-sunshine-pve: pveproxy was left unchanged after installation" >&2
    fi
}

pve_api_triggered() {
    # dpkg passes one space-separated list of file-trigger names as $2. Only
    # an ABI-relevant PVE file warrants an otherwise avoidable proxy/daemon
    # restart; the index template trigger below only reconciles the UI.
    case " ${1:-} " in
        *" /usr/bin/pveproxy "*|\
        *" /usr/bin/pvedaemon "*|\
        *" /usr/share/perl5/PVE/API2/Qemu.pm "*|\
        *" /usr/share/perl5/PVE/QemuConfig.pm "*|\
        *" /usr/share/perl5/PVE/QemuServer.pm "*|\
        *" /usr/share/perl5/PVE/RPCEnvironment.pm "*|\
        *" /usr/share/perl5/PVE/JSONSchema.pm "*|\
        *" /usr/share/perl5/PVE/Service/pveproxy.pm "*|\
        *" /usr/share/perl5/PVE/Service/pvedaemon.pm "*)
            return 0
            ;;
    esac
    return 1
}

case "$1" in
    configure)
        install -d -o root -g root -m 0750 /etc/q-sunshine/instances.d
        install -d -o root -g root -m 0700 /etc/q-sunshine/terminal
        install -d -o root -g root -m 0700 /etc/q-sunshine/vms
        restart_pve_api_services
        # The PVE UI manager owns only the package diversion and fails closed
        # on an unreviewed pve-manager template. Never make an unsupported UI
        # upgrade block package configuration or leave a stale Console item.
        if ! /usr/sbin/q-sunshine-pve-ui reconcile; then
            echo "q-sunshine-pve: PVE Console overlay was not changed; inspect q-sunshine-pve-ui status" >&2
        fi
        echo "q-sunshine-pve installed; configure terminal.conf, the shared node map and each VM policy, then enable q-sunshine-terminal before starting its VM."
        ;;
    triggered)
        if pve_api_triggered "${2:-}"; then
            restart_pve_api_services
        fi
        # The UI's own template trigger shares this maintainer script. It
        # reconciles independently and does not restart healthy PVE services.
        if ! /usr/sbin/q-sunshine-pve-ui reconcile; then
            echo "q-sunshine-pve: PVE Console overlay was not changed; inspect q-sunshine-pve-ui status" >&2
        fi
        ;;
esac
