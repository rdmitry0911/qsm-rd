#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Ticket-only QSF gateway coupled to q-sunshine-auth@VMID by its unit.
set -eu

if [ -z "${QSUNSHINE_AUTH_TICKET_KEY:-}" ] || [ -z "${QSUNSHINE_AUTH_AUDIENCE:-}" ]; then
    echo "q-sunshine-qsf-system-auth-gateway: system-auth ticket key and audience are required" >&2
    exit 2
fi
exec /usr/bin/python3 /usr/lib/q-sunshine/qsf/qsf_tls_gateway.py "$@" \
    --system-auth-ticket-key "$QSUNSHINE_AUTH_TICKET_KEY" \
    --system-auth-audience "$QSUNSHINE_AUTH_AUDIENCE"
