[Unit]
Description=q-sunshine QSF system-auth gateway for Proxmox guest %i
Documentation=file:/usr/share/doc/q-sunshine-pve/SYSTEM_AUTH.md
After=q-sunshine-qsf-control@%i.service q-sunshine-auth@%i.service
Requires=q-sunshine-qsf-control@%i.service q-sunshine-auth@%i.service
BindsTo=q-sunshine-qsf-control@%i.service q-sunshine-auth@%i.service
Conflicts=q-sunshine-qsf-gateway@%i.service
ConditionPathExists=/etc/q-sunshine/instances.d/%i.conf

[Service]
Type=simple
EnvironmentFile=/etc/q-sunshine/instances.d/%i.conf
Environment=QSUNSHINE_QSF_GATEWAY_HOST=127.0.0.1
Environment=QSUNSHINE_QSF_GATEWAY_PORT=48122
Environment=QSUNSHINE_QSF_MAX_CONCURRENT_REQUESTS=16
UMask=0077
ExecStart=/usr/bin/q-sunshine-qsf-system-auth-gateway --control-socket=/run/q-sunshine/qsf-%i/control.sock --token-file=/run/q-sunshine/qsf-%i/control.token --server-cert=${QSUNSHINE_QSF_SERVER_CERT} --server-key=${QSUNSHINE_QSF_SERVER_KEY} --listen-host=${QSUNSHINE_QSF_GATEWAY_HOST} --listen-port=${QSUNSHINE_QSF_GATEWAY_PORT} --max-concurrent-requests=${QSUNSHINE_QSF_MAX_CONCURRENT_REQUESTS}
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=100s
TasksMax=48
MemoryMax=256M
LimitNOFILE=128
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
