[Unit]
Description=q-sunshine TLS/PAM system-auth gateway for Proxmox guest %i
Documentation=file:/usr/share/doc/q-sunshine-pve/SYSTEM_AUTH.md
After=network-online.target q-sunshine@%i.service
Wants=network-online.target
Requires=q-sunshine@%i.service
BindsTo=q-sunshine@%i.service
ConditionPathExists=/etc/q-sunshine/instances.d/%i.conf

[Service]
Type=simple
EnvironmentFile=/etc/q-sunshine/instances.d/%i.conf
Environment=QSUNSHINE_AUTH_GATEWAY_HOST=127.0.0.1
Environment=QSUNSHINE_AUTH_GATEWAY_PORT=48123
Environment=QSUNSHINE_AUTH_TICKET_TTL_SECONDS=600
Environment=QSUNSHINE_AUTH_MAX_CONCURRENT_REQUESTS=16
UMask=0077
ExecStart=/usr/bin/q-sunshine-auth
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=20s
TasksMax=48
MemoryMax=256M
LimitNOFILE=128
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Deliberately do not add CapabilityBoundingSet/SystemCallFilter here: the
# administrator-selected PAM stack can require NSS/SSSD/module-specific host
# interactions. The service does not open PAM sessions or execute user shells.

[Install]
WantedBy=multi-user.target
