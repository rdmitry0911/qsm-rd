#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Verify the host assumptions before enabling a q-sunshine instance.
set -eu

readonly binary=/usr/lib/q-sunshine/bin/sunshine
allow_non_pve=0
require_virgl=0
require_encoder=0

usage() {
    echo "Usage: q-sunshine-preflight [--virgl] [--encoder] [--allow-non-pve]" >&2
    exit 2
}

fail() {
    echo "q-sunshine preflight: $*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --virgl) require_virgl=1 ;;
        --encoder) require_encoder=1 ;;
        --allow-non-pve) allow_non_pve=1 ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
    shift
done

[ -x "$binary" ] || fail "missing runtime binary: $binary"

if command -v pveversion >/dev/null 2>&1; then
    pve_major=$(pveversion 2>/dev/null | sed -n 's#^pve-manager/\([0-9][0-9]*\).*#\1#p')
    [ "$pve_major" = 9 ] || fail "Proxmox VE 9 is required (found: $(pveversion 2>/dev/null || true))"
elif [ "$allow_non_pve" -ne 1 ]; then
    fail "pveversion is unavailable; use --allow-non-pve only for package inspection"
fi

qemu_binary=$(command -v qemu-system-x86_64 || command -v kvm || true)
[ -n "$qemu_binary" ] || fail "qemu-system-x86_64 (or kvm) is unavailable"
"$qemu_binary" -display help 2>/dev/null | awk '$1 == "dbus" { found = 1 } END { exit !found }' ||
    fail "$qemu_binary does not expose the Display1 D-Bus backend"

[ -c /dev/kvm ] || fail "/dev/kvm is unavailable"
if [ "$require_virgl" -eq 1 ]; then
    render_node=${SUNSHINE_QEMU_DBUS_RENDER_NODE:-/dev/dri/renderD128}
    [ -c "$render_node" ] || fail "VirGL requested but render node is unavailable: $render_node"
fi

if [ "$require_encoder" -eq 1 ]; then
    probe=/usr/lib/q-sunshine/qsf/q_sunshine_encoder_probe.py
    [ -r "$probe" ] || fail "direct encoder probe is unavailable"
    encoder_result=$(/usr/bin/python3 "$probe") || fail "no direct H.264 encoder can initialize"
else
    encoder_result=not-checked
fi

ldd_output=$(ldd "$binary")
printf '%s\n' "$ldd_output" | grep -F 'not found' >/dev/null &&
    fail "runtime library is unresolved"
if printf '%s\n' "$ldd_output" | grep -E 'libX11|libXtst|libXi|libXext|libXrender|libXrandr|libwayland|libpulse|libasound' >/dev/null; then
    fail "headless runtime unexpectedly resolves a desktop or host-audio library"
fi

echo "Q_SUNSHINE_PREFLIGHT_OK qemu=$qemu_binary virgl=$require_virgl encoder=$encoder_result"
